@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.JournalEntry>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "سوابق حسابداری";
}

<h2 class="mb-4">سوابق حسابداری</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                    <form method="get" asp-action="AccountingReport" class="d-flex gap-2">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                        <select name="entryType" class="form-select" style="width: auto;">
                            <option value="">-- همه انواع سند --</option>
                            @foreach (var type in ViewBag.EntryTypes as List<string>)
                            {
                                <option value="@type" selected="@(Context.Request.Query["entryType"] == type ? "selected" : null)">@type</option>
                            }
                        </select>
                        <select name="status" class="form-select" style="width: auto;">
                            <option value="">-- همه وضعیت‌ها --</option>
                            @foreach (var status in ViewBag.StatusList as List<string>)
                            {
                                <option value="@status" selected="@(Context.Request.Query["status"] == status ? "selected" : null)">@status</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary">جستجو</button>
                    </form>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("ChartOfAccounts")" class="btn btn-info">
                            <i class="bx bx-list-ul me-1"></i> دفتر حساب‌ها
                        </a>
                        <a href="@Url.Action("AddJournalEntry")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> سند جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>شماره سند</th>
                                <th>تاریخ سند</th>
                                <th>شرح</th>
                                <th>نوع مرجع</th>
                                <th>شماره مرجع</th>
                                <th>بدهکار</th>
                                <th>بستانکار</th>
                                <th>وضعیت</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var entry in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark">@entry.EntryNumber</span></td>
                                        <td>
                                            @entry.EntryDate.ToString("yyyy/MM/dd")
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:document-bold" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <h6 class="mb-0 fw-medium">@entry.Description</h6>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(entry.ReferenceType))
                                            {
                                                <span class="badge bg-info-subtle text-info">@entry.ReferenceType</span>
                                            }
                                        </td>
                                        <td>@entry.ReferenceNumber</td>
                                        <td>
                                            <span class="text-success fw-medium">@entry.TotalDebit.ToString("N0") ریال</span>
                                        </td>
                                        <td>
                                            <span class="text-danger fw-medium">@entry.TotalCredit.ToString("N0") ریال</span>
                                        </td>
                                        <td>
                                            @if (entry.Status == "تایید شده")
                                            {
                                                <span class="badge bg-success">@entry.Status</span>
                                            }
                                            else if (entry.Status == "لغو شده")
                                            {
                                                <span class="badge bg-danger">@entry.Status</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">@entry.Status</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditJournalEntry", new { id = entry.EntryId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                @if (entry.Status != "تایید شده")
                                                {
                                                    <button type="button" class="btn btn-soft-danger btn-sm"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteModal"
                                                            data-bs-id="@entry.EntryId"
                                                            data-bs-name="@entry.EntryNumber"
                                                            title="حذف">
                                                        <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <i class="bx bx-book text-muted fs-1"></i>
                                        <p class="mt-2">هیچ سند حسابداری‌ای یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("AccountingReport", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"], entryType = Context.Request.Query["entryType"], status = Context.Request.Query["status"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("AccountingReport", new { page = i, searchKey = Context.Request.Query["searchKey"], entryType = Context.Request.Query["entryType"], status = Context.Request.Query["status"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("AccountingReport", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"], entryType = Context.Request.Query["entryType"], status = Context.Request.Query["status"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف سند حسابداری</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این سند حسابداری مطمئن هستید؟</p>
                <p id="entryNameToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> فقط اسناد پیش‌نویس قابل حذف هستند.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="entryIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var entryId = button.getAttribute('data-bs-id');
                var entryName = button.getAttribute('data-bs-name');

                document.getElementById('entryNameToDelete').textContent = entryName;
                document.getElementById('entryIdToDelete').value = entryId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}