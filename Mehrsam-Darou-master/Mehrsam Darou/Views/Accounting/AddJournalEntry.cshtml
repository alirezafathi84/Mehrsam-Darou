@model Mehrsam_Darou.Models.JournalEntry

@{
    ViewData["Title"] = "افزودن سند حسابداری جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن سند حسابداری جدید</h4>
                    <a href="@Url.Action("AccountingReport")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddJournalEntry">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="EntryNumber" class="form-label">شماره سند <span class="text-danger">*</span></label>
                                <input asp-for="EntryNumber" class="form-control" />
                                <span asp-validation-for="EntryNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- Entry Date - Using HTML5 Date Input -->
                        <!-- Entry Date - Using Persian DatePicker -->
                        <div class="col-md-6">
                            <div class="mb-3" data-field="EntryDate">
                                <label class="form-label">تاریخ سند <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       data-persian-date="true"
                                       autocomplete="off"
                                       readonly
                                       placeholder="تاریخ سند" />
                                <input type="hidden" asp-for="EntryDate" class="persian-date-hidden" />
                                <span asp-validation-for="EntryDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">شرح سند <span class="text-danger">*</span></label>
                                <input asp-for="Description" class="form-control" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ReferenceType" class="form-label">نوع مرجع</label>
                                <select asp-for="ReferenceType" class="form-select">
                                    <option value="">-- انتخاب نوع مرجع --</option>
                                    @foreach (var type in ViewBag.EntryTypes as List<string>)
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                                <span asp-validation-for="ReferenceType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ReferenceNumber" class="form-label">شماره مرجع</label>
                                <input asp-for="ReferenceNumber" class="form-control" />
                                <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TotalDebit" class="form-label">مجموع بدهکار <span class="text-danger">*</span></label>
                                <input asp-for="TotalDebit" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="TotalDebit" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TotalCredit" class="form-label">مجموع بستانکار <span class="text-danger">*</span></label>
                                <input asp-for="TotalCredit" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="TotalCredit" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="bx bx-info-circle me-1"></i>
                        <strong>نکته:</strong> مجموع بدهکار و بستانکار باید برابر باشد.
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Auto-calculate and validate balance
        document.addEventListener('DOMContentLoaded', function () {
            const debitInput = document.querySelector('input[name="TotalDebit"]');
            const creditInput = document.querySelector('input[name="TotalCredit"]');

            function validateBalance() {
                const debit = parseFloat(debitInput.value) || 0;
                const credit = parseFloat(creditInput.value) || 0;

                if (debit !== credit && debit > 0 && credit > 0) {
                    debitInput.classList.add('is-invalid');
                    creditInput.classList.add('is-invalid');
                } else {
                    debitInput.classList.remove('is-invalid');
                    creditInput.classList.remove('is-invalid');
                }
            }

            debitInput.addEventListener('input', validateBalance);
            creditInput.addEventListener('input', validateBalance);
        });
    </script>
}