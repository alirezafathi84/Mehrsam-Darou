@model Mehrsam_Darou.Models.AttendanceLog
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "ثبت حضور و غیاب جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ثبت حضور و غیاب جدید</h4>
                    <a href="@Url.Action("AttendanceLogList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddAttendanceLog">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">کاربر <span class="text-danger">*</span></label>
                                <select asp-for="UserId" class="form-select">
                                    <option value="">-- انتخاب کاربر --</option>
                                    @if (ViewBag.Users != null)
                                    {
                                        @foreach (var user in ViewBag.Users)
                                        {
                                            <option value="@user.Id">@user.FullName</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LogType" class="form-label">نوع ثبت <span class="text-danger">*</span></label>
                                <select asp-for="LogType" class="form-select">
                                    <option value="Entry">ورود</option>
                                    <option value="Exit">خروج</option>
                                </select>
                                <span asp-validation-for="LogType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LogTime" class="form-label">زمان ثبت <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="LogTime" type="datetime-local" class="form-control" id="logTimeInput" />
                                    <button type="button" class="btn btn-outline-secondary" onclick="openPersianDatePicker()">
                                        <i class="bx bx-calendar"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="LogTime" class="text-danger"></span>
                                <!-- Persian Date Display -->
                                <small class="text-muted mt-1 d-block" id="persianDateDisplay"></small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DeviceId" class="form-label">شناسه دستگاه</label>
                                <input asp-for="DeviceId" class="form-control" placeholder="مثال: Device001" />
                                <span asp-validation-for="DeviceId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Persian Date Picker Modal -->
                    <div class="modal fade" id="persianDateModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">انتخاب تاریخ شمسی</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <label class="form-label">سال</label>
                                            <select id="persianYear" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">ماه</label>
                                            <select id="persianMonth" class="form-select">
                                                <option value="1">فروردین</option>
                                                <option value="2">اردیبهشت</option>
                                                <option value="3">خرداد</option>
                                                <option value="4">تیر</option>
                                                <option value="5">مرداد</option>
                                                <option value="6">شهریور</option>
                                                <option value="7">مهر</option>
                                                <option value="8">آبان</option>
                                                <option value="9">آذر</option>
                                                <option value="10">دی</option>
                                                <option value="11">بهمن</option>
                                                <option value="12">اسفند</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">روز</label>
                                            <select id="persianDay" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <label class="form-label">ساعت</label>
                                            <select id="persianHour" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">دقیقه</label>
                                            <select id="persianMinute" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary" onclick="setPersianDate()">تایید</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Location" class="form-label">موقعیت</label>
                                <input asp-for="Location" class="form-control" placeholder="مثال: ورودی اصلی" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PersianDate" class="form-label">تاریخ شمسی</label>
                                <input asp-for="PersianDate" class="form-control" placeholder="1403/03/18 (اختیاری - خودکار محاسبه می‌شود)" readonly />
                                <span asp-validation-for="PersianDate" class="text-danger"></span>
                                <small class="form-text text-muted">در صورت خالی گذاشتن، خودکار محاسبه می‌شود</small>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                        <button type="button" class="btn btn-success ms-2" onclick="setCurrentTime()">
                            <i class="bx bx-time me-1"></i> زمان فعلی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function setCurrentTime() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');

            const dateTimeString = `${year}-${month}-${day}T${hours}:${minutes}`;
            document.querySelector('input[name="LogTime"]').value = dateTimeString;
            updatePersianDateDisplay();
        }

        function updatePersianDateDisplay() {
            const logTimeInput = document.querySelector('input[name="LogTime"]');
            if (logTimeInput.value) {
                const date = new Date(logTimeInput.value);
                // This is a simplified Persian date conversion - you might want to use a proper library
                const persianDate = convertToPersianDate(date);
                document.getElementById('persianDateDisplay').textContent = 'تاریخ شمسی: ' + persianDate;
            }
        }

        function convertToPersianDate(date) {
            // Simplified Persian date conversion - replace with actual implementation
            const options = {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                calendar: 'persian',
                numberingSystem: 'latn'
            };
            try {
                return new Intl.DateTimeFormat('fa-IR-u-ca-persian-nu-latn', options).format(date);
            } catch (e) {
                // Fallback if Persian calendar is not supported
                return date.toLocaleDateString('fa-IR');
            }
        }

        function openPersianDatePicker() {
            // Initialize Persian date picker values
            initializePersianDatePicker();
            const modal = new bootstrap.Modal(document.getElementById('persianDateModal'));
            modal.show();
        }

        function initializePersianDatePicker() {
            const currentDate = new Date();
            const currentYear = currentDate.getFullYear();

            // Populate years (approximate Persian years)
            const yearSelect = document.getElementById('persianYear');
            yearSelect.innerHTML = '';
            for (let i = currentYear - 10; i <= currentYear + 5; i++) {
                const persianYear = i - 621; // Approximate conversion
                const option = document.createElement('option');
                option.value = persianYear;
                option.textContent = persianYear;
                if (i === currentYear) option.selected = true;
                yearSelect.appendChild(option);
            }

            // Populate days
            const daySelect = document.getElementById('persianDay');
            daySelect.innerHTML = '';
            for (let i = 1; i <= 31; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = i;
                if (i === currentDate.getDate()) option.selected = true;
                daySelect.appendChild(option);
            }

            // Populate hours
            const hourSelect = document.getElementById('persianHour');
            hourSelect.innerHTML = '';
            for (let i = 0; i < 24; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = String(i).padStart(2, '0');
                if (i === currentDate.getHours()) option.selected = true;
                hourSelect.appendChild(option);
            }

            // Populate minutes
            const minuteSelect = document.getElementById('persianMinute');
            minuteSelect.innerHTML = '';
            for (let i = 0; i < 60; i += 5) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = String(i).padStart(2, '0');
                if (Math.abs(i - currentDate.getMinutes()) < 3) option.selected = true;
                minuteSelect.appendChild(option);
            }

            // Set current month
            const persianMonth = currentDate.getMonth() + 1; // Simplified
            document.getElementById('persianMonth').value = persianMonth;
        }

        function setPersianDate() {
            // This is a simplified implementation - you should use a proper Persian to Gregorian conversion
            const year = parseInt(document.getElementById('persianYear').value);
            const month = parseInt(document.getElementById('persianMonth').value);
            const day = parseInt(document.getElementById('persianDay').value);
            const hour = parseInt(document.getElementById('persianHour').value);
            const minute = parseInt(document.getElementById('persianMinute').value);

            // Approximate conversion (you should use a proper library like moment-jalaali)
            const gregorianYear = year + 621;
            const gregorianMonth = month;
            const gregorianDay = day;

            const dateString = `${gregorianYear}-${String(gregorianMonth).padStart(2, '0')}-${String(gregorianDay).padStart(2, '0')}T${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;

            document.querySelector('input[name="LogTime"]').value = dateString;
            updatePersianDateDisplay();

            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('persianDateModal'));
            modal.hide();
        }

        // Set current time by default when page loads
        document.addEventListener('DOMContentLoaded', function() {
            const logTimeInput = document.querySelector('input[name="LogTime"]');
            if (!logTimeInput.value) {
                setCurrentTime();
            }

            // Update Persian date display when datetime input changes
            logTimeInput.addEventListener('change', updatePersianDateDisplay);

            // Initialize Persian date display
            updatePersianDateDisplay();

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}