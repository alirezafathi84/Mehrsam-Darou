@model Mehrsam_Darou.Models.AttendanceLog
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "ثبت حضور و غیاب جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ثبت حضور و غیاب جدید</h4>
                    <a href="@Url.Action("AttendanceLogList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddAttendanceLog">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">کاربر <span class="text-danger">*</span></label>
                                <select asp-for="UserId" asp-items="@(ViewBag.Users as IEnumerable<SelectListItem>)" class="form-select">
                                    <option value="">-- انتخاب کاربر --</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LogType" class="form-label">نوع ثبت <span class="text-danger">*</span></label>
                                <select asp-for="LogType" class="form-select">
                                    <option value="Entry">ورود</option>
                                    <option value="Exit">خروج</option>
                                </select>
                                <span asp-validation-for="LogType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LogTime" class="form-label">زمان ثبت <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="LogTime" type="datetime-local" class="form-control" id="logTimeInput" />
                                    <button type="button" class="btn btn-outline-secondary" onclick="openPersianDatePicker()">
                                        <i class="bx bx-calendar"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="LogTime" class="text-danger"></span>
                                <!-- Persian Date Display -->
                                <small class="text-muted mt-1 d-block" id="persianDateDisplay"></small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DeviceId" class="form-label">شناسه دستگاه</label>
                                <input asp-for="DeviceId" class="form-control" placeholder="مثال: Device001" />
                                <span asp-validation-for="DeviceId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Persian Date Picker Modal -->
                    <div class="modal fade" id="persianDateModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">انتخاب تاریخ شمسی</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <label class="form-label">سال</label>
                                            <select id="persianYear" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">ماه</label>
                                            <select id="persianMonth" class="form-select">
                                                <option value="1">فروردین</option>
                                                <option value="2">اردیبهشت</option>
                                                <option value="3">خرداد</option>
                                                <option value="4">تیر</option>
                                                <option value="5">مرداد</option>
                                                <option value="6">شهریور</option>
                                                <option value="7">مهر</option>
                                                <option value="8">آبان</option>
                                                <option value="9">آذر</option>
                                                <option value="10">دی</option>
                                                <option value="11">بهمن</option>
                                                <option value="12">اسفند</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">روز</label>
                                            <select id="persianDay" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <label class="form-label">ساعت</label>
                                            <select id="persianHour" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">دقیقه</label>
                                            <select id="persianMinute" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary" onclick="setPersianDate()">تایید</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Location" class="form-label">موقعیت</label>
                                <input asp-for="Location" class="form-control" placeholder="مثال: ورودی اصلی" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PersianDate" class="form-label">تاریخ شمسی</label>
                                <input asp-for="PersianDate" class="form-control" placeholder="1403/03/18 (اختیاری - خودکار محاسبه می‌شود)" />
                                <span asp-validation-for="PersianDate" class="text-danger"></span>
                                <small class="form-text text-muted">در صورت خالی گذاشتن، خودکار محاسبه می‌شود</small>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                        <button type="button" class="btn btn-success ms-2" onclick="setCurrentTime()">
                            <i class="bx bx-time me-1"></i> زمان فعلی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function setCurrentTime() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');

            const dateTimeString = `${year}-${month}-${day}T${hours}:${minutes}`;
            document.querySelector('input[name="LogTime"]').value = dateTimeString;
        }

        // Set current time by default when page loads
        document.addEventListener('DOMContentLoaded', function() {
            const logTimeInput = document.querySelector('input[name="LogTime"]');
            if (!logTimeInput.value) {
                setCurrentTime();
            }
        });
    </script>
}