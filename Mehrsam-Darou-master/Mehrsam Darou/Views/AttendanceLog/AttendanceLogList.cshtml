@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.AttendanceLog>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست ورود و خروج";
}

<h2 class="mb-4">لیست ورود و خروج</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <!-- Search and Filter Form -->
                <form method="get" asp-action="AttendanceLogList" class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">جستجو</label>
                        <input type="search" name="searchKey" value="@ViewBag.SearchKey" class="form-control" placeholder="نام کاربر، نوع ورود/خروج...">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">از تاریخ</label>
                        <input type="text"
                               class="form-control"
                               id="startDateDisplay"
                               autocomplete="off"
                               readonly
                               placeholder="از تاریخ" />
                        <input type="hidden" name="startDate" value="@ViewBag.StartDate" id="startDateInput" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">تا تاریخ</label>
                        <input type="text"
                               class="form-control"
                               id="endDateDisplay"
                               autocomplete="off"
                               readonly
                               placeholder="تا تاریخ" />
                        <input type="hidden" name="endDate" value="@ViewBag.EndDate" id="endDateInput" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bx bx-search me-1"></i>جستجو
                        </button>
                        <a href="@Url.Action("AttendanceLogList")" class="btn btn-secondary">
                            <i class="bx bx-refresh me-1"></i>پاک کردن
                        </a>
                    </div>
                </form>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                    <div>
                        <a href="@Url.Action("AddAttendanceLog")" class="btn btn-success">
                            <i class="bx bx-plus me-1"></i>ثبت ورود/خروج جدید
                        </a>
                    </div>
                    <div>
                        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#recalculateModal">
                            <i class="bx bx-calculator me-1"></i>محاسبه مجدد حضور روزانه
                        </button>
                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#quickEntryModal">
                            <i class="bx bx-time me-1"></i>ورود/خروج سریع
                        </button>
                        <button type="button" class="btn btn-primary" onclick="printReport()">
                            <i class="bx bx-printer me-1"></i>گزارش چاپی
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>کاربر</th>
                                <th>تاریخ و ساعت</th>
                                <th>تاریخ فارسی</th>
                                <th>نوع</th>
                                <th>مکان</th>
                                <th>دستگاه</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var log in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:user-rounded-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@log.User.FirstName @log.User.LastName</h6>
                                                    <small class="text-muted">@log.User.Username</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <span class="fw-medium">@log.LogTime.ToString("yyyy/MM/dd")</span>
                                                <br>
                                                <span class="text-primary">@log.LogTime.ToString("HH:mm:ss")</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-muted">@log.PersianDate</span>
                                        </td>
                                        <td>
                                            @if (log.LogType == "Entry")
                                            {
                                                <span class="badge bg-success">ورود</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">خروج</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(log.Location))
                                            {
                                                <small class="text-muted">@log.Location</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(log.DeviceId))
                                            {
                                                <small class="text-muted">@log.DeviceId</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <a href="@Url.Action("Details", new { id = log.Id })" class="btn btn-soft-info btn-sm" title="جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-16"></iconify-icon>
                                                </a>
                                                <a href="@Url.Action("EditAttendanceLog", new { id = log.Id })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-16"></iconify-icon>
                                                </a>
                                                <a href="@Url.Action("Delete", new { id = log.Id })" class="btn btn-soft-danger btn-sm" title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-16"></iconify-icon>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <i class="bx bx-time text-muted fs-1"></i>
                                        <p class="mt-2">هیچ رکورد ورود/خروجی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("AttendanceLogList", new { page = Model.PageIndex - 1, searchKey = ViewBag.SearchKey, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("AttendanceLogList", new { page = i, searchKey = ViewBag.SearchKey, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("AttendanceLogList", new { page = Model.PageIndex + 1, searchKey = ViewBag.SearchKey, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Persian Date Picker Modal for Filter -->
<div class="modal fade" id="filterDateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="filterDateModalTitle">انتخاب تاریخ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">سال</label>
                        <select id="filterPersianYear" class="form-select"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">ماه</label>
                        <select id="filterPersianMonth" class="form-select">
                            <option value="1">فروردین</option>
                            <option value="2">اردیبهشت</option>
                            <option value="3">خرداد</option>
                            <option value="4">تیر</option>
                            <option value="5">مرداد</option>
                            <option value="6">شهریور</option>
                            <option value="7">مهر</option>
                            <option value="8">آبان</option>
                            <option value="9">آذر</option>
                            <option value="10">دی</option>
                            <option value="11">بهمن</option>
                            <option value="12">اسفند</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">روز</label>
                        <select id="filterPersianDay" class="form-select"></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="setFilterDate()">تایید</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
            </div>
        </div>
    </div>
</div>

<!-- Recalculate Modal -->
<div class="modal fade" id="recalculateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">محاسبه مجدد حضور روزانه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="RecalculateDailyAttendance">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">از تاریخ</label>
                        <input type="text"
                               class="form-control"
                               id="recalcStartDateDisplay"
                               autocomplete="off"
                               readonly
                               placeholder="از تاریخ" />
                        <input type="hidden" name="startDate" id="recalcStartDateInput">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تا تاریخ</label>
                        <input type="text"
                               class="form-control"
                               id="recalcEndDateDisplay"
                               autocomplete="off"
                               readonly
                               placeholder="تا تاریخ" />
                        <input type="hidden" name="endDate" id="recalcEndDateInput">
                    </div>
                    <div class="alert alert-info">
                        <small>این عملیات تمام رکوردهای حضور روزانه را در بازه زمانی مشخص شده مجدداً محاسبه می‌کند.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">محاسبه مجدد</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </div>
            </form>
        </div>
    </div>
</div>

