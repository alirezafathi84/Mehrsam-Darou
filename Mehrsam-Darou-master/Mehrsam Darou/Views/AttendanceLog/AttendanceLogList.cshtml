@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.AttendanceLog>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست حضور و غیاب";
}

<h2 class="mb-4">لیست حضور و غیاب</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <!-- Filters and Search -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <form method="get" asp-action="AttendanceLogList">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="search-bar">
                                        <span><i class="bx bx-search-alt"></i></span>
                                        <input type="search" name="searchKey" value="@ViewBag.SearchKey" class="form-control" placeholder="جستجو کاربر، دستگاه، موقعیت...">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <select name="logType" class="form-select">
                                        <option value="">-- همه انواع --</option>
                                        <option value="Entry" selected="@(ViewBag.LogType == "Entry")">ورود</option>
                                        <option value="Exit" selected="@(ViewBag.LogType == "Exit")">خروج</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <input type="text" name="deviceId" value="@ViewBag.DeviceId" class="form-control" placeholder="شناسه دستگاه">
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-search me-1"></i> جستجو
                                    </button>
                                </div>
                                <div class="col-md-3 text-end">
                                    <a href="@Url.Action("AddAttendanceLog")" class="btn btn-success">
                                        <i class="bx bx-plus me-1"></i> ثبت جدید
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>کاربر</th>
                                <th>زمان ثبت</th>
                                <th>نوع ثبت</th>
                                <th>شناسه دستگاه</th>
                                <th>موقعیت</th>
                                <th>تاریخ شمسی</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var log in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:user-rounded-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@(log.User?.FirstName + " " + log.User?.LastName)</h6>
                                                    <small class="text-muted">@log.User?.Username</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <span class="fw-medium">@log.LogTime.ToString("HH:mm:ss")</span>
                                                <br>
                                                <small class="text-muted">@log.LogTime.ToString("yyyy/MM/dd")</small>
                                            </div>
                                        </td>
                                        <td>
                                            @if (log.LogType == "Entry")
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    <i class="bx bx-log-in me-1"></i> ورود
                                                </span>
                                            }
                                            else if (log.LogType == "Exit")
                                            {
                                                <span class="badge bg-danger-subtle text-danger">
                                                    <i class="bx bx-log-out me-1"></i> خروج
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@log.LogType</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(log.DeviceId))
                                            {
                                                <span class="badge bg-info-subtle text-info">@log.DeviceId</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(log.Location))
                                            {
                                                <i class="bx bx-map me-1 text-muted"></i>

                                                @log.Location
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(log.PersianDate))
                                            {
                                                <small class="text-muted">@log.PersianDate</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">
                                                    @pc.GetYear(log.LogTime)/@pc.GetMonth(log.LogTime).ToString("00")/@pc.GetDayOfMonth(log.LogTime).ToString("00")
                                                </small>
                                            }
                                        </td>
                                        <td>
                                            @if (log.DateCreated.HasValue)
                                            {
                                                <small class="text-muted">
                                                    @pc.GetYear(log.DateCreated.Value)/@pc.GetMonth(log.DateCreated.Value).ToString("00")/@pc.GetDayOfMonth(log.DateCreated.Value).ToString("00")
                                                    <br />
                                                    @log.DateCreated.Value.ToString("HH:mm")
                                                </small>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("Details", new { id = log.Id })" class="btn btn-soft-info btn-sm" title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <a href="@Url.Action("EditAttendanceLog", new { id = log.Id })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@log.Id"
                                                        data-bs-user="@(log.User?.FirstName + " " + log.User?.LastName)"
                                                        data-bs-time="@log.LogTime.ToString("yyyy/MM/dd HH:mm")"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <i class="bx bx-time text-muted fs-1"></i>
                                        <p class="mt-2">هیچ رکورد حضور و غیابی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("AttendanceLogList", new { page = Model.PageIndex - 1, searchKey = ViewBag.SearchKey, logType = ViewBag.LogType, deviceId = ViewBag.DeviceId })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("AttendanceLogList", new { page = i, searchKey = ViewBag.SearchKey, logType = ViewBag.LogType, deviceId = ViewBag.DeviceId })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("AttendanceLogList", new { page = Model.PageIndex + 1, searchKey = ViewBag.SearchKey, logType = ViewBag.LogType, deviceId = ViewBag.DeviceId })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف رکورد حضور و غیاب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این رکورد حضور و غیاب مطمئن هستید؟</p>
                <div id="deleteDetails" class="fw-bold"></div>
                <div class="alert alert-warning mt-2">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل قابل بازگشت نیست.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="logIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var logId = button.getAttribute('data-bs-id');
                var userName = button.getAttribute('data-bs-user');
                var logTime = button.getAttribute('data-bs-time');

                document.getElementById('deleteDetails').innerHTML =
                    '<p>کاربر: ' + userName + '</p>' +
                    '<p>زمان: ' + logTime + '</p>';
                document.getElementById('logIdToDelete').value = logId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}