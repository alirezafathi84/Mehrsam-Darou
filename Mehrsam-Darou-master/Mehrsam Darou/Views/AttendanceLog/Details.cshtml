@model Mehrsam_Darou.Models.AttendanceLog
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "جزئیات حضور و غیاب";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>جزئیات حضور و غیاب</h4>
                    <div>
                        <a href="@Url.Action("EditAttendanceLog", new { id = Model.Id })" class="btn btn-primary me-2">
                            <i class="bx bx-edit me-1"></i> ویرایش
                        </a>
                        <a href="@Url.Action("AttendanceLogList")" class="btn btn-secondary">
                            <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                        </a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bx bx-user me-2"></i>اطلاعات کاربر</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>نام کامل:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.User != null)
                                        {
                                            <span>@(Model.User.FirstName + " " + Model.User.LastName)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">نامشخص</span>
                                        }
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>نام کاربری:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.User != null)
                                        {
                                            <span class="badge bg-info-subtle text-info">@Model.User.Username</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">نامشخص</span>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><strong>شناسه کاربر:</strong></div>
                                    <div class="col-sm-8">
                                        <small class="text-muted font-monospace">@Model.UserId</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bx bx-time me-2"></i>اطلاعات زمانی</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>زمان ثبت:</strong></div>
                                    <div class="col-sm-8">
                                        <div>
                                            <span class="fw-bold text-primary">@Model.LogTime.ToString("HH:mm:ss")</span>
                                        </div>
                                        <small class="text-muted">@Model.LogTime.ToString("yyyy/MM/dd dddd", new CultureInfo("fa-IR"))</small>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>تاریخ شمسی:</strong></div>
                                    <div class="col-sm-8">
                                        @if (!string.IsNullOrEmpty(Model.PersianDate))
                                        {
                                            <span class="badge bg-secondary">@Model.PersianDate</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @pc.GetYear(Model.LogTime)/@pc.GetMonth(Model.LogTime).ToString("00")/@pc.GetDayOfMonth(Model.LogTime).ToString("00")
                                            </span>
                                        }
                                    </div>
                                </div>
                                @if (Model.DateCreated.HasValue)
                                {
                                    <div class="row">
                                        <div class="col-sm-4"><strong>تاریخ ایجاد:</strong></div>
                                        <div class="col-sm-8">
                                            <small class="text-muted">
                                                @Model.DateCreated.Value.ToString("yyyy/MM/dd HH:mm:ss")
                                                <br>
                                                (@pc.GetYear(Model.DateCreated.Value)/@pc.GetMonth(Model.DateCreated.Value).ToString("00")/@pc.GetDayOfMonth(Model.DateCreated.Value).ToString("00"))
                                            </small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bx bx-log-in me-2"></i>اطلاعات ثبت</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>نوع ثبت:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.LogType == "Entry")
                                        {
                                            <span class="badge bg-success fs-6">
                                                <i class="bx bx-log-in me-1"></i> ورود
                                            </span>
                                        }
                                        else if (Model.LogType == "Exit")
                                        {
                                            <span class="badge bg-danger fs-6">
                                                <i class="bx bx-log-out me-1"></i> خروج
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary fs-6">@Model.LogType</span>
                                        }
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>شناسه دستگاه:</strong></div>
                                    <div class="col-sm-8">
                                        @if (!string.IsNullOrEmpty(Model.DeviceId))
                                        {
                                            <span class="badge bg-info-subtle text-info">@Model.DeviceId</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">تعریف نشده</span>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><strong>موقعیت:</strong></div>
                                    <div class="col-sm-8">
                                        @if (!string.IsNullOrEmpty(Model.Location))
                                        {
                                            <i class="bx bx-map me-1 text-muted"></i>

                                            @Model.Location
                                        }
                                        else
                                        {
                                            <span class="text-muted">تعریف نشده</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bx bx-info-circle me-2"></i>اطلاعات سیستمی</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>شناسه رکورد:</strong></div>
                                    <div class="col-sm-8">
                                        <small class="text-muted font-monospace">@Model.Id</small>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>وضعیت:</strong></div>
                                    <div class="col-sm-8">
                                        <span class="badge bg-success">فعال</span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><strong>قابلیت ویرایش:</strong></div>
                                    <div class="col-sm-8">
                                        <span class="badge bg-warning">بله</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("EditAttendanceLog", new { id = Model.Id })" class="btn btn-primary">
                                <i class="bx bx-edit me-1"></i> ویرایش
                            </a>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="bx bx-trash me-1"></i> حذف
                            </button>
                            <a href="@Url.Action("AttendanceLogList")" class="btn btn-secondary">
                                <i class="bx bx-list-ul me-1"></i> لیست کامل
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف رکورد حضور و غیاب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این رکورد حضور و غیاب مطمئن هستید؟</p>
                <div class="fw-bold">
                    <p>کاربر: @(Model.User?.FirstName + " " + Model.User?.LastName)</p>
                    <p>زمان: @Model.LogTime.ToString("yyyy/MM/dd HH:mm")</p>
                    <p>نوع: @(Model.LogType == "Entry" ? "ورود" : "خروج")</p>
                </div>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل قابل بازگشت نیست.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>