@model Mehrsam_Darou.Models.AttendanceLog
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "ویرایش حضور و غیاب";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش حضور و غیاب</h4>
                    <a href="@Url.Action("AttendanceLogList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditAttendanceLog">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">کاربر <span class="text-danger">*</span></label>
                                <select asp-for="UserId" class="form-select">
                                    <option value="">-- انتخاب کاربر --</option>
                                    @if (ViewBag.Users != null)
                                    {
                                        @foreach (var user in ViewBag.Users)
                                        {
                                            if (user.Id == Model.UserId)
                                            {
                                                <option value="@user.Id" selected>@user.FullName</option>
                                            }
                                            else
                                            {
                                                <option value="@user.Id">@user.FullName</option>
                                            }
                                        }
                                    }
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LogType" class="form-label">نوع ثبت <span class="text-danger">*</span></label>
                                <select asp-for="LogType" class="form-select">
                                    @if (Model.LogType == "Entry")
                                    {
                                        <option value="Entry" selected>ورود</option>
                                        <option value="Exit">خروج</option>
                                    }
                                    else
                                    {
                                        <option value="Entry">ورود</option>
                                        <option value="Exit" selected>خروج</option>
                                    }
                                </select>
                                <span asp-validation-for="LogType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LogTime" class="form-label">زمان ثبت <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="text"
                                           class="form-control"
                                           id="logTimeDisplay"
                                           autocomplete="off"
                                           readonly
                                           placeholder="انتخاب تاریخ و زمان" />
                                    <button type="button" class="btn btn-outline-secondary" id="openDatePickerBtn">
                                        <i class="bx bx-calendar"></i>
                                    </button>
                                </div>
                                <input asp-for="LogTime" type="hidden" id="logTimeInput" />
                                <span asp-validation-for="LogTime" class="text-danger"></span>
                                <!-- Persian Date Display -->
                                <small class="text-muted mt-1 d-block" id="persianDateDisplay"></small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DeviceId" class="form-label">شناسه دستگاه</label>
                                <input asp-for="DeviceId" class="form-control" placeholder="مثال: Device001" />
                                <span asp-validation-for="DeviceId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Persian Date Picker Modal -->
                    <div class="modal fade" id="persianDateModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">انتخاب تاریخ و زمان شمسی</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <label class="form-label">سال</label>
                                            <select id="persianYear" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">ماه</label>
                                            <select id="persianMonth" class="form-select">
                                                <option value="1">فروردین</option>
                                                <option value="2">اردیبهشت</option>
                                                <option value="3">خرداد</option>
                                                <option value="4">تیر</option>
                                                <option value="5">مرداد</option>
                                                <option value="6">شهریور</option>
                                                <option value="7">مهر</option>
                                                <option value="8">آبان</option>
                                                <option value="9">آذر</option>
                                                <option value="10">دی</option>
                                                <option value="11">بهمن</option>
                                                <option value="12">اسفند</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">روز</label>
                                            <select id="persianDay" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <label class="form-label">ساعت</label>
                                            <select id="persianHour" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">دقیقه</label>
                                            <select id="persianMinute" class="form-select">
                                                <!-- Will be populated by JavaScript -->
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-primary" onclick="setPersianDate()">تایید</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Location" class="form-label">موقعیت</label>
                                <input asp-for="Location" class="form-control" placeholder="مثال: ورودی اصلی" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PersianDate" class="form-label">تاریخ شمسی</label>
                                <input asp-for="PersianDate" class="form-control" placeholder="1403/03/18" readonly />
                                <span asp-validation-for="PersianDate" class="text-danger"></span>
                                <small class="form-text text-muted">بر اساس زمان ثبت خودکار محاسبه می‌شود</small>
                            </div>
                        </div>
                    </div>

                    <!-- Display creation info -->
                    @if (Model.DateCreated.HasValue)
                    {
                        <div class="row">
                            <div class="col-md-12">
                                <div class="alert alert-info">
                                    <small>
                                        <i class="bx bx-info-circle me-1"></i>
                                        تاریخ ایجاد: @Model.DateCreated.Value.ToString("yyyy/MM/dd HH:mm:ss")
                                        @if (!string.IsNullOrEmpty(Model.PersianDate))
                                        {
                                            <span class="ms-3">تاریخ شمسی فعلی: @Model.PersianDate</span>
                                        }
                                    </small>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                        <button type="button" class="btn btn-success ms-2" onclick="setCurrentTime()">
                            <i class="bx bx-time me-1"></i> زمان فعلی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Persian to Gregorian conversion functions
        function persianToGregorian(jy, jm, jd) {
            var sal_a, gy, gm, gd, days;
            jy += 1595;
            days = -355668 + (365 * jy) + (~~(jy / 33) * 8) + ~~(((jy % 33) + 3) / 4) + jd + ((jm < 7) ? (jm - 1) * 31 : ((jm - 7) * 30) + 186);
            gy = 400 * ~~(days / 146097);
            days %= 146097;
            if (days > 36524) {
                gy += 100 * ~~(--days / 36524);
                days %= 36524;
                if (days >= 365) days++;
            }
            gy += 4 * ~~(days / 1461);
            days %= 1461;
            if (days > 365) {
                gy += ~~((days - 1) / 365);
                days = (days - 1) % 365;
            }
            gd = days + 1;
            sal_a = [0, 31, ((gy % 4 === 0 && gy % 100 !== 0) || (gy % 400 === 0)) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
            for (gm = 0; gm < 13 && gd > sal_a[gm]; gm++) gd -= sal_a[gm];
            return [gy, gm, gd];
        }

        function gregorianToPersian(gy, gm, gd) {
            var g_d_m, jy, jm, jd, gy2, days;
            g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
            gy2 = (gm > 2) ? (gy + 1) : gy;
            days = 355666 + (365 * gy) + ~~((gy2 + 3) / 4) - ~~((gy2 + 99) / 100) + ~~((gy2 + 399) / 400) + gd + g_d_m[gm - 1];
            jy = -1595 + (33 * ~~(days / 12053));
            days %= 12053;
            jy += 4 * ~~(days / 1461);
            days %= 1461;
            if (days > 365) {
                jy += ~~((days - 1) / 365);
                days = (days - 1) % 365;
            }
            if (days < 186) {
                jm = 1 + ~~(days / 31);
                jd = 1 + (days % 31);
            } else {
                jm = 7 + ~~((days - 186) / 30);
                jd = 1 + ((days - 186) % 30);
            }
            return [jy, jm, jd];
        }

        function setCurrentTime() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');

            const dateTimeString = `${year}-${month}-${day}T${hours}:${minutes}`;
            document.getElementById('logTimeInput').value = dateTimeString;
            updatePersianDateDisplay();
        }

        function updatePersianDateDisplay() {
            const logTimeInput = document.getElementById('logTimeInput');
            if (logTimeInput.value) {
                const date = new Date(logTimeInput.value);
                const persianDate = gregorianToPersian(date.getFullYear(), date.getMonth() + 1, date.getDate());
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');

                const persianDateString = `${persianDate[0]}/${String(persianDate[1]).padStart(2, '0')}/${String(persianDate[2]).padStart(2, '0')} ${hours}:${minutes}`;

                document.getElementById('logTimeDisplay').value = persianDateString;
                document.getElementById('persianDateDisplay').textContent = 'تاریخ میلادی: ' + date.toLocaleDateString('en-CA') + ' ' + hours + ':' + minutes;
            }
        }

        function openPersianDatePicker() {
            initializePersianDatePicker();
            const modal = new bootstrap.Modal(document.getElementById('persianDateModal'));
            modal.show();
        }

        function initializePersianDatePicker() {
            const logTimeInput = document.getElementById('logTimeInput');
            let currentDate = new Date();
            let persianDate;

            if (logTimeInput.value) {
                currentDate = new Date(logTimeInput.value);
            }

            persianDate = gregorianToPersian(currentDate.getFullYear(), currentDate.getMonth() + 1, currentDate.getDate());

            // Populate years
            const yearSelect = document.getElementById('persianYear');
            yearSelect.innerHTML = '';
            for (let i = persianDate[0] - 10; i <= persianDate[0] + 5; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = i;
                if (i === persianDate[0]) option.selected = true;
                yearSelect.appendChild(option);
            }

            // Set month
            document.getElementById('persianMonth').value = persianDate[1];

            // Populate days based on selected month
            updateDaysInMonth();

            // Set day
            document.getElementById('persianDay').value = persianDate[2];

            // Populate hours
            const hourSelect = document.getElementById('persianHour');
            hourSelect.innerHTML = '';
            for (let i = 0; i < 24; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = String(i).padStart(2, '0');
                if (i === currentDate.getHours()) option.selected = true;
                hourSelect.appendChild(option);
            }

            // Populate minutes
            const minuteSelect = document.getElementById('persianMinute');
            minuteSelect.innerHTML = '';
            for (let i = 0; i < 60; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = String(i).padStart(2, '0');
                if (i === currentDate.getMinutes()) option.selected = true;
                minuteSelect.appendChild(option);
            }

            // Add event listener for month change
            document.getElementById('persianMonth').removeEventListener('change', updateDaysInMonth);
            document.getElementById('persianMonth').addEventListener('change', updateDaysInMonth);
        }

        function updateDaysInMonth() {
            const month = parseInt(document.getElementById('persianMonth').value);
            const daySelect = document.getElementById('persianDay');
            const currentDay = daySelect.value;

            daySelect.innerHTML = '';

            let maxDays = 31;
            if (month >= 1 && month <= 6) {
                maxDays = 31;
            } else if (month >= 7 && month <= 11) {
                maxDays = 30;
            } else if (month === 12) {
                maxDays = 29; // Simplified, should check for leap year
            }

            for (let i = 1; i <= maxDays; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = i;
                if (i == currentDay && i <= maxDays) option.selected = true;
                daySelect.appendChild(option);
            }
        }

        function setPersianDate() {
            const year = parseInt(document.getElementById('persianYear').value);
            const month = parseInt(document.getElementById('persianMonth').value);
            const day = parseInt(document.getElementById('persianDay').value);
            const hour = parseInt(document.getElementById('persianHour').value);
            const minute = parseInt(document.getElementById('persianMinute').value);

            // Convert Persian to Gregorian
            const gregorianDate = persianToGregorian(year, month, day);

            const dateString = `${gregorianDate[0]}-${String(gregorianDate[1]).padStart(2, '0')}-${String(gregorianDate[2]).padStart(2, '0')}T${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;

            document.getElementById('logTimeInput').value = dateString;
            updatePersianDateDisplay();

            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('persianDateModal'));
            modal.hide();
        }

        // Format datetime-local input value on page load
        document.addEventListener('DOMContentLoaded', function() {
            const logTimeInput = document.getElementById('logTimeInput');

            // Format existing datetime value
            if (logTimeInput && logTimeInput.value) {
                // Handle different date formats that might come from server
                let date;
                if (logTimeInput.value.includes('T')) {
                    date = new Date(logTimeInput.value);
                } else {
                    date = new Date(logTimeInput.value.replace(' ', 'T'));
                }

                if (!isNaN(date.getTime())) {
                    const year = date.getFullYear();
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const day = String(date.getDate()).padStart(2, '0');
                    const hours = String(date.getHours()).padStart(2, '0');
                    const minutes = String(date.getMinutes()).padStart(2, '0');

                    logTimeInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
                }
            }

            // Initialize Persian date display
            updatePersianDateDisplay();

            // Open date picker when clicking the display input or button
            document.getElementById('logTimeDisplay').addEventListener('click', openPersianDatePicker);
            document.getElementById('openDatePickerBtn').addEventListener('click', openPersianDatePicker);

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}