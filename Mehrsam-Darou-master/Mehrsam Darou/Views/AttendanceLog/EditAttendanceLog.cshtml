@model Mehrsam_Darou.Models.AttendanceLog
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "ویرایش حضور و غیاب";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش حضور و غیاب</h4>
                    <a href="@Url.Action("AttendanceLogList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditAttendanceLog">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">کاربر <span class="text-danger">*</span></label>
                                <select asp-for="UserId" asp-items="@(ViewBag.Users as IEnumerable<SelectListItem>)" class="form-select">
                                    <option value="">-- انتخاب کاربر --</option>
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LogType" class="form-label">نوع ثبت <span class="text-danger">*</span></label>
                                <select asp-for="LogType" class="form-select">
                                    <option value="Entry">ورود</option>
                                    <option value="Exit">خروج</option>
                                </select>
                                <span asp-validation-for="LogType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LogTime" class="form-label">زمان ثبت <span class="text-danger">*</span></label>
                                <input asp-for="LogTime" type="datetime-local" class="form-control" />
                                <span asp-validation-for="LogTime" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DeviceId" class="form-label">شناسه دستگاه</label>
                                <input asp-for="DeviceId" class="form-control" placeholder="مثال: Device001" />
                                <span asp-validation-for="DeviceId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Location" class="form-label">موقعیت</label>
                                <input asp-for="Location" class="form-control" placeholder="مثال: ورودی اصلی" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PersianDate" class="form-label">تاریخ شمسی</label>
                                <input asp-for="PersianDate" class="form-control" placeholder="1403/03/18" readonly />
                                <span asp-validation-for="PersianDate" class="text-danger"></span>
                                <small class="form-text text-muted">بر اساس زمان ثبت خودکار محاسبه می‌شود</small>
                            </div>
                        </div>
                    </div>

                    <!-- Display creation info -->
                    @if (Model.DateCreated.HasValue)
                    {
                        <div class="row">
                            <div class="col-md-12">
                                <div class="alert alert-info">
                                    <small>
                                        <i class="bx bx-info-circle me-1"></i>
                                        تاریخ ایجاد: @Model.DateCreated.Value.ToString("yyyy/MM/dd HH:mm:ss")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                        <button type="button" class="btn btn-success ms-2" onclick="setCurrentTime()">
                            <i class="bx bx-time me-1"></i> زمان فعلی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function setCurrentTime() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');

            const dateTimeString = `${year}-${month}-${day}T${hours}:${minutes}`;
            document.querySelector('input[name="LogTime"]').value = dateTimeString;
        }

        // Format datetime-local input value on page load
        document.addEventListener('DOMContentLoaded', function() {
            const logTimeInput = document.querySelector('input[name="LogTime"]');
            if (logTimeInput && logTimeInput.value) {
                // Convert server datetime to local datetime-local format
                const date = new Date(logTimeInput.value);
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');

                logTimeInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
            }
        });
    </script>
}