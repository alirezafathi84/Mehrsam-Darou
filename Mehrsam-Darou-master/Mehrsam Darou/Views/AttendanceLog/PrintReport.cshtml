@using static Mehrsam_Darou.Helper.Helper
@model List<Mehrsam_Darou.Models.AttendanceLog>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "گزارش ورود و خروج";
    Layout = null; // No layout for print view
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Tahoma', Arial, sans-serif;
            font-size: 12px;
            direction: rtl;
            text-align: right;
        }

        .print-header {
            border-bottom: 2px solid #333;
            margin-bottom: 20px;
            padding-bottom: 15px;
        }

        .report-title {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }

        .report-info {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .table th {
            background-color: #e9ecef;
            font-weight: bold;
            text-align: center;
            vertical-align: middle;
            font-size: 11px;
        }

        .table td {
            vertical-align: middle;
            font-size: 11px;
        }

        .badge {
            font-size: 10px;
        }

        .summary-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 10px;
            margin-bottom: 15px;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                font-size: 10px;
            }

            .table th, .table td {
                font-size: 9px;
                padding: 4px;
            }

            .report-title {
                font-size: 16px;
            }

            .page-break {
                page-break-before: always;
            }
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <!-- Print Header -->
        <div class="print-header">
            <div class="row">
                <div class="col-6">
                    <h1 class="report-title">گزارش ورود و خروج کارکنان</h1>
                    <p class="mb-0">سیستم مدیریت حضور و غیاب</p>
                </div>
                <div class="col-6 text-start">
                    <p class="mb-1"><strong>تاریخ تولید گزارش:</strong> @ViewBag.GeneratedAt.ToString("yyyy/MM/dd HH:mm")</p>
                    <p class="mb-0"><strong>تاریخ فارسی:</strong> @{
                            var now = DateTime.Now;
                            var persianNow = $"{pc.GetYear(now)}/{pc.GetMonth(now):00}/{pc.GetDayOfMonth(now):00}";
                        } @persianNow</p>
                </div>
            </div>
        </div>

        <!-- Report Information -->
        <div class="report-info">
            <div class="row">
                <div class="col-md-6">
                    <h6><strong>فیلترهای اعمال شده:</strong></h6>
                    <ul class="list-unstyled mb-0">
                        <li><strong>جستجو:</strong> @(string.IsNullOrEmpty(ViewBag.SearchKey) ? "همه" : ViewBag.SearchKey)</li>
                        <li><strong>از تاریخ:</strong> @(ViewBag.StartDate?.ToString("yyyy/MM/dd") ?? "نامحدود")</li>
                        <li><strong>تا تاریخ:</strong> @(ViewBag.EndDate?.ToString("yyyy/MM/dd") ?? "نامحدود")</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6><strong>خلاصه آمار:</strong></h6>
                    <div class="row">
                        <div class="col-6">
                            <div class="summary-box text-center">
                                <h5 class="text-primary mb-1">@ViewBag.TotalRecords</h5>
                                <small>کل رکوردها</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="summary-box text-center">
                                <h5 class="text-info mb-1">@ViewBag.UniqueUsers</h5>
                                <small>تعداد کاربران</small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="summary-box text-center">
                                <h5 class="text-success mb-1">@ViewBag.EntryCount</h5>
                                <small>تعداد ورودها</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="summary-box text-center">
                                <h5 class="text-danger mb-1">@ViewBag.ExitCount</h5>
                                <small>تعداد خروجها</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Print Button -->
        <div class="no-print mb-3">
            <button onclick="window.print()" class="btn btn-primary">
                <i class="bx bx-printer me-1"></i>چاپ گزارش
            </button>
            <button onclick="window.close()" class="btn btn-secondary ms-2">
                بستن
            </button>
        </div>

        <!-- Report Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-sm">
                <thead>
                    <tr>
                        <th style="width: 5%;">ردیف</th>
                        <th style="width: 20%;">نام کاربر</th>
                        <th style="width: 12%;">تاریخ میلادی</th>
                        <th style="width: 10%;">ساعت</th>
                        <th style="width: 12%;">تاریخ فارسی</th>
                        <th style="width: 8%;">نوع</th>
                        <th style="width: 15%;">مکان</th>
                        <th style="width: 10%;">دستگاه</th>
                        <th style="width: 8%;">روز هفته</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int counter = 1;
                        foreach (var log in Model)
                        {
                                    <!-- Add page break every 40 rows for better printing -->
                            @if (counter > 1 && (counter - 1) % 40 == 0)
                            {
                                            <tr class="page-break">
                                                <td colspan="9" style="border: none; height: 0;"></td>
                                            </tr>
                            }

                                    <tr>
                                        <td class="text-center">@counter</td>
                                        <td>
                                            <strong>@log.User.FirstName @log.User.LastName</strong>
                                            <br><small class="text-muted">@log.User.Username</small>
                                        </td>
                                        <td class="text-center">@log.LogTime.ToString("yyyy/MM/dd")</td>
                                        <td class="text-center">
                                            <strong class="text-primary">@log.LogTime.ToString("HH:mm:ss")</strong>
                                        </td>
                                        <td class="text-center">@log.PersianDate</td>
                                        <td class="text-center">
                                    @if (log.LogType == "Entry")
                                    {
                                                    <span class="badge bg-success">ورود</span>
                                    }
                                    else
                                    {
                                                    <span class="badge bg-danger">خروج</span>
                                    }
                                        </td>
                                        <td class="text-center">
                                    @if (!string.IsNullOrEmpty(log.Location))
                                    {
                                                    <span>@log.Location</span>
                                    }
                                    else
                                    {
                                                    <span class="text-muted">-</span>
                                    }
                                        </td>
                                        <td class="text-center">
                                    @if (!string.IsNullOrEmpty(log.DeviceId))
                                    {
                                                    <span>@log.DeviceId</span>
                                    }
                                    else
                                    {
                                                    <span class="text-muted">-</span>
                                    }
                                        </td>
                                        <td class="text-center">
                                    @{
                                        var dayOfWeek = log.LogTime.DayOfWeek;
                                        var persianDayName = dayOfWeek switch
                                        {
                                            DayOfWeek.Saturday => "شنبه",
                                            DayOfWeek.Sunday => "یکشنبه",
                                            DayOfWeek.Monday => "دوشنبه",
                                            DayOfWeek.Tuesday => "سه‌شنبه",
                                            DayOfWeek.Wednesday => "چهارشنبه",
                                            DayOfWeek.Thursday => "پنج‌شنبه",
                                            DayOfWeek.Friday => "جمعه",
                                            _ => ""
                                        };
                                    }
                                            <small>@persianDayName</small>
                                        </td>
                                    </tr>
                            counter++;
                        }
                    }
                    else
                    {
                            <tr>
                                <td colspan="9" class="text-center py-4">
                                    <strong>هیچ رکورد ورود/خروجی یافت نشد.</strong>
                                </td>
                            </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Report Footer -->
        <div class="mt-4 pt-3 border-top">
            <div class="row">
                <div class="col-6">
                    <small class="text-muted">
                        این گزارش شامل @ViewBag.TotalRecords رکورد ورود و خروج می‌باشد.
                    </small>
                </div>
                <div class="col-6 text-start">
                    <small class="text-muted">
                        تولید شده در تاریخ: @ViewBag.GeneratedAt.ToString("yyyy/MM/dd HH:mm:ss")
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>