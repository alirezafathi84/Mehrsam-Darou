@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.BatchTest>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست آزمون‌های بچ";
}

<h2 class="mb-4">لیست آزمون‌های بچ</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="BatchTestList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddBatchTest")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> آزمون جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>شماره آزمون</th>
                                <th>شماره بچ</th>
                                <th>محصول</th>
                                <th>نوع آزمون</th>
                                <th>مرحله</th>
                                <th>وضعیت</th>
                                <th>اولویت</th>
                                <th>آزمون‌کننده</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var batchTest in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:test-tube-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@batchTest.TestNumber</h6>
                                                    @if (!string.IsNullOrEmpty(batchTest.SampleId))
                                                    {
                                                        <small class="text-muted">نمونه: @batchTest.SampleId</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@batchTest.BatchNumber</span></td>
                                        <td>
                                            @if (batchTest.Product != null)
                                            {
                                                <span class="fw-medium">@batchTest.Product.BrandName</span>
                                            }
                                        </td>
                                        <td>
                                            @if (batchTest.Test != null)
                                            {
                                                <span class="text-info">@batchTest.Test.TestName</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(batchTest.TestStage))
                                            {
                                                <span class="badge bg-info-subtle text-info">@batchTest.TestStage</span>
                                            }
                                        </td>
                                        <td>
                                            @switch (batchTest.TestStatus)
                                            {
                                                case "برنامه‌ریزی شده":
                                                    <span class="badge bg-secondary">@batchTest.TestStatus</span>
                                                    break;
                                                case "در حال انجام":
                                                    <span class="badge bg-warning">@batchTest.TestStatus</span>
                                                    break;
                                                case "تکمیل شده":
                                                    <span class="badge bg-primary">@batchTest.TestStatus</span>
                                                    break;
                                                case "بررسی":
                                                    <span class="badge bg-info">@batchTest.TestStatus</span>
                                                    break;
                                                case "تایید شده":
                                                    <span class="badge bg-success">@batchTest.TestStatus</span>
                                                    break;
                                                case "لغو شده":
                                                    <span class="badge bg-danger">@batchTest.TestStatus</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-dark">@batchTest.TestStatus</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @switch (batchTest.TestPriority)
                                            {
                                                case 1:
                                                    <span class="badge bg-danger">بسیار بالا</span>
                                                    break;
                                                case 2:
                                                    <span class="badge bg-warning">بالا</span>
                                                    break;
                                                case 3:
                                                    <span class="badge bg-primary">متوسط</span>
                                                    break;
                                                case 4:
                                                    <span class="badge bg-info">پایین</span>
                                                    break;
                                                case 5:
                                                    <span class="badge bg-secondary">بسیار پایین</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-dark">@batchTest.TestPriority</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(batchTest.TestedBy))
                                            {
                                                <span class="text-muted">@batchTest.TestedBy</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @pc.GetYear(batchTest.CreatedDate)/@pc.GetMonth(batchTest.CreatedDate).ToString("00")/@pc.GetDayOfMonth(batchTest.CreatedDate).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditBatchTest", new { id = batchTest.BatchTestId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showBatchTestDetails('@batchTest.BatchTestId')"
                                                        title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@batchTest.BatchTestId"
                                                        data-bs-number="@batchTest.TestNumber"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4">
                                        <i class="bx bx-test-tube text-muted fs-1"></i>
                                        <p class="mt-2">هیچ آزمونی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("BatchTestList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("BatchTestList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("BatchTestList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف آزمون</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این آزمون مطمئن هستید؟</p>
                <p id="testNumberToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل قابل بازگشت نیست.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="testIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- BatchTest Details Modal -->
<div class="modal fade" id="batchTestDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات آزمون</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="batchTestDetailsContent">
                <!-- BatchTest details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var testId = button.getAttribute('data-bs-id');
                var testNumber = button.getAttribute('data-bs-number');

                document.getElementById('testNumberToDelete').textContent = testNumber;
                document.getElementById('testIdToDelete').value = testId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showBatchTestDetails(testId) {
            // This would typically load test details via AJAX
            // For now, just show a placeholder
            var modal = new bootstrap.Modal(document.getElementById('batchTestDetailsModal'));
            document.getElementById('batchTestDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Simulate loading details
            setTimeout(function() {
                document.getElementById('batchTestDetailsContent').innerHTML =
                    '<p>جزئیات کامل آزمون اینجا نمایش داده خواهد شد.</p>' +
                    '<p>شامل نتایج آزمون، مشخصات، و سایر اطلاعات مربوطه...</p>';
            }, 1000);
        }
    </script>
}