@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.Certification>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست گواهینامه‌ها";
}

<h2 class="mb-4">لیست گواهینامه‌ها</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <!-- Search and Filter Section -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <form method="get" asp-action="CertificationList">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="search-bar">
                                        <span><i class="bx bx-search-alt"></i></span>
                                        <input type="search" name="searchKey" value="@ViewBag.SearchKey" class="form-control" placeholder="جستجو...">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <select name="statusFilter" class="form-select">
                                        <option value="">-- همه وضعیت‌ها --</option>
                                        @if (ViewBag.StatusOptions != null)
                                        {
                                            foreach (var status in ViewBag.StatusOptions)
                                            {
                                                <option value="@status" selected="@(status == ViewBag.StatusFilter)">@status</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select name="typeFilter" class="form-select">
                                        <option value="">-- همه انواع --</option>
                                        @if (ViewBag.TypeOptions != null)
                                        {
                                            foreach (var type in ViewBag.TypeOptions)
                                            {
                                                <option value="@type" selected="@(type == ViewBag.TypeFilter)">@type</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-outline-primary w-100">
                                        <i class="bx bx-filter me-1"></i> فیلتر
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                    <div>
                        <a href="@Url.Action("ExpiringCertifications")" class="btn btn-warning me-2">
                            <i class="bx bx-time me-1"></i> در حال انقضا
                        </a>
                    </div>
                    <div>
                        <a href="@Url.Action("AddCertification")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> گواهینامه جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>نام گواهینامه</th>
                                <th>کد</th>
                                <th>نوع</th>
                                <th>مرجع صادرکننده</th>
                                <th>وضعیت</th>
                                <th>تاریخ انقضا</th>
                                <th>باقی‌مانده</th>
                                <th>اولویت</th>
                                <th>مسئول</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var cert in Model)
                                {
                                    <tr class="@("table-danger")">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:document-add-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@cert.CertificationName</h6>
                                                    @if (!string.IsNullOrEmpty(cert.CertificateNumber))
                                                    {
                                                        <small class="text-muted">@cert.CertificateNumber</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@cert.CertificationCode</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(cert.CertificationType))
                                            {
                                                <span class="badge bg-info-subtle text-info">@cert.CertificationType</span>
                                            }
                                        </td>
                                        <td>
                                            <div>
                                                <span class="fw-medium">@cert.IssuingAuthority</span>
                                                @if (!string.IsNullOrEmpty(cert.IssuingCountry))
                                                {
                                                    <br>

                                                    <small class="text-muted">@cert.IssuingCountry</small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @switch (cert.CertificationStatus)
                                            {
                                                case "فعال":
                                                    <span class="badge bg-success">@cert.CertificationStatus</span>
                                                    break;
                                                case "منقضی شده":
                                                    <span class="badge bg-danger">@cert.CertificationStatus</span>
                                                    break;
                                                case "در حال تمدید":
                                                    <span class="badge bg-warning">@cert.CertificationStatus</span>
                                                    break;
                                                case "تعلیق شده":
                                                    <span class="badge bg-secondary">@cert.CertificationStatus</span>
                                                    break;
                                                case "لغو شده":
                                                    <span class="badge bg-dark">@cert.CertificationStatus</span>
                                                    break;
                                                case "در انتظار تایید":
                                                    <span class="badge bg-primary">@cert.CertificationStatus</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-dark">@cert.CertificationStatus</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (cert.ExpiryDate.HasValue)
                                            {
                                                <small>
                                                    @pc.GetYear(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue))/@pc.GetMonth(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue)).ToString("00")/@pc.GetDayOfMonth(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue)).ToString("00")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var daysUntilExpiry = cert.ExpiryDate.HasValue ? (int)(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).TotalDays : (int?)null;
                                            }
                                            @if (daysUntilExpiry.HasValue)
                                            {
                                                if (daysUntilExpiry.Value < 0)
                                                {
                                                    <span class="text-danger fw-bold">منقضی شده</span>
                                                }
                                                else if (daysUntilExpiry.Value <= 30)
                                                {
                                                    <span class="text-danger fw-bold">@daysUntilExpiry روز</span>
                                                }
                                                else if (daysUntilExpiry.Value <= 90)
                                                {
                                                    <span class="text-warning fw-medium">@daysUntilExpiry روز</span>
                                                }
                                                else
                                                {
                                                    <span class="text-success">@daysUntilExpiry روز</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (cert.PriorityLevel.HasValue)
                                            {
                                                var priorityClass = cert.PriorityLevel.Value switch
                                                {
                                                    1 => "text-danger fw-bold",
                                                    2 => "text-warning fw-medium",
                                                    3 => "text-info",
                                                    4 => "text-muted",
                                                    5 => "text-secondary",
                                                    _ => "text-muted"
                                                };
                                                <span class="@priorityClass">@cert.PriorityLevel</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(cert.ResponsiblePerson))
                                            {
                                                <span>@cert.ResponsiblePerson</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditCertification", new { id = cert.CertificationId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <a href="@Url.Action("Details", new { id = cert.CertificationId })" class="btn btn-soft-info btn-sm" title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@cert.CertificationId"
                                                        data-bs-name="@cert.CertificationName"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4">
                                        <i class="bx bx-file text-muted fs-1"></i>
                                        <p class="mt-2">هیچ گواهینامه‌ای یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("CertificationList", new { page = Model.PageIndex - 1, searchKey = ViewBag.SearchKey, statusFilter = ViewBag.StatusFilter, typeFilter = ViewBag.TypeFilter })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("CertificationList", new { page = i, searchKey = ViewBag.SearchKey, statusFilter = ViewBag.StatusFilter, typeFilter = ViewBag.TypeFilter })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("CertificationList", new { page = Model.PageIndex + 1, searchKey = ViewBag.SearchKey, statusFilter = ViewBag.StatusFilter, typeFilter = ViewBag.TypeFilter })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف گواهینامه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این گواهینامه مطمئن هستید؟</p>
                <p id="certificationNameToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل قابل برگشت نیست.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="certificationIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var certificationId = button.getAttribute('data-bs-id');
                var certificationName = button.getAttribute('data-bs-name');

                document.getElementById('certificationNameToDelete').textContent = certificationName;
                document.getElementById('certificationIdToDelete').value = certificationId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}