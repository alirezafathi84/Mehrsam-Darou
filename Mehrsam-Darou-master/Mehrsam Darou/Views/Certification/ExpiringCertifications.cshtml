@model List<Mehrsam_Darou.Models.Certification>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "گواهینامه‌های در حال انقضا";
    int reminderDays = ViewBag.ReminderDays ?? 90;
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="text-warning">
                            <i class="bx bx-time me-2"></i>
                            گواهینامه‌های در حال انقضا
                        </h4>
                        <p class="text-muted mb-0">
                            گواهینامه‌هایی که در @reminderDays روز آینده منقضی می‌شوند
                        </p>
                    </div>
                    <div>
                        <a href="@Url.Action("CertificationList")" class="btn btn-secondary me-2">
                            <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست کامل
                        </a>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bx bx-filter me-1"></i> @reminderDays روز
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="@Url.Action("ExpiringCertifications", new { days = 30 })">30 روز</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("ExpiringCertifications", new { days = 60 })">60 روز</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("ExpiringCertifications", new { days = 90 })">90 روز</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("ExpiringCertifications", new { days = 180 })">180 روز</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bx bx-check-circle text-success" style="font-size: 4rem;"></i>
                        <h5 class="mt-3 text-success">عالی!</h5>
                        <p class="text-muted">هیچ گواهینامه‌ای در @reminderDays روز آینده منقضی نمی‌شود.</p>
                        <a href="@Url.Action("CertificationList")" class="btn btn-primary">
                            <i class="bx bx-list-ul me-1"></i> مشاهده همه گواهینامه‌ها
                        </a>
                    </div>
                }
                else
                {
                    <!-- Summary Cards -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <h4 class="mb-0">
                                                @{
                                                    var oneWeekCount = 0;
                                                    foreach (var cert in Model)
                                                    {
                                                        if (cert.ExpiryDate.HasValue)
                                                        {
                                                            var days = (int)(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).TotalDays;
                                                            if (days <= 7) oneWeekCount++;
                                                        }
                                                    }
                                                }
                                                @oneWeekCount
                                            </h4>
                                            <p class="mb-0">یک هفته یا کمتر</p>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i class="bx bx-error-circle fs-1"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <h4 class="mb-0">
                                                @{
                                                    var oneMonthCount = 0;
                                                    foreach (var cert in Model)
                                                    {
                                                        if (cert.ExpiryDate.HasValue)
                                                        {
                                                            var days = (int)(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).TotalDays;
                                                            if (days > 7 && days <= 30) oneMonthCount++;
                                                        }
                                                    }
                                                }
                                                @oneMonthCount
                                            </h4>
                                            <p class="mb-0">یک ماه یا کمتر</p>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i class="bx bx-time fs-1"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <h4 class="mb-0">
                                                @{
                                                    var threeMonthCount = 0;
                                                    foreach (var cert in Model)
                                                    {
                                                        if (cert.ExpiryDate.HasValue)
                                                        {
                                                            var days = (int)(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).TotalDays;
                                                            if (days > 30 && days <= 90) threeMonthCount++;
                                                        }
                                                    }
                                                }
                                                @threeMonthCount
                                            </h4>
                                            <p class="mb-0">سه ماه یا کمتر</p>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i class="bx bx-info-circle fs-1"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <h4 class="mb-0">@Model.Count</h4>
                                            <p class="mb-0">کل موارد</p>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i class="bx bx-list-ul fs-1"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Certifications Table -->
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 table-hover">
                            <thead class="bg-light-subtle">
                                <tr>
                                    <th>گواهینامه</th>
                                    <th>نوع</th>
                                    <th>مرجع صادرکننده</th>
                                    <th>تاریخ انقضا</th>
                                    <th>باقی‌مانده</th>
                                    <th>وضعیت</th>
                                    <th>مسئول</th>
                                    <th>اقدامات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var sortedModel = Model.OrderBy(c => c.ExpiryDate.HasValue ? (int)(c.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).TotalDays : int.MaxValue);
                                }
                                @foreach (var cert in sortedModel)
                                {
                                    var daysUntil = cert.ExpiryDate.HasValue ? (int)(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue) - DateTime.Now).TotalDays : (int?)null;
                                    <tr class="@(daysUntil <= 7 ? "table-danger" : daysUntil <= 30 ? "table-warning" : "table-info")">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:document-add-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@cert.CertificationName</h6>
                                                    @if (!string.IsNullOrEmpty(cert.CertificateNumber))
                                                    {
                                                        <small class="text-muted">@cert.CertificateNumber</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(cert.CertificationType))
                                            {
                                                <span class="badge bg-info-subtle text-info">@cert.CertificationType</span>
                                            }
                                        </td>
                                        <td>@cert.IssuingAuthority</td>
                                        <td>
                                            @if (cert.ExpiryDate.HasValue)
                                            {
                                                <span class="@(daysUntil <= 7 ? "text-danger fw-bold" : daysUntil <= 30 ? "text-warning fw-medium" : "")">
                                                    @pc.GetYear(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue))/@pc.GetMonth(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue)).ToString("00")/@pc.GetDayOfMonth(cert.ExpiryDate.Value.ToDateTime(TimeOnly.MinValue)).ToString("00")
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (daysUntil.HasValue)
                                            {
                                                <span class="@(daysUntil <= 7 ? "text-danger fw-bold" : daysUntil <= 30 ? "text-warning fw-medium" : "text-info fw-medium")">
                                                    @daysUntil روز
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @switch (cert.CertificationStatus)
                                            {
                                                case "فعال":
                                                    <span class="badge bg-success">@cert.CertificationStatus</span>
                                                    break;
                                                case "در حال تمدید":
                                                    <span class="badge bg-warning">@cert.CertificationStatus</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-dark">@cert.CertificationStatus</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@cert.ResponsiblePerson</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="@Url.Action("EditCertification", new { id = cert.CertificationId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-16"></iconify-icon>
                                                </a>
                                                <a href="@Url.Action("Details", new { id = cert.CertificationId })" class="btn btn-soft-info btn-sm" title="جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-16"></iconify-icon>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>