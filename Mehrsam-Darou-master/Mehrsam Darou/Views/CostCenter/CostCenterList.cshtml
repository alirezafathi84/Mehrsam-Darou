@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.CostCenter>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
}

<h2>لیست مراکز هزینه</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">

            <div class="card-body">

                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="CostCenterList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="SearchKey" value="@Context.Request.Query["SearchKey"]" class="form-control" placeholder="جستجو کد، نام یا توضیحات ..">
                        </div>
                    </form>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("AddCostCenter", "CostCenter")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i>مرکز هزینه جدید
                        </a>
                    </div>
                </div>

            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>کد مرکز هزینه</th>
                                <th>نام مرکز هزینه</th>
                                <th>مرکز هزینه والد</th>
                                <th>توضیحات</th>
                                <th>وضعیت</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var costCenter in Model)
                                {
                                    <tr>
                                        <td><strong>@costCenter.CostCenterCode</strong></td>
                                        <td>@costCenter.CostCenterName</td>
                                        <td>
                                            @if (costCenter.ParentCostCenter != null)
                                            {
                                                <span class="badge bg-info">
                                                    @costCenter.ParentCostCenter.CostCenterCode - @costCenter.ParentCostCenter.CostCenterName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">ریشه</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(costCenter.Description))
                                            {
                                                <small>@costCenter.Description</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (costCenter.IsActive == true)
                                            {
                                                <span class="badge bg-success">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">غیرفعال</span>
                                            }
                                        </td>
                                        <td dir="ltr" align="right">
                                            @{
                                                var date = costCenter.CreatedDate;
                                                var persianDate = $"{pc.GetYear(date)}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00} {date:HH:mm}";
                                                @persianDate
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="@Url.Action("EditCostCenter", "CostCenter", new { id = costCenter.CostCenterId })" 
                                                   class="btn btn-sm btn-soft-primary" 
                                                   title="ویرایش">
                                                    <i class="bx bx-edit"></i>
                                                </a>
                                                <button type="button" 
                                                        class="btn btn-sm btn-soft-danger" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#deleteModal_@costCenter.CostCenterId"
                                                        title="حذف">
                                                    <i class="bx bx-trash"></i>
                                                </button>
                                            </div>

                                            <!-- Delete Confirmation Modal -->
                                            <div class="modal fade" id="deleteModal_@costCenter.CostCenterId" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-dialog-centered">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">تأیید حذف</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>آیا از حذف مرکز هزینه "<strong>@costCenter.CostCenterName</strong>" اطمینان دارید؟</p>
                                                            <p class="text-danger">
                                                                <i class="bx bx-info-circle"></i>
                                                                این عملیات قابل بازگشت نیست!
                                                            </p>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                                                            <form method="post" asp-action="DeleteCostCenter" asp-controller="CostCenter" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@costCenter.CostCenterId" />
                                                                <button type="submit" class="btn btn-danger">
                                                                    <i class="bx bx-trash me-1"></i>حذف
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <i class="bx bx-info-circle fs-3 text-muted"></i>
                                        <p class="text-muted mb-0">هیچ مرکز هزینه‌ای یافت نشد</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="card-footer">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("CostCenterList", new { page = Model.PageIndex - 1, SearchKey = Context.Request.Query["SearchKey"] })">
                                    قبلی
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("CostCenterList", new { page = i, SearchKey = Context.Request.Query["SearchKey"] })">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("CostCenterList", new { page = Model.PageIndex + 1, SearchKey = Context.Request.Query["SearchKey"] })">
                                    بعدی
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-center mt-2">
                        <small class="text-muted">
                            صفحه @Model.PageIndex از @Model.TotalPages
                        </small>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
