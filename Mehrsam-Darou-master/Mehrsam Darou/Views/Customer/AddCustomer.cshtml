@model Mehrsam_Darou.Models.Customer

@{
    ViewData["Title"] = "افزودن مشتری جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن مشتری جدید</h4>
                    <a href="@Url.Action("CustomerList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddCustomer">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CustomerName" class="form-label">نام مشتری <span class="text-danger">*</span></label>
                                <input asp-for="CustomerName" class="form-control" />
                                <span asp-validation-for="CustomerName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CustomerCode" class="form-label">کد مشتری <span class="text-danger">*</span></label>
                                <input asp-for="CustomerCode" class="form-control" />
                                <span asp-validation-for="CustomerCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CustomerType" class="form-label">نوع مشتری</label>
                                <select asp-for="CustomerType" class="form-select">
                                    <option value="">-- انتخاب نوع مشتری --</option>
                                    <option value="بیمارستان">بیمارستان</option>
                                    <option value="داروخانه">داروخانه</option>
                                    <option value="توزیع‌کننده">توزیع‌کننده</option>
                                    <option value="درمانگاه">درمانگاه</option>
                                    <option value="سایر">سایر</option>
                                </select>
                                <span asp-validation-for="CustomerType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ContactPerson" class="form-label">شخص رابط</label>
                                <input asp-for="ContactPerson" class="form-control" />
                                <span asp-validation-for="ContactPerson" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">ایمیل</label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label">تلفن</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="BillingAddress" class="form-label">آدرس صورتحساب</label>
                                <textarea asp-for="BillingAddress" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="BillingAddress" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ShippingAddress" class="form-label">آدرس ارسال</label>
                                <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TaxNumber" class="form-label">شماره مالیاتی</label>
                                <input asp-for="TaxNumber" class="form-control" />
                                <span asp-validation-for="TaxNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CreditLimit" class="form-label">سقف اعتبار</label>
                                <input asp-for="CreditLimit" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="CreditLimit" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PaymentTerms" class="form-label">شرایط پرداخت</label>
                                <select asp-for="PaymentTerms" class="form-select">
                                    <option value="">-- انتخاب شرایط پرداخت --</option>
                                    <option value="نقدی">نقدی</option>
                                    <option value="15 روزه">15 روزه</option>
                                    <option value="30 روزه">30 روزه</option>
                                    <option value="45 روزه">45 روزه</option>
                                    <option value="60 روزه">60 روزه</option>
                                    <option value="90 روزه">90 روزه</option>
                                </select>
                                <span asp-validation-for="PaymentTerms" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="IsActive" class="form-label">وضعیت</label>
                                <select asp-for="IsActive" class="form-select">
                                    <option value="true">فعال</option>
                                    <option value="false">غیرفعال</option>
                                </select>
                                <span asp-validation-for="IsActive" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}