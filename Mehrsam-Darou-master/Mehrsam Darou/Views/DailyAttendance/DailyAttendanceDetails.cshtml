@model Mehrsam_Darou.Models.DailyAttendance
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "جزئیات حضور روزانه";
    var dateTime = Model.Date.ToDateTime(TimeOnly.MinValue);
    var persianDateDisplay = !string.IsNullOrEmpty(Model.PersianDate)
        ? Model.PersianDate
        : $"{pc.GetYear(dateTime)}/{pc.GetMonth(dateTime):00}/{pc.GetDayOfMonth(dateTime):00}";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>جزئیات حضور روزانه</h4>
                    <div>
                        <a href="@Url.Action("EditDailyAttendance", new { id = Model.Id })" class="btn btn-primary me-2">
                            <i class="bx bx-edit me-1"></i> ویرایش
                        </a>
                        <a href="@Url.Action("DailyAttendanceList")" class="btn btn-secondary">
                            <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                        </a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bx bx-user me-2"></i>اطلاعات کاربر</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>نام کامل:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.User != null)
                                        {
                                            <span>@(Model.User.FirstName + " " + Model.User.LastName)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">نامشخص</span>
                                        }
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>نام کاربری:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.User != null)
                                        {
                                            <span class="badge bg-info-subtle text-info">@Model.User.Username</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">نامشخص</span>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><strong>شناسه کاربر:</strong></div>
                                    <div class="col-sm-8">
                                        <small class="text-muted font-monospace">@Model.UserId</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bx bx-calendar me-2"></i>اطلاعات تاریخ</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>تاریخ میلادی:</strong></div>
                                    <div class="col-sm-8">
                                        <span class="fw-bold text-primary">@Model.Date.ToString("yyyy/MM/dd")</span>
                                        <br>
                                        <small class="text-muted">@dateTime.ToString("dddd", new CultureInfo("fa-IR"))</small>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>تاریخ شمسی:</strong></div>
                                    <div class="col-sm-8">
                                        <span class="badge bg-secondary fs-6">@persianDateDisplay</span>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><strong>نوع روز:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.IsWorkingDay)
                                        {
                                            <span class="badge bg-primary">روز کاری</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">روز غیرکاری</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bx bx-time me-2"></i>اطلاعات زمانی</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>زمان ورود:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.FirstEntryTime.HasValue)
                                        {
                                            <span class="badge bg-success fs-6">
                                                <i class="bx bx-time me-1"></i>@Model.FirstEntryTime.Value.ToString(@"hh\:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">ثبت نشده</span>
                                        }
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>زمان خروج:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.LastExitTime.HasValue)
                                        {
                                            <span class="badge bg-danger fs-6">
                                                <i class="bx bx-time me-1"></i>@Model.LastExitTime.Value.ToString(@"hh\:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">ثبت نشده</span>
                                        }
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-4"><strong>مجموع ساعات:</strong></div>
                                    <div class="col-sm-8">
                                        @if (Model.TotalHours.HasValue)
                                        {
                                            <span class="fw-bold text-info fs-5">@Model.TotalHours.Value.ToString("0.##") ساعت</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">محاسبه نشده</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card border">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bx bx-check-circle me-2"></i>وضعیت و اطلاعات</h6>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>وضعیت:</strong></div>
                                    <div class="col-sm-8">
                                        @switch (Model.Status)
                                        {
                                            case "Present":
                                                <span class="badge bg-success fs-6">
                                                    <i class="bx bx-check me-1"></i> حاضر
                                                </span>
                                                break;
                                            case "Absent":
                                                <span class="badge bg-danger fs-6">
                                                    <i class="bx bx-x me-1"></i> غایب
                                                </span>
                                                break;
                                            case "Vacation":
                                                <span class="badge bg-warning fs-6">
                                                    <i class="bx bx-calendar me-1"></i> مرخصی
                                                </span>
                                                break;
                                            case "Mission":
                                                <span class="badge bg-info fs-6">
                                                    <i class="bx bx-briefcase me-1"></i> ماموریت
                                                </span>
                                                break;
                                            case "Holiday":
                                                <span class="badge bg-secondary fs-6">
                                                    <i class="bx bx-home me-1"></i> تعطیل
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary fs-6">@Model.Status</span>
                                                break;
                                        }
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>شناسه رکورد:</strong></div>
                                    <div class="col-sm-8">
                                        <small class="text-muted font-monospace">@Model.Id</small>
                                    </div>
                                </div>
                                @if (Model.DateCreated.HasValue)
                                {
                                    <div class="row">
                                        <div class="col-sm-4"><strong>تاریخ ایجاد:</strong></div>
                                        <div class="col-sm-8">
                                            <small class="text-muted">
                                                @Model.DateCreated.Value.ToString("yyyy/MM/dd HH:mm:ss")
                                                <br>
                                                (@pc.GetYear(Model.DateCreated.Value)/@pc.GetMonth(Model.DateCreated.Value).ToString("00")/@pc.GetDayOfMonth(Model.DateCreated.Value).ToString("00"))
                                            </small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("EditDailyAttendance", new { id = Model.Id })" class="btn btn-primary">
                                <i class="bx bx-edit me-1"></i> ویرایش
                            </a>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="bx bx-trash me-1"></i> حذف
                            </button>
                            <a href="@Url.Action("DailyAttendanceList")" class="btn btn-secondary">
                                <i class="bx bx-list-ul me-1"></i> لیست کامل
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف رکورد حضور روزانه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این رکورد حضور روزانه مطمئن هستید؟</p>
                <div class="fw-bold">
                    <p>کاربر: @(Model.User?.FirstName + " " + Model.User?.LastName)</p>
                    <p>تاریخ: @Model.Date.ToString("yyyy/MM/dd")</p>
                    <p>وضعیت: @(Model.Status == "Present" ? "حاضر" : Model.Status == "Absent" ? "غایب" : Model.Status == "Vacation" ? "مرخصی" : Model.Status == "Mission" ? "ماموریت" : Model.Status == "Holiday" ? "تعطیل" : Model.Status)</p>
                </div>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل قابل بازگشت نیست.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>