@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.DailyAttendance>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست حضور روزانه";
}

<h2 class="mb-4">لیست حضور روزانه</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <!-- Filters and Search -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <form method="get" asp-action="DailyAttendanceList">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="search-bar">
                                        <span><i class="bx bx-search-alt"></i></span>
                                        <input type="search" name="searchKey" value="@ViewBag.SearchKey" class="form-control" placeholder="جستجو کاربر، تاریخ...">
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <select name="status" class="form-select">
                                        <option value="">-- همه وضعیت‌ها --</option>
                                        <option value="Present" selected="@(ViewBag.Status == "Present")">حاضر</option>
                                        <option value="Absent" selected="@(ViewBag.Status == "Absent")">غایب</option>
                                        <option value="Vacation" selected="@(ViewBag.Status == "Vacation")">مرخصی</option>
                                        <option value="Mission" selected="@(ViewBag.Status == "Mission")">ماموریت</option>
                                        <option value="Holiday" selected="@(ViewBag.Status == "Holiday")">تعطیل</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <input type="text" name="month" value="@ViewBag.Month" class="form-control" placeholder="ماه (1403/03)">
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bx bx-search me-1"></i> جستجو
                                    </button>
                                </div>
                                <div class="col-md-3 text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a href="@Url.Action("AddDailyAttendance")" class="btn btn-success">
                                            <i class="bx bx-plus me-1"></i> ثبت جدید
                                        </a>
                                        <button type="button" class="btn btn-primary" onclick="printReport()">
                                            <i class="bx bx-printer me-1"></i>گزارش چاپی
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>کاربر</th>
                                <th>تاریخ</th>
                                <th>زمان ورود</th>
                                <th>زمان خروج</th>
                                <th>مجموع ساعات</th>
                                <th>وضعیت</th>
                                <th>روز کاری</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var attendance in Model)
                                {
                                    var dateTime = attendance.Date.ToDateTime(TimeOnly.MinValue);
                                    var persianDateForModal = attendance.PersianDate ??
                                    $"{pc.GetYear(dateTime)}/{pc.GetMonth(dateTime):00}/{pc.GetDayOfMonth(dateTime):00}";
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:user-rounded-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@(attendance.User?.FirstName + " " + attendance.User?.LastName)</h6>
                                                    <small class="text-muted">@attendance.User?.Username</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                @if (!string.IsNullOrEmpty(attendance.PersianDate))
                                                {
                                                    <span class="fw-medium text-primary">@attendance.PersianDate</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-medium text-primary">
                                                        @pc.GetYear(dateTime)/@pc.GetMonth(dateTime).ToString("00")/@pc.GetDayOfMonth(dateTime).ToString("00")
                                                    </span>
                                                }
                                                <br>
                                                <small class="text-muted">@attendance.Date.ToString("yyyy/MM/dd")</small>
                                            </div>
                                        </td>
                                        <td>
                                            @if (attendance.FirstEntryTime.HasValue)
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    <i class="bx bx-time me-1"></i>@attendance.FirstEntryTime.Value.ToString(@"hh\:mm")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (attendance.LastExitTime.HasValue)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">
                                                    <i class="bx bx-time me-1"></i>@attendance.LastExitTime.Value.ToString(@"hh\:mm")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (attendance.TotalHours.HasValue)
                                            {
                                                <span class="fw-medium text-info">@attendance.TotalHours.Value.ToString("0.##") ساعت</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @switch (attendance.Status)
                                            {
                                                case "Present":
                                                    <span class="badge bg-success">
                                                        <i class="bx bx-check me-1"></i> حاضر
                                                    </span>
                                                    break;
                                                case "Absent":
                                                    <span class="badge bg-danger">
                                                        <i class="bx bx-x me-1"></i> غایب
                                                    </span>
                                                    break;
                                                case "Vacation":
                                                    <span class="badge bg-warning">
                                                        <i class="bx bx-calendar me-1"></i> مرخصی
                                                    </span>
                                                    break;
                                                case "Mission":
                                                    <span class="badge bg-info">
                                                        <i class="bx bx-briefcase me-1"></i> ماموریت
                                                    </span>
                                                    break;
                                                case "Holiday":
                                                    <span class="badge bg-secondary">
                                                        <i class="bx bx-home me-1"></i> تعطیل
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@attendance.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (attendance.IsWorkingDay)
                                            {
                                                <span class="badge bg-primary-subtle text-primary">کاری</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غیرکاری</span>
                                            }
                                        </td>
                                        <td>
                                            @if (attendance.DateCreated.HasValue)
                                            {
                                                <small class="text-muted">
                                                    @pc.GetYear(attendance.DateCreated.Value)/@pc.GetMonth(attendance.DateCreated.Value).ToString("00")/@pc.GetDayOfMonth(attendance.DateCreated.Value).ToString("00")
                                                    <br />
                                                    @attendance.DateCreated.Value.ToString("HH:mm")
                                                </small>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                     @*            <a href="@Url.Action("DailyAttendanceDetails", new { id = attendance.Id })" class="btn btn-soft-info btn-sm" title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </a> *@
                                                <a href="@Url.Action("EditDailyAttendance", new { id = attendance.Id })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@attendance.Id"
                                                        data-bs-user="@(attendance.User?.FirstName + " " + attendance.User?.LastName)"
                                                        data-bs-date="@(attendance.PersianDate ?? pc.GetYear(attendance.Date.ToDateTime(TimeOnly.MinValue)) + "/" + pc.GetMonth(attendance.Date.ToDateTime(TimeOnly.MinValue)).ToString("00") + "/" + pc.GetDayOfMonth(attendance.Date.ToDateTime(TimeOnly.MinValue)).ToString("00"))"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <i class="bx bx-calendar text-muted fs-1"></i>
                                        <p class="mt-2">هیچ رکوردی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DailyAttendanceList", new { page = Model.PageIndex - 1, searchKey = ViewBag.SearchKey, status = ViewBag.Status, month = ViewBag.Month })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @{
                            int startPage = Math.Max(1, Model.PageIndex - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);

                            // Adjust range if we're near the beginning or end
                            if (endPage - startPage < 4)
                            {
                                if (startPage == 1)
                                {
                                    endPage = Math.Min(Model.TotalPages, startPage + 4);
                                }
                                else if (endPage == Model.TotalPages)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }
                        }

                        <!-- First page link if not in range -->
                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DailyAttendanceList", new { page = 1, searchKey = ViewBag.SearchKey, status = ViewBag.Status, month = ViewBag.Month })">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                        }

                        <!-- Page number range -->
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("DailyAttendanceList", new { page = i, searchKey = ViewBag.SearchKey, status = ViewBag.Status, month = ViewBag.Month })">@i</a>
                            </li>
                        }

                        <!-- Last page link if not in range -->
                        @if (endPage < Model.TotalPages)
                        {
                            @if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DailyAttendanceList", new { page = Model.TotalPages, searchKey = ViewBag.SearchKey, status = ViewBag.Status, month = ViewBag.Month })">@Model.TotalPages</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DailyAttendanceList", new { page = Model.PageIndex + 1, searchKey = ViewBag.SearchKey, status = ViewBag.Status, month = ViewBag.Month })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف رکورد حضور روزانه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این رکورد حضور روزانه مطمئن هستید؟</p>
                <div id="deleteDetails" class="fw-bold"></div>
                <div class="alert alert-warning mt-2">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل قابل بازگشت نیست.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="attendanceIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var attendanceId = button.getAttribute('data-bs-id');
                var userName = button.getAttribute('data-bs-user');
                var date = button.getAttribute('data-bs-date');

                document.getElementById('deleteDetails').innerHTML =
                    '<p>کاربر: ' + userName + '</p>' +
                    '<p>تاریخ: ' + date + '</p>';
                document.getElementById('attendanceIdToDelete').value = attendanceId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        // PRINT REPORT FUNCTION
        function printReport() {
            // Get current filter values
            const searchKey = document.querySelector('input[name="searchKey"]')?.value || '';
            const status = document.querySelector('select[name="status"]')?.value || '';
            const month = document.querySelector('input[name="month"]')?.value || '';

            // Build URL with current filters
            let url = '@Url.Action("PrintReport")';
            const params = new URLSearchParams();

            if (searchKey) params.append('searchKey', searchKey);
            if (status) params.append('status', status);
            if (month) params.append('month', month);

            if (params.toString()) {
                url += '?' + params.toString();
            }

            // Debug - you can remove this line after testing
            console.log('Print URL:', url);

            // Open in new window for printing
            window.open(url, '_blank', 'width=1200,height=800,scrollbars=yes,resizable=yes');
        }
    </script>
}