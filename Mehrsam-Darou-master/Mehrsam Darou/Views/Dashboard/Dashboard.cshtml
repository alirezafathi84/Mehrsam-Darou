@model DashboardViewModel
@using Mehrsam_Darou.ViewModel
@using Newtonsoft.Json
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "داشبورد مدیریت";
}

<div class="row">
    <div class="col-xxl-5">
        <div class="row">
            <!-- Sales Orders Card -->
            <div class="col-md-6">
                <div class="card overflow-hidden">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <div class="avatar-md bg-soft-primary rounded">
                                    <iconify-icon icon="solar:cart-5-bold-duotone" class="avatar-title fs-32 text-primary"></iconify-icon>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <p class="text-muted mb-0 text-truncate">سفارشات فروش</p>
                                <h3 class="text-dark mt-1 mb-0">@Model.TotalSalesOrders.ToString("N0")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer py-2 bg-light bg-opacity-50">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="@(Model.SalesOrdersGrowth >= 0 ? "text-success" : "text-danger")">
                                    <i class="bx @(Model.SalesOrdersGrowth >= 0 ? "bxs-up-arrow" : "bxs-down-arrow") fs-12"></i>
                                    @Math.Abs(Model.SalesOrdersGrowth)%
                                </span>
                                <span class="text-muted ms-1 fs-12">ماه گذشته</span>
                            </div>
                            <a href="@Url.Action("SalesOrderList", "SalesOrder")" class="text-reset fw-semibold fs-12">مشاهده بیشتر</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customers Card -->
            <div class="col-md-6">
                <div class="card overflow-hidden">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <div class="avatar-md bg-soft-primary rounded">
                                    <iconify-icon icon="solar:user-rounded-bold-duotone" class="avatar-title fs-32 text-primary"></iconify-icon>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <p class="text-muted mb-0 text-truncate">مشتریان</p>
                                <h3 class="text-dark mt-1 mb-0">@Model.TotalCustomers.ToString("N0")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer py-2 bg-light bg-opacity-50">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="@(Model.CustomersGrowth >= 0 ? "text-success" : "text-danger")">
                                    <i class="bx @(Model.CustomersGrowth >= 0 ? "bxs-up-arrow" : "bxs-down-arrow") fs-12"></i>
                                    @Math.Abs(Model.CustomersGrowth)%
                                </span>
                                <span class="text-muted ms-1 fs-12">ماه گذشته</span>
                            </div>
                            <a href="@Url.Action("CustomerList", "Customer")" class="text-reset fw-semibold fs-12">مشاهده بیشتر</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Production Orders Card -->
            <div class="col-md-6">
                <div class="card overflow-hidden">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <div class="avatar-md bg-soft-primary rounded">
                                    <iconify-icon icon="solar:document-text-bold-duotone" class="avatar-title fs-32 text-primary"></iconify-icon>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <p class="text-muted mb-0 text-truncate">سفارشات تولید</p>
                                <h3 class="text-dark mt-1 mb-0">@Model.TotalProductionOrders.ToString("N0")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer py-2 bg-light bg-opacity-50">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="@(Model.ProductionOrdersGrowth >= 0 ? "text-success" : "text-danger")">
                                    <i class="bx @(Model.ProductionOrdersGrowth >= 0 ? "bxs-up-arrow" : "bxs-down-arrow") fs-12"></i>
                                    @Math.Abs(Model.ProductionOrdersGrowth)%
                                </span>
                                <span class="text-muted ms-1 fs-12">ماه گذشته</span>
                            </div>
                            <a href="@Url.Action("ProductionOrderList", "ProductionOrder")" class="text-reset fw-semibold fs-12">مشاهده بیشتر</a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Revenue Card -->
            <div class="col-md-6">
                <div class="card overflow-hidden">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <div class="avatar-md bg-soft-primary rounded">
                                    <iconify-icon icon="solar:dollar-minimalistic-bold-duotone" class="avatar-title fs-32 text-primary"></iconify-icon>
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <p class="text-muted mb-0 text-truncate">درآمد ماهانه</p>
                                <h3 class="text-dark mt-1 mb-0">@Model.TotalRevenue.ToString("N0") ریال</h3>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer py-2 bg-light bg-opacity-50">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="@(Model.RevenueGrowth >= 0 ? "text-success" : "text-danger")">
                                    <i class="bx @(Model.RevenueGrowth >= 0 ? "bxs-up-arrow" : "bxs-down-arrow") fs-12"></i>
                                    @Math.Abs(Model.RevenueGrowth)%
                                </span>
                                <span class="text-muted ms-1 fs-12">ماه گذشته</span>
                            </div>
                            <a href="@Url.Action("SalesInvoiceList", "SalesInvoice")" class="text-reset fw-semibold fs-12">مشاهده بیشتر</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Chart -->
    <div class="col-xxl-7">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="card-title">عملکرد سالانه</h4>
                </div>
                <div dir="ltr">
                    <div id="dash-performance-chart1" class="apex-charts" style="min-height: 350px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Quality Control Chart -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">کیفیت تولید</h5>
                <div id="conversions1" class="apex-charts mb-2 mt-n2"></div>
                <div class="row text-center">
                    <div class="col-6">
                        <p class="text-muted mb-2">این هفته</p>
                        <h3 class="text-dark mb-3">@Model.ThisWeekConversions</h3>
                    </div>
                    <div class="col-6">
                        <p class="text-muted mb-2">هفته گذشته</p>
                        <h3 class="text-dark mb-3">@Model.LastWeekConversions</h3>
                    </div>
                </div>
                <div class="text-center">
                    <button type="button" class="btn btn-light shadow-none w-100">مشاهده جزئیات</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Summary -->
    <div class="col-lg-8">
        <div class="card card-height-100">
            <div class="card-header d-flex align-items-center justify-content-between gap-2">
                <h4 class="card-title flex-grow-1">خلاصه وضعیت</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Production Status -->
                    <div class="col-md-4">
                        <div class="border rounded p-3 mb-3">
                            <h6 class="text-muted mb-3">وضعیت تولید</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span>در انتظار</span>
                                <span class="badge bg-warning">@Model.PendingProductionOrders</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>در حال اجرا</span>
                                <span class="badge bg-primary">@Model.InProgressProductionOrders</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>تکمیل شده</span>
                                <span class="badge bg-success">@Model.CompletedProductionOrders</span>
                            </div>
                        </div>
                    </div>

                    <!-- Inventory Status -->
                    <div class="col-md-4">
                        <div class="border rounded p-3 mb-3">
                            <h6 class="text-muted mb-3">وضعیت موجودی</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span>موجودی کم</span>
                                <span class="badge bg-danger">@Model.LowStockItems</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>کل داروها</span>
                                <span class="badge bg-info">@Model.TotalMedicines</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>مواد اولیه</span>
                                <span class="badge bg-secondary">@Model.TotalRawMaterials</span>
                            </div>
                        </div>
                    </div>

                    <!-- Shipment Status -->
                    <div class="col-md-4">
                        <div class="border rounded p-3 mb-3">
                            <h6 class="text-muted mb-3">وضعیت حمل و نقل</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span>در انتظار</span>
                                <span class="badge bg-warning">@Model.PendingShipments</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>در حال حمل</span>
                                <span class="badge bg-primary">@Model.InTransitShipments</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>تحویل شده</span>
                                <span class="badge bg-success">@Model.DeliveredShipments</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Orders -->
    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <h4 class="card-title">سفارشات اخیر</h4>
                    <a href="@Url.Action("SalesOrderList", "SalesOrder")" class="btn btn-sm btn-soft-primary">
                        <iconify-icon icon="solar:eye-broken" class="me-1"></iconify-icon>مشاهده همه
                    </a>
                </div>
            </div>
            <div class="table-responsive table-centered">
                <table class="table mb-0">
                    <thead class="bg-light bg-opacity-50">
                        <tr>
                            <th class="ps-3">شماره سفارش</th>
                            <th>تاریخ</th>
                            <th>محصول</th>
                            <th>نام مشتری</th>
                            <th>ایمیل</th>
                            <th>شماره تلفن</th>
                            <th>مبلغ</th>
                            <th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentOrders.Any())
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <a href="#" class="text-primary fw-medium">@order.OrderNumber</a>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @pc.GetYear(order.OrderDate)/@pc.GetMonth(order.OrderDate).ToString("00")/@pc.GetDayOfMonth(order.OrderDate).ToString("00")
                                        </small>
                                    </td>
                                    <td>@order.TopProductName</td>
                                    <td>
                                        <a href="#!">@order.CustomerName</a>
                                    </td>
                                    <td>@order.CustomerEmail</td>
                                    <td>@order.CustomerPhone</td>
                                    <td>@order.TotalAmount.ToString("N0") ریال</td>
                                    <td>
                                        <span class="badge bg-@order.StatusColor">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <i class="bx bx-receipt text-muted fs-1"></i>
                                    <p class="mt-2">هیچ سفارش اخیری یافت نشد.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Data for Conversions radial chart
        var conversionsData = {
            conversionRate: @Model.ConversionRate,
            label: '@Model.ConversionLabel',
            colors: @Html.Raw(JsonConvert.SerializeObject(Model.ConversionColors))
        };

        // Render conversions radial chart
        var conversionsOptions = {
            chart: {
                height: 292,
                type: 'radialBar',
            },
            plotOptions: {
                radialBar: {
                    startAngle: -135,
                    endAngle: 135,
                    dataLabels: {
                        name: { fontSize: '14px', offsetY: 100 },
                        value: {
                            offsetY: 55,
                            fontSize: '20px',
                            formatter: function (val) { return val + "%"; }
                        },
                    },
                    track: { background: "rgba(170,184,197, 0.2)", margin: 0 }
                }
            },
            fill: {
                gradient: {
                    enabled: true,
                    shade: 'dark',
                    shadeIntensity: 0.2,
                    inverseColors: false,
                    opacityFrom: 1,
                    opacityTo: 1,
                    stops: [0, 50, 65, 91]
                }
            },
            stroke: { dashArray: 4 },
            colors: conversionsData.colors,
            series: [conversionsData.conversionRate],
            labels: [conversionsData.label],
            responsive: [{
                breakpoint: 380,
                options: { chart: { height: 180 } }
            }],
            grid: { padding: { top: 0, right: 0, bottom: 0, left: 0 } }
        };

        var conversionsChart = new ApexCharts(document.querySelector("#conversions1"), conversionsOptions);
        conversionsChart.render();

        // Data for performance chart
        var performanceData = {
            MonthlySales: @Html.Raw(JsonConvert.SerializeObject(Model.MonthlySales)),
            MonthlyProduction: @Html.Raw(JsonConvert.SerializeObject(Model.MonthlyProduction)),
            PersianMonths: @Html.Raw(JsonConvert.SerializeObject(Model.PersianMonths))
        };

        // Render performance chart
        var performanceOptions = {
            series: [{
                name: "سفارشات فروش",
                type: "bar",
                data: performanceData.MonthlySales,
            }, {
                name: "سفارشات تولید",
                type: "area",
                data: performanceData.MonthlyProduction,
            }],
            chart: {
                height: 313,
                type: "line",
                toolbar: { show: false },
            },
            stroke: {
                dashArray: [0, 0],
                width: [0, 2],
                curve: 'smooth'
            },
            fill: {
                opacity: [1, 1],
                type: ['solid', 'gradient'],
                gradient: {
                    type: "vertical",
                    inverseColors: false,
                    opacityFrom: 0.5,
                    opacityTo: 0,
                    stops: [0, 90]
                },
            },
            markers: { size: [0, 0], strokeWidth: 2, hover: { size: 4 } },
            xaxis: {
                categories: performanceData.PersianMonths,
                axisTicks: { show: false },
                axisBorder: { show: false }
            },
            yaxis: { min: 0, axisBorder: { show: false } },
            grid: {
                show: true,
                strokeDashArray: 3,
                xaxis: { lines: { show: false } },
                yaxis: { lines: { show: true } },
                padding: { top: 0, right: -2, bottom: 0, left: 10 }
            },
            legend: {
                show: true,
                horizontalAlign: "center",
                offsetX: 0,
                offsetY: 5,
                markers: { width: 9, height: 9, radius: 6 },
                itemMargin: { horizontal: 10, vertical: 0 }
            },
            plotOptions: {
                bar: { columnWidth: "30%", barHeight: "70%", borderRadius: 3 }
            },
            colors: ["#ff6c2f", "#22c55e"],
            tooltip: {
                shared: true,
                y: [{
                    formatter: function (y) { return (typeof y !== "undefined") ? y.toFixed(0) : y; }
                }, {
                    formatter: function (y) { return (typeof y !== "undefined") ? y.toFixed(0) : y; }
                }],
            }
        };

        var performanceChart = new ApexCharts(document.querySelector("#dash-performance-chart1"), performanceOptions);
        performanceChart.render();
    </script>
}

<style>
    .card-height-100 {
        height: calc(100% - 1.5rem);
    }

    .border {
        border: 1px solid #e9ecef !important;
    }
</style>