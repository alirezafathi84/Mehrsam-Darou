@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.DevelopmentProject>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست پروژه‌های توسعه";
}

<h2 class="mb-4">لیست پروژه‌های توسعه</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="DevelopmentList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddDevelopment")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> پروژه جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>نام پروژه</th>
                                <th>کد پروژه</th>
                                <th>نوع پروژه</th>
                                <th>مرحله توسعه</th>
                                <th>وضعیت</th>
                                <th>مدیر پروژه</th>
                                <th>پیشرفت</th>
                                <th>اولویت</th>
                                <th>بودجه</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var project in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:document-text-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@project.ProjectName</h6>
                                                    @if (project.TargetMedicineId.HasValue)
                                                    {
                                                        <small class="text-muted">دارو/محصول هدف تعریف شده</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@project.ProjectCode</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(project.ProjectType))
                                            {
                                                <span class="badge bg-info-subtle text-info">@project.ProjectType</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(project.DevelopmentStage))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">@project.DevelopmentStage</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(project.ProjectStatus))
                                            {
                                                var statusClass = project.ProjectStatus switch
                                                {
                                                    "تکمیل شده" => "bg-success",
                                                    "در حال اجرا" => "bg-primary",
                                                    "تایید شده" => "bg-info",
                                                    "تعلیق شده" => "bg-warning",
                                                    "لغو شده" => "bg-danger",
                                                    _ => "bg-secondary"
                                                };
                                                <span class="badge @statusClass">@project.ProjectStatus</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(project.ProjectManager))
                                            {
                                                <div>
                                                    <strong>@project.ProjectManager</strong>
                                                    @if (!string.IsNullOrEmpty(project.TeamLead))
                                                    {
                                                        <br>

                                                        <small class="text-muted">سرپرست: @project.TeamLead</small>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if (project.ProgressPercentage.HasValue)
                                            {
                                                var progressClass = project.ProgressPercentage.Value >= 75 ? "bg-success" :
                                                project.ProgressPercentage.Value >= 50 ? "bg-info" :
                                                project.ProgressPercentage.Value >= 25 ? "bg-warning" : "bg-danger";
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar @progressClass" role="progressbar"
                                                         style="width: @(project.ProgressPercentage.Value)%"
                                                         aria-valuenow="@project.ProgressPercentage.Value"
                                                         aria-valuemin="0" aria-valuemax="100">
                                                    </div>
                                                </div>
                                                <small class="text-muted">@project.ProgressPercentage.Value.ToString("F1")%</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (project.PriorityLevel.HasValue)
                                            {
                                                var priorityClass = project.PriorityLevel.Value <= 2 ? "text-danger" :
                                                project.PriorityLevel.Value == 3 ? "text-warning" : "text-success";
                                                var priorityText = project.PriorityLevel.Value switch
                                                {
                                                    1 => "بحرانی",
                                                    2 => "بالا",
                                                    3 => "متوسط",
                                                    4 => "پایین",
                                                    5 => "خیلی پایین",
                                                    _ => project.PriorityLevel.Value.ToString()
                                                };
                                                <span class="fw-medium @priorityClass">@priorityText</span>
                                            }
                                        </td>
                                        <td>
                                            @if (project.BudgetAllocated.HasValue)
                                            {
                                                <div>
                                                    <strong class="text-primary">@project.BudgetAllocated.Value.ToString("N0") ریال</strong>
                                                    @if (project.BudgetSpent.HasValue)
                                                    {
                                                        <br>

                                                        <small class="text-muted">مصرف شده: @project.BudgetSpent.Value.ToString("N0")</small>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @pc.GetYear(project.CreatedDate)/@pc.GetMonth(project.CreatedDate).ToString("00")/@pc.GetDayOfMonth(project.CreatedDate).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                     @*            <a href="@Url.Action("Details", new { id = project.ProjectId })" class="btn btn-soft-success btn-sm" title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </a> *@
                                                <a href="@Url.Action("EditDevelopment", new { id = project.ProjectId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@project.ProjectId"
                                                        data-bs-name="@project.ProjectName"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center py-4">
                                        <i class="bx bx-folder-open text-muted fs-1"></i>
                                        <p class="mt-2">هیچ پروژه‌ای یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DevelopmentList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("DevelopmentList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("DevelopmentList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف پروژه توسعه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این پروژه مطمئن هستید؟</p>
                <p id="projectNameToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> پروژه‌های تکمیل شده قابل حذف نیستند و فقط می‌توانند غیرفعال شوند.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="projectIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var projectId = button.getAttribute('data-bs-id');
                var projectName = button.getAttribute('data-bs-name');

                document.getElementById('projectNameToDelete').textContent = projectName;
                document.getElementById('projectIdToDelete').value = projectId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}

<!-- Project Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="avatar-sm">
                            <span class="avatar-title bg-primary-subtle text-primary rounded">
                                <iconify-icon icon="solar:document-text-bold-duotone" class="fs-20"></iconify-icon>
                            </span>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1">کل پروژه‌ها</p>
                        <h4 class="mb-0">@(Model?.Count() ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="avatar-sm">
                            <span class="avatar-title bg-success-subtle text-success rounded">
                                <iconify-icon icon="solar:check-circle-bold-duotone" class="fs-20"></iconify-icon>
                            </span>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1">تکمیل شده</p>
                        <h4 class="mb-0">@(Model?.Count(p => p.ProjectStatus == "تکمیل شده") ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="avatar-sm">
                            <span class="avatar-title bg-info-subtle text-info rounded">
                                <iconify-icon icon="solar:play-circle-bold-duotone" class="fs-20"></iconify-icon>
                            </span>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1">در حال اجرا</p>
                        <h4 class="mb-0">@(Model?.Count(p => p.ProjectStatus == "در حال اجرا") ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="avatar-sm">
                            <span class="avatar-title bg-warning-subtle text-warning rounded">
                                <iconify-icon icon="solar:pause-circle-bold-duotone" class="fs-20"></iconify-icon>
                            </span>
                        </div>
                    </div>
                    <div class="flex-grow-1">
                        <p class="text-muted mb-1">تعلیق شده</p>
                        <h4 class="mb-0">@(Model?.Count(p => p.ProjectStatus == "تعلیق شده") ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>