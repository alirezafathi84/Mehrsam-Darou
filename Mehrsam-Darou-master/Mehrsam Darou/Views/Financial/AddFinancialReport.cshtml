@model Mehrsam_Darou.Models.FinancialReport

@{
    ViewData["Title"] = "افزودن گزارش مالی جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن گزارش مالی جدید</h4>
                    <a href="@Url.Action("FinancialReport")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddFinancialReport">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ReportCode" class="form-label">کد گزارش <span class="text-danger">*</span></label>
                                <input asp-for="ReportCode" class="form-control" />
                                <span asp-validation-for="ReportCode" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ReportName" class="form-label">نام گزارش <span class="text-danger">*</span></label>
                                <input asp-for="ReportName" class="form-control" />
                                <span asp-validation-for="ReportName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ReportType" class="form-label">نوع گزارش <span class="text-danger">*</span></label>
                                <select asp-for="ReportType" class="form-select">
                                    <option value="">-- انتخاب نوع گزارش --</option>
                                    @foreach (var type in ViewBag.ReportTypes as List<string>)
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                                <span asp-validation-for="ReportType" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PeriodType" class="form-label">نوع دوره <span class="text-danger">*</span></label>
                                <select asp-for="PeriodType" class="form-select">
                                    <option value="">-- انتخاب نوع دوره --</option>
                                    @foreach (var period in ViewBag.PeriodTypes as List<string>)
                                    {
                                        <option value="@period">@period</option>
                                    }
                                </select>
                                <span asp-validation-for="PeriodType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="PeriodStart" class="form-label">شروع دوره <span class="text-danger">*</span></label>
                                <input asp-for="PeriodStart" type="date" class="form-control" />
                                <span asp-validation-for="PeriodStart" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="PeriodEnd" class="form-label">پایان دوره <span class="text-danger">*</span></label>
                                <input asp-for="PeriodEnd" type="date" class="form-control" />
                                <span asp-validation-for="PeriodEnd" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="FiscalYear" class="form-label">سال مالی <span class="text-danger">*</span></label>
                                <input asp-for="FiscalYear" type="number" min="1400" max="1450" class="form-control" />
                                <span asp-validation-for="FiscalYear" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="ReportData" class="form-label">توضیحات گزارش</label>
                                <textarea asp-for="ReportData" class="form-control" rows="4" placeholder="توضیحات تکمیلی در مورد گزارش..."></textarea>
                                <span asp-validation-for="ReportData" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}