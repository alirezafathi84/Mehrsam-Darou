@model Mehrsam_Darou.Models.FinishedGoodsBatch

@{
    ViewData["Title"] = "افزودن بچ محصول نهایی جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن بچ محصول نهایی جدید</h4>
                    <a href="@Url.Action("FinishedGoodsBatchList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddFinishedGoodsBatch">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MedicineId" class="form-label">دارو <span class="text-danger">*</span></label>
                                <select asp-for="MedicineId" class="form-select">
                                    <option value="">-- انتخاب دارو --</option>
                                    @foreach (var medicine in ViewBag.Medicines)
                                    {
                                        <option value="@medicine.MedicineId">@medicine.BrandName (@medicine.MedicineCode)</option>
                                    }
                                </select>
                                <span asp-validation-for="MedicineId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="BatchNumber" class="form-label">شماره بچ <span class="text-danger">*</span></label>
                                <input asp-for="BatchNumber" class="form-control" placeholder="مثال: B240601001" />
                                <span asp-validation-for="BatchNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Quantity" class="form-label">مقدار <span class="text-danger">*</span></label>
                                <input asp-for="Quantity" type="number" step="0.001" class="form-control" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UnitId" class="form-label">واحد <span class="text-danger">*</span></label>
                                <select asp-for="UnitId" class="form-select">
                                    <option value="">-- انتخاب واحد --</option>
                                    @foreach (var unit in ViewBag.Units)
                                    {
                                        <option value="@unit.UnitId">@unit.UnitName (@unit.UnitSymbol)</option>
                                    }
                                </select>
                                <span asp-validation-for="UnitId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LocationId" class="form-label">موقعیت انبار</label>
                                <select asp-for="LocationId" class="form-select">
                                    <option value="">-- انتخاب موقعیت --</option>
                                    @foreach (var location in ViewBag.Locations)
                                    {
                                        <option value="@location.LocationId">@location.LocationName (@location.LocationCode)</option>
                                    }
                                </select>
                                <span asp-validation-for="LocationId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrderId" class="form-label">سفارش تولید</label>
                                <select asp-for="OrderId" class="form-select">
                                    <option value="">-- انتخاب سفارش تولید --</option>
                                    @foreach (var order in ViewBag.ProductionOrders)
                                    {
                                        <option value="@order.OrderId">@order.OrderNumber</option>
                                    }
                                </select>
                                <span asp-validation-for="OrderId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ManufactureDate" class="form-label">تاریخ تولید <span class="text-danger">*</span></label>
                                <input asp-for="ManufactureDate" type="date" class="form-control" />
                                <span asp-validation-for="ManufactureDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ExpiryDate" class="form-label">تاریخ انقضا <span class="text-danger">*</span></label>
                                <input asp-for="ExpiryDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="قرنطینه">قرنطینه</option>
                                    <option value="آزاد شده">آزاد شده</option>
                                    <option value="رد شده">رد شده</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Auto-calculate expiry date based on manufacture date and medicine shelf life
        document.getElementById('MedicineId').addEventListener('change', function() {
            // This would typically make an AJAX call to get medicine shelf life
            // and auto-calculate expiry date
        });

        // Validate that expiry date is after manufacture date
        document.getElementById('ExpiryDate').addEventListener('change', function() {
            var manufactureDate = new Date(document.getElementById('ManufactureDate').value);
            var expiryDate = new Date(this.value);

            if (expiryDate <= manufactureDate) {
                alert('تاریخ انقضا باید پس از تاریخ تولید باشد');
                this.value = '';
            }
        });

        document.getElementById('ManufactureDate').addEventListener('change', function() {
            var manufactureDate = new Date(this.value);
            var expiryDateInput = document.getElementById('ExpiryDate');
            var expiryDate = new Date(expiryDateInput.value);

            if (expiryDate <= manufactureDate) {
                // Set default expiry date to 2 years from manufacture date
                var defaultExpiry = new Date(manufactureDate);
                defaultExpiry.setFullYear(defaultExpiry.getFullYear() + 2);
                expiryDateInput.value = defaultExpiry.toISOString().split('T')[0];
            }
        });
    </script>
}