@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.FinishedGoodsBatch>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست بچ‌های محصول نهایی";
}

<h2 class="mb-4">لیست بچ‌های محصول نهایی</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="FinishedGoodsBatchList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddFinishedGoodsBatch")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> بچ جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>دارو</th>
                                <th>شماره بچ</th>
                                <th>مقدار</th>
                                <th>واحد</th>
                                <th>موقعیت</th>
                                <th>تاریخ تولید</th>
                                <th>تاریخ انقضا</th>
                                <th>وضعیت</th>
                                <th>سفارش تولید</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var batch in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:pill-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@batch.Medicine?.BrandName</h6>
                                                    @if (!string.IsNullOrEmpty(batch.Medicine?.MedicineCode))
                                                    {
                                                        <small class="text-muted">@batch.Medicine.MedicineCode</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@batch.BatchNumber</span></td>
                                        <td>
                                            <span class="fw-medium">@batch.Quantity.ToString("N2")</span>
                                        </td>
                                        <td>@batch.Unit?.UnitName</td>
                                        <td>
                                            @if (batch.Location != null)
                                            {
                                                <span class="badge bg-info-subtle text-info">@batch.Location.LocationName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @pc.GetYear(batch.ManufactureDate.ToDateTime(TimeOnly.MinValue))/@pc.GetMonth(batch.ManufactureDate.ToDateTime(TimeOnly.MinValue)).ToString("00")/@pc.GetDayOfMonth(batch.ManufactureDate.ToDateTime(TimeOnly.MinValue)).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            <small class="@(batch.ExpiryDate < DateOnly.FromDateTime(DateTime.Now) ? "text-danger" : (batch.ExpiryDate < DateOnly.FromDateTime(DateTime.Now.AddMonths(3)) ? "text-warning" : "text-muted"))">
                                                @pc.GetYear(batch.ExpiryDate.ToDateTime(TimeOnly.MinValue))/@pc.GetMonth(batch.ExpiryDate.ToDateTime(TimeOnly.MinValue)).ToString("00")/@pc.GetDayOfMonth(batch.ExpiryDate.ToDateTime(TimeOnly.MinValue)).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            @if (batch.Status == "آزاد شده")
                                            {
                                                <span class="badge bg-success">آزاد شده</span>
                                            }
                                            else if (batch.Status == "قرنطینه")
                                            {
                                                <span class="badge bg-warning">قرنطینه</span>
                                            }
                                            else if (batch.Status == "رد شده")
                                            {
                                                <span class="badge bg-danger">رد شده</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@batch.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (batch.Order != null)
                                            {
                                                <span class="badge bg-light text-dark">@batch.Order.OrderNumber</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditFinishedGoodsBatch", new { id = batch.BatchId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                       @*                          <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showBatchDetails('@batch.BatchId')"
                                                        title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </button> *@
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@batch.BatchId"
                                                        data-bs-name="@batch.BatchNumber"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4">
                                        <i class="bx bx-package text-muted fs-1"></i>
                                        <p class="mt-2">هیچ بچ محصول نهایی‌ای یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("FinishedGoodsBatchList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("FinishedGoodsBatchList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("FinishedGoodsBatchList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف بچ محصول نهایی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این بچ محصول نهایی مطمئن هستید؟</p>
                <p id="batchNameToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> در صورت استفاده در فاکتورها یا حمل و نقل، امکان حذف وجود ندارد.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="batchIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Batch Details Modal -->
<div class="modal fade" id="batchDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات بچ محصول نهایی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="batchDetailsContent">
                <!-- Batch details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var batchId = button.getAttribute('data-bs-id');
                var batchName = button.getAttribute('data-bs-name');

                document.getElementById('batchNameToDelete').textContent = batchName;
                document.getElementById('batchIdToDelete').value = batchId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showBatchDetails(batchId) {
            // This would typically load batch details via AJAX
            // For now, just show a placeholder
            var modal = new bootstrap.Modal(document.getElementById('batchDetailsModal'));
            document.getElementById('batchDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Simulate loading details
            setTimeout(function() {
                document.getElementById('batchDetailsContent').innerHTML =
                    '<p>جزئیات کامل بچ محصول نهایی اینجا نمایش داده خواهد شد.</p>' +
                    '<p>شامل تاریخچه تولید، کیفیت و ...</p>';
            }, 1000);
        }
    </script>
}