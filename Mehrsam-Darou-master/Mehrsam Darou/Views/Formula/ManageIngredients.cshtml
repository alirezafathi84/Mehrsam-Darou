                                    <option value="چسب">چسب</option>
                                    <option value="ضدچسب">ضدچسب</option>
                                    <option value="روان‌کننده">روان‌کننده</option>
                                    <option value="رنگ‌دانه">رنگ‌دانه</option>
                                    <option value="طعم‌دهنده">طعم‌دهنده</option>
                                    <option value="عطردهنده">عطردهنده</option>
                                    <option value="نگهدارنده">نگهدارنده</option>
                                    <option value="تنظیم‌کننده pH">تنظیم‌کننده pH</option>
                                    <option value="بافر">بافر</option>
                                    <option value="حلال">حلال</option>
                                    <option value="تثبیت‌کننده">تثبیت‌کننده</option>
