                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editCostPerUnit" class="form-label">هزینه واحد</label>
                                <input type="number" name="CostPerUnit" id="editCostPerUnit" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editSupplierPreference" class="form-label">تأمین‌کننده ترجیحی</label>
                                <input type="text" name="SupplierPreference" id="editSupplierPreference" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="editSpecification" class="form-label">مشخصات</label>
                        <textarea name="Specification" id="editSpecification" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="editAdditionMethod" class="form-label">روش افزودن</label>
                        <textarea name="AdditionMethod" id="editAdditionMethod" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="editNotes" class="form-label">یادداشت‌ها</label>
                        <textarea name="Notes" id="editNotes" class="form-control" rows="2"></textarea>
