                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="editQuantity" class="form-label">مقدار <span class="text-danger">*</span></label>
                                <input type="number" name="Quantity" id="editQuantity" step="0.000001" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
