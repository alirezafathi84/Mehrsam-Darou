@model Mehrsam_Darou.Models.MaterialBatch

@{
    ViewData["Title"] = "ویرایش بچ";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش بچ</h4>
                    <a href="@Url.Action("MaterialBatchList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditMaterialBatch">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="BatchId" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MaterialId" class="form-label">ماده اولیه <span class="text-danger">*</span></label>
                                <select asp-for="MaterialId" class="form-select" disabled>
                                    <option value="">-- انتخاب ماده اولیه --</option>
                                    @foreach (var material in ViewBag.Materials)
                                    {
                                        <option value="@material.MaterialId" selected="@(material.MaterialId == Model.MaterialId)">@material.MaterialCode - @material.MaterialName</option>
                                    }
                                </select>
                                <input type="hidden" asp-for="MaterialId" />
                                <small class="text-muted">ماده اولیه بعد از ایجاد قابل تغییر نیست</small>
                                <span asp-validation-for="MaterialId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="BatchNumber" class="form-label">شماره بچ <span class="text-danger">*</span></label>
                                <input asp-for="BatchNumber" class="form-control" readonly />
                                <small class="text-muted">شماره بچ بعد از ایجاد قابل تغییر نیست</small>
                                <span asp-validation-for="BatchNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="InitialQuantity" class="form-label">مقدار اولیه <span class="text-danger">*</span></label>
                                <input asp-for="InitialQuantity" type="number" step="0.001" class="form-control" required />
                                <span asp-validation-for="InitialQuantity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="CurrentQuantity" class="form-label">مقدار فعلی <span class="text-danger">*</span></label>
                                <input asp-for="CurrentQuantity" type="number" step="0.001" class="form-control" required />
                                <small class="text-muted">مقدار فعلی را با احتیاط تغییر دهید</small>
                                <span asp-validation-for="CurrentQuantity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="UnitId" class="form-label">واحد <span class="text-danger">*</span></label>
                                <select asp-for="UnitId" class="form-select" required>
                                    <option value="">-- انتخاب واحد --</option>
                                    @foreach (var unit in ViewBag.Units)
                                    {
                                        <option value="@unit.UnitId" selected="@(unit.UnitId == Model.UnitId)">@unit.UnitName (@unit.UnitSymbol)</option>
                                    }
                                </select>
                                <span asp-validation-for="UnitId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="LocationId" class="form-label">محل نگهداری</label>
                                <select asp-for="LocationId" class="form-select">
                                    <option value="">-- انتخاب محل نگهداری --</option>
                                    @foreach (var location in ViewBag.Locations)
                                    {
                                        <option value="@location.LocationId" selected="@(location.LocationId == Model.LocationId)">@location.LocationCode - @location.LocationName</option>
                                    }
                                </select>
                                <span asp-validation-for="LocationId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select" required>
                                    <option value="">-- انتخاب وضعیت --</option>
                                    <option value="قرنطینه" selected="@(Model.Status == "قرنطینه")">قرنطینه</option>
                                    <option value="آزاد شده" selected="@(Model.Status == "آزاد شده")">آزاد شده</option>
                                    <option value="رد شده" selected="@(Model.Status == "رد شده")">رد شده</option>
                                    <option value="مصرف شده" selected="@(Model.Status == "مصرف شده")">مصرف شده</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ExpiryDate" class="form-label">تاریخ انقضا</label>
                                <input asp-for="ExpiryDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Information Panel -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <h6><i class="bx bx-info-circle me-1"></i> اطلاعات مفید:</h6>
                                <ul class="mb-0">
                                    <li><strong>ماده اولیه:</strong> @Model.Material?.MaterialName (@Model.Material?.MaterialCode)</li>
                                    <li><strong>شماره بچ:</strong> @Model.BatchNumber</li>
                                    <li>تغییر ماده اولیه و شماره بچ بعد از ایجاد امکان‌پذیر نیست</li>
                                    <li>تغییر مقدار فعلی باید با احتیاط انجام شود</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert:not(.alert-info)');
            alerts.forEach(function (alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Validate current quantity
        document.getElementById('CurrentQuantity').addEventListener('input', function() {
            var initialQty = parseFloat(document.getElementById('InitialQuantity').value) || 0;
            var currentQty = parseFloat(this.value) || 0;

            if (currentQty > initialQty) {
                this.setCustomValidity('مقدار فعلی نمی‌تواند بیشتر از مقدار اولیه باشد');
            } else if (currentQty < 0) {
                this.setCustomValidity('مقدار فعلی نمی‌تواند منفی باشد');
            } else {
                this.setCustomValidity('');
            }
        });
    </script>
}