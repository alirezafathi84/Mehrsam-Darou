@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.MaterialRequest>

@{
    ViewData["Title"] = "لیست درخواست‌های مواد";
}

<!-- Display Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">لیست درخواست‌های مواد</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">درخواست‌ها</a></li>
                    <li class="breadcrumb-item active">لیست درخواست‌ها</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="card card-height-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-primary-subtle text-primary rounded-circle fs-3">
                            <i class="bx bx-file"></i>
                        </span>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <p class="text-uppercase fw-medium text-muted mb-1">کل درخواست‌ها</p>
                        <h4 class="mb-0">@(Model?.Count() ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-height-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-warning-subtle text-warning rounded-circle fs-3">
                            <i class="bx bx-time-five"></i>
                        </span>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <p class="text-uppercase fw-medium text-muted mb-1">در انتظار</p>
                        <h4 class="mb-0">@(Model?.Where(r => r.Status == "در انتظار بررسی").Count() ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-height-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-success-subtle text-success rounded-circle fs-3">
                            <i class="bx bx-check-circle"></i>
                        </span>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <p class="text-uppercase fw-medium text-muted mb-1">تأیید شده</p>
                        <h4 class="mb-0">@(Model?.Where(r => r.Status == "تأیید شده").Count() ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card card-height-100">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-info-subtle text-info rounded-circle fs-3">
                            <i class="bx bx-hourglass"></i>
                        </span>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <p class="text-uppercase fw-medium text-muted mb-1">فوری</p>
                        <h4 class="mb-0">@(Model?.Where(r => r.IsUrgent == true).Count() ?? 0)</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <div class="flex-grow-1">
                        <a href="@Url.Action("AddRequest")" class="btn btn-success">
                            <i class="ri-add-fill me-1"></i> درخواست جدید
                        </a>
                    </div>
                    <div class="flex-shrink-0">
                        <a href="@Url.Action("MyRequests")" class="btn btn-outline-primary">
                            <i class="ri-user-line me-1"></i> درخواست‌های من
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <!-- Search and Filters -->
                <form method="get" asp-action="RequestList" class="mb-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="search-box">
                                <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]"
                                       class="form-control" placeholder="جستجو...">
                                <i class="ri-search-line search-icon"></i>
                            </div>
                        </div>
                        <div class="col-md-3">
                            @{
                                var selectedStatus = Context.Request.Query["status"].ToString();
                            }
                            <select name="status" class="form-select">
                                <option value="">همه وضعیت‌ها</option>
                                <option value="در انتظار بررسی" selected="@(selectedStatus == "در انتظار بررسی")">در انتظار بررسی</option>
                                <option value="در حال بررسی" selected="@(selectedStatus == "در حال بررسی")">در حال بررسی</option>
                                <option value="تأیید شده" selected="@(selectedStatus == "تأیید شده")">تأیید شده</option>
                                <option value="رد شده" selected="@(selectedStatus == "رد شده")">رد شده</option>
                                <option value="تکمیل شده" selected="@(selectedStatus == "تکمیل شده")">تکمیل شده</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            @{
                                var selectedPriority = Context.Request.Query["priority"].ToString();
                            }
                            <select name="priority" class="form-select">
                                <option value="">همه اولویت‌ها</option>
                                <option value="1" selected="@(selectedPriority == "1")">بحرانی (1)</option>
                                <option value="2" selected="@(selectedPriority == "2")">بالا (2)</option>
                                <option value="3" selected="@(selectedPriority == "3")">متوسط (3)</option>
                                <option value="4" selected="@(selectedPriority == "4")">پایین (4)</option>
                                <option value="5" selected="@(selectedPriority == "5")">خیلی پایین (5)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="ri-equalizer-fill me-1"></i> فیلتر
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Requests Table -->
                <div class="table-responsive">
                    <table class="table align-middle table-nowrap table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>شماره درخواست</th>
                                <th>عنوان</th>
                                <th>درخواست‌کننده</th>
                                <th>دسته‌بندی</th>
                                <th>تاریخ</th>
                                <th>اولویت</th>
                                <th>وضعیت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var request in Model)
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("ProcessRequest", new { id = request.RequestId })" class="fw-medium text-primary">
                                                @request.RequestNumber
                                            </a>
                                            @if (request.IsUrgent)
                                            {
                                                <span class="badge bg-danger ms-1 fs-11">فوری</span>
                                            }
                                        </td>
                                        <td>
                                            <div>
                                                @request.RequestTitle
                                                @if (!string.IsNullOrEmpty(request.Description))
                                                {
                                                    <br>

                                                    <small class="text-muted">
                                                        @(request.Description.Length > 50 ?
                                                            request.Description.Substring(0, 50) + "..." :
                                                            request.Description)
                                                    </small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (request.RequestedByNavigation != null)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="flex-shrink-0 me-2">
                                                        <img src="@(request.RequestedByNavigation.AvatarImg ?? "/images/users/dummy-avatar.jpg")"
                                                             alt="" class="avatar-xs rounded-circle">
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-0 fs-14">@request.RequestedByNavigation.FirstName @request.RequestedByNavigation.LastName</h6>
                                                        @if (!string.IsNullOrEmpty(request.Department))
                                                        {
                                                            <small class="text-muted">@request.Department</small>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if (request.Category != null)
                                            {
                                                if (request.Category.CategoryType == "مواد")
                                                {
                                                    <span class="badge bg-primary">@request.Category.CategoryName</span>
                                                }
                                                else if (request.Category.CategoryType == "ملزومات")
                                                {
                                                    <span class="badge bg-info">@request.Category.CategoryName</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@request.Category.CategoryName</span>
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (request.RequestDate != null)
                                            {
                                                @request.RequestDate.ToString("yyyy/MM/dd")
                                                @request.RequestDate.ToString("HH:mm")
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var priorityClass = request.PriorityLevel switch
                                                {
                                                    1 => "bg-danger",
                                                    2 => "bg-warning",
                                                    3 => "bg-primary",
                                                    4 => "bg-info",
                                                    5 => "bg-light text-dark",
                                                    _ => "bg-secondary"
                                                };
                                                var priorityText = request.PriorityLevel switch
                                                {
                                                    1 => "بحرانی",
                                                    2 => "بالا",
                                                    3 => "متوسط",
                                                    4 => "پایین",
                                                    5 => "خیلی پایین",
                                                    _ => "نامشخص"
                                                };
                                            }
                                            <span class="badge @priorityClass fs-12">@priorityText</span>
                                        </td>
                                        <td>
                                            @{
                                                var statusClass = request.Status switch
                                                {
                                                    "در انتظار بررسی" => "bg-warning-subtle text-warning",
                                                    "در حال بررسی" => "bg-info-subtle text-info",
                                                    "تأیید شده" => "bg-success-subtle text-success",
                                                    "رد شده" => "bg-danger-subtle text-danger",
                                                    "تکمیل شده" => "bg-dark-subtle text-body",
                                                    _ => "bg-light text-dark"
                                                };
                                            }
                                            <span class="badge @statusClass fs-12">@request.Status</span>
                                        </td>
                                        <td>
                                            <div class="dropdown">
                                                <button class="btn btn-soft-secondary btn-sm dropdown-toggle" type="button"
                                                        data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="ri-more-fill"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <a class="dropdown-item" href="@Url.Action("ProcessRequest", new { id = request.RequestId })">
                                                            <i class="ri-eye-fill me-2 text-muted"></i> مشاهده
                                                        </a>
                                                    </li>
                                                    @if (request.Status == "در انتظار بررسی")
                                                    {
                                                        <li>
                                                            <a class="dropdown-item text-success" href="#" onclick="quickApprove('@request.RequestId')">
                                                                <i class="ri-check-fill me-2"></i> تأیید سریع
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <div class="d-flex flex-column align-items-center">
                                            <i class="ri-file-search-line display-4 text-muted mb-3"></i>
                                            <h5 class="text-muted">هیچ درخواستی یافت نشد</h5>
                                            <p class="text-muted mb-3">برای شروع، یک درخواست جدید ایجاد کنید</p>
                                            <a href="@Url.Action("AddRequest")" class="btn btn-primary">
                                                <i class="ri-add-line me-1"></i> درخواست جدید
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model != null && Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-end mt-3">
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                @if (Model.HasPreviousPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("RequestList", new {
                                            page = Model.PageIndex - 1,
                                            searchKey = Context.Request.Query["searchKey"],
                                            status = Context.Request.Query["status"],
                                            priority = Context.Request.Query["priority"]
                                        })">
                                            <i class="mdi mdi-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">
                                            <i class="mdi mdi-chevron-right"></i>
                                        </span>
                                    </li>
                                }

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("RequestList", new {
                                            page = i,
                                            searchKey = Context.Request.Query["searchKey"],
                                            status = Context.Request.Query["status"],
                                            priority = Context.Request.Query["priority"]
                                        })">@i</a>
                                    </li>
                                }

                                @if (Model.HasNextPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("RequestList", new {
                                            page = Model.PageIndex + 1,
                                            searchKey = Context.Request.Query["searchKey"],
                                            status = Context.Request.Query["status"],
                                            priority = Context.Request.Query["priority"]
                                        })">
                                            <i class="mdi mdi-chevron-left"></i>
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">
                                            <i class="mdi mdi-chevron-left"></i>
                                        </span>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickApprove(requestId) {
            if (confirm('آیا مطمئن هستید که می‌خواهید این درخواست را تأیید کنید؟')) {
                // AJAX call to approve - implement this based on your needs
                alert('عملیات تأیید سریع در حال توسعه است');
            }
        }

        // Auto-submit form on filter change
        document.querySelector('select[name="status"]').addEventListener('change', function() {
            this.form.submit();
        });

        document.querySelector('select[name="priority"]').addEventListener('change', function() {
            this.form.submit();
        });
    </script>
}