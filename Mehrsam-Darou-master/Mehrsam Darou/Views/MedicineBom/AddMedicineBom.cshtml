@model Mehrsam_Darou.Models.MedicineBom
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "افزودن فرمول دارو جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن فرمول دارو جدید</h4>
                    <a href="@Url.Action("MedicineBomList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddMedicineBom">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MedicineId" class="form-label">دارو <span class="text-danger">*</span></label>
                                <select asp-for="MedicineId" class="form-select" id="medicineSelect">
                                    <option value="">-- انتخاب دارو --</option>
                                    @foreach (var medicine in ViewBag.Medicines as List<SelectListItem>)
                                    {
                                        <option value="@medicine.Value">@medicine.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="MedicineId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MaterialId" class="form-label">ماده اولیه <span class="text-danger">*</span></label>
                                <select asp-for="MaterialId" class="form-select" id="materialSelect">
                                    <option value="">-- انتخاب ماده اولیه --</option>
                                    @foreach (var material in ViewBag.Materials as List<SelectListItem>)
                                    {
                                        <option value="@material.Value">@material.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="MaterialId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Quantity" class="form-label">مقدار <span class="text-danger">*</span></label>
                                <input asp-for="Quantity" type="number" step="0.000001" min="0" class="form-control" placeholder="مقدار مورد نیاز را وارد کنید" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                                <div class="form-text">
                                    <i class="bx bx-info-circle me-1"></i>
                                    مقدار با دقت 6 رقم اعشار قابل ثبت است
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UnitId" class="form-label">واحد <span class="text-danger">*</span></label>
                                <select asp-for="UnitId" class="form-select" id="unitSelect">
                                    <option value="">-- انتخاب واحد --</option>
                                    @foreach (var unit in ViewBag.Units as List<SelectListItem>)
                                    {
                                        <option value="@unit.Value">@unit.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="UnitId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="IsActive" class="form-label">وضعیت</label>
                                <select asp-for="IsActive" class="form-select">
                                    <option value="true">فعال</option>
                                    <option value="false">غیرفعال</option>
                                </select>
                                <span asp-validation-for="IsActive" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <div class="form-text mt-4">
                                    <i class="bx bx-lightbulb me-1"></i>
                                    <strong>نکته:</strong> هر ماده اولیه فقط یک بار برای هر دارو قابل تعریف است
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Preview Section -->
                    <div class="row" id="previewSection" style="display: none;">
                        <div class="col-12">
                            <div class="card bg-light">
                                <div class="card-header">
                                    <h6 class="mb-0">پیش‌نمایش فرمول</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <strong>دارو:</strong>
                                            <div id="previewMedicine" class="text-primary"></div>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>ماده اولیه:</strong>
                                            <div id="previewMaterial" class="text-success"></div>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>مقدار:</strong>
                                            <div id="previewQuantity" class="text-info"></div>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>واحد:</strong>
                                            <div id="previewUnit" class="text-warning"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="bx bx-save me-1"></i> ذخیره فرمول
                        </button>
                        <button type="button" class="btn btn-outline-info" onclick="updatePreview()">
                            <i class="bx bx-show me-1"></i> پیش‌نمایش
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Auto update preview when form fields change
            const formFields = ['medicineSelect', 'materialSelect', 'quantity', 'unitSelect'];
            formFields.forEach(fieldId => {
                const field = document.getElementById(fieldId) || document.querySelector(`input[name="${fieldId}"]`);
                if (field) {
                    field.addEventListener('change', updatePreview);
                    field.addEventListener('input', updatePreview);
                }
            });
        });

        function updatePreview() {
            const medicineSelect = document.getElementById('medicineSelect');
            const materialSelect = document.getElementById('materialSelect');
            const quantityInput = document.querySelector('input[name="Quantity"]');
            const unitSelect = document.getElementById('unitSelect');
            const previewSection = document.getElementById('previewSection');

            // Check if all required fields have values
            if (medicineSelect.value && materialSelect.value && quantityInput.value && unitSelect.value) {
                document.getElementById('previewMedicine').textContent = medicineSelect.options[medicineSelect.selectedIndex].text;
                document.getElementById('previewMaterial').textContent = materialSelect.options[materialSelect.selectedIndex].text;
                document.getElementById('previewQuantity').textContent = parseFloat(quantityInput.value).toFixed(6);
                document.getElementById('previewUnit').textContent = unitSelect.options[unitSelect.selectedIndex].text;

                previewSection.style.display = 'block';
            } else {
                previewSection.style.display = 'none';
            }
        }

        // Enhanced form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const quantity = document.querySelector('input[name="Quantity"]').value;
            if (quantity && parseFloat(quantity) <= 0) {
                e.preventDefault();
                alert('مقدار باید بیشتر از صفر باشد');
                return false;
            }
        });

        // Add search functionality to select boxes
        document.addEventListener('DOMContentLoaded', function() {
            // You can add select2 or similar library for better UX
            // This is a basic implementation
            addSelectSearch('medicineSelect');
            addSelectSearch('materialSelect');
            addSelectSearch('unitSelect');
        });

        function addSelectSearch(selectId) {
            const select = document.getElementById(selectId);
            if (!select) return;

            // Basic keyboard navigation for select boxes
            select.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                }
            });
        }
    </script>
}