@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.MedicineBom>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "لیست فرمول داروها";
}

<h2 class="mb-4">لیست فرمول داروها</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                    <form method="get" asp-action="MedicineBomList" class="d-flex gap-2 flex-wrap">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو در نام دارو یا ماده اولیه...">
                        </div>
                        <select name="medicineId" class="form-select" style="width: 250px;">
                            <option value="">-- همه داروها --</option>
                            @foreach (var medicine in ViewBag.Medicines as List<SelectListItem>)
                            {
                                <option value="@medicine.Value" selected="@(medicine.Value == ViewBag.SelectedMedicineId?.ToString())">@medicine.Text</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bx bx-filter me-1"></i> فیلتر
                        </button>
                        <a href="@Url.Action("MedicineBomList")" class="btn btn-outline-secondary">
                            <i class="bx bx-refresh me-1"></i> پاک کردن
                        </a>
                    </form>
                    <div>
                        <a href="@Url.Action("AddMedicineBom")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> فرمول جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>نام دارو</th>
                                <th>کد دارو</th>
                                <th>ماده اولیه</th>
                                <th>کد ماده</th>
                                <th>مقدار</th>
                                <th>واحد</th>
                                <th>وضعیت</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var bom in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-primary-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:pills-3-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@bom.Medicine?.BrandName</h6>
                                                    <small class="text-muted">@bom.Medicine?.MedicineCode</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@bom.Medicine?.MedicineCode</span></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-success-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:atom-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@bom.Material?.MaterialName</h6>
                                                    <small class="text-muted">@bom.Material?.MaterialCode</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@bom.Material?.MaterialCode</span></td>
                                        <td>
                                            <span class="fw-medium text-primary">@bom.Quantity.ToString("N6")</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info">
                                                @bom.Unit?.UnitName (@bom.Unit?.UnitSymbol)
                                            </span>
                                        </td>
                                        <td>
                                            @if (bom.IsActive == true)
                                            {
                                                <span class="badge bg-success">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غیرفعال</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditMedicineBom", new { id = bom.BomId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                             @*                    <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showFormulaDetails('@bom.MedicineId')"
                                                        title="مشاهده فرمول کامل">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </button> *@
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@bom.BomId"
                                                        data-bs-medicine="@bom.Medicine?.BrandName"
                                                        data-bs-material="@bom.Material?.MaterialName"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <i class="bx bx-package text-muted fs-1"></i>
                                        <p class="mt-2">هیچ فرمول دارویی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("MedicineBomList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"], medicineId = Context.Request.Query["medicineId"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("MedicineBomList", new { page = i, searchKey = Context.Request.Query["searchKey"], medicineId = Context.Request.Query["medicineId"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("MedicineBomList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"], medicineId = Context.Request.Query["medicineId"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف فرمول دارو</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این فرمول مطمئن هستید؟</p>
                <div class="alert alert-info">
                    <strong>دارو:</strong> <span id="medicineNameToDelete"></span><br>
                    <strong>ماده اولیه:</strong> <span id="materialNameToDelete"></span>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="bomIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Formula Details Modal -->
<div class="modal fade" id="formulaDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">فرمول کامل دارو</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="formulaDetailsContent">
                <!-- Formula details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var bomId = button.getAttribute('data-bs-id');
                var medicineName = button.getAttribute('data-bs-medicine');
                var materialName = button.getAttribute('data-bs-material');

                document.getElementById('medicineNameToDelete').textContent = medicineName;
                document.getElementById('materialNameToDelete').textContent = materialName;
                document.getElementById('bomIdToDelete').value = bomId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showFormulaDetails(medicineId) {
            var modal = new bootstrap.Modal(document.getElementById('formulaDetailsModal'));
            document.getElementById('formulaDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Load formula details via AJAX
            fetch('@Url.Action("GetMedicineFormula")/' + medicineId)
                .then(response => response.json())
                .then(data => {
                    let content = '<div class="table-responsive"><table class="table table-sm"><thead class="bg-light"><tr><th>ماده اولیه</th><th>کد</th><th>مقدار</th><th>واحد</th></tr></thead><tbody>';

                    data.forEach(item => {
                        content += `<tr>
                            <td>${item.materialName}</td>
                            <td><span class="badge bg-light text-dark">${item.materialCode}</span></td>
                            <td><span class="fw-medium">${item.quantity}</span></td>
                            <td><span class="badge bg-info-subtle text-info">${item.unitName} (${item.unitSymbol})</span></td>
                        </tr>`;
                    });

                    content += '</tbody></table></div>';

                    if (data.length === 0) {
                        content = '<div class="text-center py-4"><i class="bx bx-package text-muted fs-1"></i><p class="mt-2">فرمولی برای این دارو تعریف نشده است.</p></div>';
                    }

                    document.getElementById('formulaDetailsContent').innerHTML = content;
                })
                .catch(error => {
                    document.getElementById('formulaDetailsContent').innerHTML =
                        '<div class="text-center py-4 text-danger"><i class="bx bx-error fs-1"></i><p class="mt-2">خطا در بارگذاری اطلاعات</p></div>';
                });
        }
    </script>
}