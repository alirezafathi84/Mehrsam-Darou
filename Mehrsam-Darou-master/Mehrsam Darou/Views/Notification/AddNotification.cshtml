@model Mehrsam_Darou.Models.Notification

@{
    ViewData["Title"] = "افزودن اعلان جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن اعلان جدید</h4>
                    <a href="@Url.Action("NotificationList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddNotification">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">عنوان اعلان <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control" maxlength="50" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Type" class="form-label">نوع اعلان</label>
                                <select asp-for="Type" class="form-select">
                                    <option value="Info">اطلاعات</option>
                                    <option value="Warning">هشدار</option>
                                    <option value="Error">خطا</option>
                                    <option value="Success">موفقیت</option>
                                    <option value="System">سیستم</option>
                                    <option value="chat">چت</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">نوع گیرنده <span class="text-danger">*</span></label>
                                <select id="recipientType" name="recipientType" class="form-select" onchange="handleRecipientTypeChange()">
                                    <option value="user">کاربر خاص</option>
                                    <option value="team">تیم</option>
                                    <option value="all">همه کاربران</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3" id="userSelection">
                                <label asp-for="UserId" class="form-label">کاربر <span class="text-danger">*</span></label>
                                <select asp-for="UserId" class="form-select" id="userSelect">
                                    <option value="">-- انتخاب کاربر --</option>
                                    @foreach (var user in ViewBag.Users)
                                    {
                                        <option value="@user.Id">@user.DisplayName</option>
                                    }
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                            <div class="mb-3" id="teamSelection" style="display: none;">
                                <label class="form-label">تیم <span class="text-danger">*</span></label>
                                <select id="teamSelect" name="teamId" class="form-select">
                                    <option value="">-- انتخاب تیم --</option>
                                    @foreach (var team in ViewBag.Teams)
                                    {
                                        <option value="@team.Id">@team.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3" id="allUsersInfo" style="display: none;">
                                <div class="alert alert-info">
                                    <i class="bx bx-info-circle me-1"></i>
                                    اعلان برای تمامی کاربران فعال سیستم ارسال خواهد شد
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="RelatedId" class="form-label">شناسه مرتبط</label>
                                <input asp-for="RelatedId" class="form-control" />
                                <span asp-validation-for="RelatedId" class="text-danger"></span>
                                <small class="form-text text-muted">شناسه رکورد مرتبط با این اعلان (اختیاری)</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Img" class="form-label">تصویر اعلان</label>
                                <input asp-for="Img" class="form-control" maxlength="150" />
                                <span asp-validation-for="Img" class="text-danger"></span>
                                <small class="form-text text-muted">آدرس تصویر یا نام فایل (اختیاری)</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <label asp-for="Message" class="form-label">پیام اعلان <span class="text-danger">*</span></label>
                                <textarea asp-for="Message" class="form-control" rows="4" maxlength="150"></textarea>
                                <span asp-validation-for="Message" class="text-danger"></span>
                                <small class="form-text text-muted">حداکثر 150 کاراکتر</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <label class="form-label">پیش‌نمایش اعلان</label>
                                <div class="card">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-light-subtle rounded me-2">
                                                <span class="avatar-title">
                                                    <iconify-icon icon="solar:bell-bold-duotone" class="fs-18"></iconify-icon>
                                                </span>
                                            </div>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0 fw-medium" id="preview-title">عنوان اعلان</h6>
                                                <p class="mb-0 text-muted small" id="preview-message">پیام اعلان اینجا نمایش داده می‌شود</p>
                                                <small class="text-muted">
                                                    <span id="preview-type">نوع: اطلاعات</span>
                                                    <span class="mx-2">•</span>
                                                    <span id="preview-recipient">گیرنده: کاربر خاص</span>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-send me-1"></i> ارسال اعلان
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="resetForm()">
                            <i class="bx bx-reset me-1"></i> بازنشانی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            updatePreview();

            document.getElementById('Title').addEventListener('input', updatePreview);
            document.getElementById('Message').addEventListener('input', updatePreview);
            document.getElementById('Type').addEventListener('change', updatePreview);
            document.getElementById('recipientType').addEventListener('change', updatePreview);
            document.getElementById('userSelect').addEventListener('change', updatePreview);
            document.getElementById('teamSelect').addEventListener('change', updatePreview);
        });

        function handleRecipientTypeChange() {
            const recipientType = document.getElementById('recipientType').value;
            const userSelection = document.getElementById('userSelection');
            const teamSelection = document.getElementById('teamSelection');
            const allUsersInfo = document.getElementById('allUsersInfo');
            const userSelect = document.getElementById('userSelect');
            const teamSelect = document.getElementById('teamSelect');

            // Hide all sections first
            userSelection.style.display = 'none';
            teamSelection.style.display = 'none';
            allUsersInfo.style.display = 'none';

            // Clear previous selections
            userSelect.value = '';
            teamSelect.value = '';

            // Show appropriate section and set required fields
            switch (recipientType) {
                case 'user':
                    userSelection.style.display = 'block';
                    userSelect.required = true;
                    teamSelect.required = false;
                    break;
                case 'team':
                    teamSelection.style.display = 'block';
                    userSelect.required = false;
                    teamSelect.required = true;
                    break;
                case 'all':
                    allUsersInfo.style.display = 'block';
                    userSelect.required = false;
                    teamSelect.required = false;
                    userSelect.value = ''; // Clear UserId for all users
                    break;
            }

            updatePreview();
        }

        function updatePreview() {
            const title = document.getElementById('Title').value || 'عنوان اعلان';
            const message = document.getElementById('Message').value || 'پیام اعلان اینجا نمایش داده می‌شود';
            const type = document.getElementById('Type').value;
            const recipientType = document.getElementById('recipientType').value;

            document.getElementById('preview-title').textContent = title;
            document.getElementById('preview-message').textContent = message;

            const typeNames = {
                'Info': 'اطلاعات',
                'Warning': 'هشدار',
                'Error': 'خطا',
                'Success': 'موفقیت',
                'System': 'سیستم',
                'chat': 'چت'
            };

            const recipientNames = {
                'user': 'کاربر خاص',
                'team': 'تیم',
                'all': 'همه کاربران'
            };

            document.getElementById('preview-type').textContent = 'نوع: ' + (typeNames[type] || type);
            document.getElementById('preview-recipient').textContent = 'گیرنده: ' + recipientNames[recipientType];
        }

        function resetForm() {
            document.querySelector('form').reset();
            handleRecipientTypeChange();
            updatePreview();
        }

        // Initialize on page load
        handleRecipientTypeChange();
    </script>
}