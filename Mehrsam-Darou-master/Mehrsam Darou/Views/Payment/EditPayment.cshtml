@model Mehrsam_Darou.Models.PaymentTransaction

@{
    ViewData["Title"] = "ویرایش پرداخت";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش پرداخت</h4>
                    <a href="@Url.Action("PaymentList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditPayment">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="TransactionId" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TransactionNumber" class="form-label">شماره تراکنش <span class="text-danger">*</span></label>
                                <input asp-for="TransactionNumber" class="form-control" readonly />
                                <span asp-validation-for="TransactionNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TransactionType" class="form-label">نوع تراکنش <span class="text-danger">*</span></label>
                                <select asp-for="TransactionType" class="form-select">
                                    <option value="">-- انتخاب نوع تراکنش --</option>
                                    @foreach (var type in ViewBag.TransactionTypes as List<string>)
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                                <span asp-validation-for="TransactionType" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Amount" class="form-label">مبلغ <span class="text-danger">*</span></label>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="PaymentMethodId" class="form-label">روش پرداخت <span class="text-danger">*</span></label>
                                <select asp-for="PaymentMethodId" class="form-select">
                                    <option value="">-- انتخاب روش پرداخت --</option>
                                    @if (ViewBag.PaymentMethods != null)
                                    {
                                        @foreach (var method in (IEnumerable<dynamic>)ViewBag.PaymentMethods)
                                        {
                                            <option value="@method.PaymentMethodId">@method.MethodName - @method.MethodType</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت</label>
                                <select asp-for="Status" class="form-select">
                                    @foreach (var status in ViewBag.StatusList as List<string>)
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CustomerId" class="form-label">مشتری</label>
                                <select asp-for="CustomerId" class="form-select">
                                    <option value="">-- انتخاب مشتری --</option>
                                    @if (ViewBag.Customers != null)
                                    {
                                        @foreach (var customer in (IEnumerable<dynamic>)ViewBag.Customers)
                                        {
                                            <option value="@customer.CustomerId">@customer.CustomerName - @customer.CustomerCode</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="SupplierId" class="form-label">تامین‌کننده</label>
                                <select asp-for="SupplierId" class="form-select">
                                    <option value="">-- انتخاب تامین‌کننده --</option>
                                    @if (ViewBag.Suppliers != null)
                                    {
                                        @foreach (var supplier in (IEnumerable<dynamic>)ViewBag.Suppliers)
                                        {
                                            <option value="@supplier.SupplierId">@supplier.SupplierName - @supplier.SupplierCode</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="TransactionDate" class="form-label">تاریخ تراکنش <span class="text-danger">*</span></label>
                                <input asp-for="TransactionDate" type="date" class="form-control" />
                                <span asp-validation-for="TransactionDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="DueDate" class="form-label">تاریخ سررسید</label>
                                <input asp-for="DueDate" type="date" class="form-control" />
                                <span asp-validation-for="DueDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="ReferenceNumber" class="form-label">شماره مرجع</label>
                                <input asp-for="ReferenceNumber" class="form-control" placeholder="شماره چک، کارت، حواله..." />
                                <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="BankName" class="form-label">نام بانک</label>
                                <input asp-for="BankName" class="form-control" />
                                <span asp-validation-for="BankName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="AccountNumber" class="form-label">شماره حساب</label>
                                <input asp-for="AccountNumber" class="form-control" />
                                <span asp-validation-for="AccountNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">توضیحات</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="توضیحات تکمیلی..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden fields to maintain values -->
                    <input type="hidden" asp-for="Currency" />

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}