@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.Project>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست پروژه‌ها";
}

<h2 class="mb-4">لیست پروژه‌ها</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="ProjectList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddProject")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> پروژه جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>نام پروژه</th>
                                <th>کد پروژه</th>
                                <th>تاریخ شروع</th>
                                <th>تاریخ پایان</th>
                                <th>وضعیت</th>
                                <th>فعال/غیرفعال</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var project in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:clipboard-list-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@project.ProjectName</h6>
                                                    @if (!string.IsNullOrEmpty(project.Description))
                                                    {
                                                        <small class="text-muted">@(project.Description.Length > 50 ? project.Description.Substring(0, 50) + "..." : project.Description)</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-light text-dark">@project.ProjectCode</span></td>
                                        <td>
                                            @if (project.StartDate.HasValue)
                                            {
                                                var startDate = project.StartDate.Value.ToDateTime(TimeOnly.MinValue);
                                                <small class="text-muted">
                                                    @pc.GetYear(startDate)/@pc.GetMonth(startDate).ToString("00")/@pc.GetDayOfMonth(startDate).ToString("00")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (project.EndDate.HasValue)
                                            {
                                                var endDate = project.EndDate.Value.ToDateTime(TimeOnly.MinValue);
                                                <small class="text-muted">
                                                    @pc.GetYear(endDate)/@pc.GetMonth(endDate).ToString("00")/@pc.GetDayOfMonth(endDate).ToString("00")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(project.Status))
                                            {
                                                var badgeClass = project.Status switch
                                                {
                                                    "فعال" => "bg-success",
                                                    "تعلیق" => "bg-warning",
                                                    "تکمیل شده" => "bg-info",
                                                    "لغو شده" => "bg-danger",
                                                    _ => "bg-secondary"
                                                };
                                                <span class="badge @badgeClass">@project.Status</span>
                                            }
                                        </td>
                                        <td>
                                            @if (project.IsActive == true)
                                            {
                                                <span class="badge bg-success">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غیرفعال</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @pc.GetYear(project.CreatedDate)/@pc.GetMonth(project.CreatedDate).ToString("00")/@pc.GetDayOfMonth(project.CreatedDate).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditProject", new { id = project.ProjectId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showProjectDetails('@project.ProjectId')"
                                                        title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@project.ProjectId"
                                                        data-bs-name="@project.ProjectName"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4">
                                        <i class="bx bx-folder text-muted fs-1"></i>
                                        <p class="mt-2">هیچ پروژه‌ای یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ProjectList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ProjectList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ProjectList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف پروژه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این پروژه مطمئن هستید؟</p>
                <p id="projectNameToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> در صورت وجود درخواست مواد، امکان حذف وجود ندارد.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="projectIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Project Details Modal -->
<div class="modal fade" id="projectDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات پروژه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="projectDetailsContent">
                <!-- Project details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var projectId = button.getAttribute('data-bs-id');
                var projectName = button.getAttribute('data-bs-name');

                document.getElementById('projectNameToDelete').textContent = projectName;
                document.getElementById('projectIdToDelete').value = projectId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showProjectDetails(projectId) {
            // This would typically load project details via AJAX
            // For now, just show a placeholder
            var modal = new bootstrap.Modal(document.getElementById('projectDetailsModal'));
            document.getElementById('projectDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Simulate loading details
            setTimeout(function() {
                document.getElementById('projectDetailsContent').innerHTML =
                    '<p>جزئیات کامل پروژه اینجا نمایش داده خواهد شد.</p>' +
                    '<p>شامل توضیحات، تاریخچه و درخواست‌های مواد مرتبط...</p>';
            }, 1000);
        }
    </script>
}