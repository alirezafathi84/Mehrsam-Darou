@model Mehrsam_Darou.Models.PurchaseInvoice

@{
    ViewData["Title"] = "ویرایش فاکتور خرید";
    var items = ViewBag.PurchaseInvoiceItems as List<Mehrsam_Darou.Models.PurchaseInvoiceItem>;
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش فاکتور خرید - @Model.InvoiceNumber</h4>
                    <a href="@Url.Action("PurchaseInvoiceList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditPurchaseInvoice" asp-route-id="@Model.PurchaseInvoiceId">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="PurchaseInvoiceId" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="InvoiceNumber" class="form-label">شماره فاکتور <span class="text-danger">*</span></label>
                                <input asp-for="InvoiceNumber" class="form-control" readonly />
                                <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="SupplierInvoiceNumber" class="form-label">شماره فاکتور تامین‌کننده</label>
                                <input asp-for="SupplierInvoiceNumber" class="form-control" />
                                <span asp-validation-for="SupplierInvoiceNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="SupplierId" class="form-label">تامین‌کننده <span class="text-danger">*</span></label>
                                <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                                    <option value="">-- انتخاب تامین‌کننده --</option>
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PurchaseOrderId" class="form-label">سفارش خرید مرتبط</label>
                                <select asp-for="PurchaseOrderId" asp-items="ViewBag.PurchaseOrders" class="form-select">
                                    <option value="">-- انتخاب سفارش خرید --</option>
                                </select>
                                <span asp-validation-for="PurchaseOrderId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="InvoiceDate" class="form-label">تاریخ فاکتور <span class="text-danger">*</span></label>
                                <input asp-for="InvoiceDate" type="date" class="form-control" />
                                <span asp-validation-for="InvoiceDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DueDate" class="form-label">تاریخ سررسید</label>
                                <input asp-for="DueDate" type="date" class="form-control" />
                                <span asp-validation-for="DueDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Subtotal" class="form-label">مبلغ قبل از تخفیف و مالیات</label>
                                <input asp-for="Subtotal" type="number" step="0.01" class="form-control" readonly />
                                <span asp-validation-for="Subtotal" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TaxAmount" class="form-label">مبلغ مالیات</label>
                                <input asp-for="TaxAmount" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="TaxAmount" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="DiscountAmount" class="form-label">مبلغ تخفیف</label>
                                <input asp-for="DiscountAmount" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TotalAmount" class="form-label">مبلغ کل</label>
                                <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" readonly />
                                <span asp-validation-for="TotalAmount" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="PaidAmount" class="form-label">مبلغ پرداخت شده</label>
                                <input asp-for="PaidAmount" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="PaidAmount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Currency" class="form-label">واحد پول</label>
                                <select asp-for="Currency" class="form-select">
                                    <option value="IRR">ریال (IRR)</option>
                                    <option value="USD">دلار آمریکا (USD)</option>
                                    <option value="EUR">یورو (EUR)</option>
                                </select>
                                <span asp-validation-for="Currency" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="پیش‌نویس">پیش‌نویس</option>
                                    <option value="در انتظار">در انتظار</option>
                                    <option value="تایید شده">تایید شده</option>
                                    <option value="پرداخت شده">پرداخت شده</option>
                                    <option value="سررسید گذشته">سررسید گذشته</option>
                                    <option value="لغو شده">لغو شده</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PaymentMethod" class="form-label">روش پرداخت</label>
                                <select asp-for="PaymentMethod" class="form-select">
                                    <option value="">-- انتخاب روش پرداخت --</option>
                                    <option value="نقدی">نقدی</option>
                                    <option value="چک">چک</option>
                                    <option value="کارت به کارت">کارت به کارت</option>
                                    <option value="حواله">حواله</option>
                                    <option value="سفته">سفته</option>
                                </select>
                                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label">یادداشت‌ها</label>
                                <textarea asp-for="Notes" class="form-control" rows="2" placeholder="یادداشت‌های اضافی در مورد فاکتور خرید..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- آیتم‌های فاکتور خرید -->
<div class="row mt-4">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0">آیتم‌های فاکتور خرید</h5>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addItemModal">
                        <i class="bx bx-plus me-1"></i> افزودن آیتم
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover" id="itemsTable">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>ماده اولیه</th>
                                <th>مقدار</th>
                                <th>واحد</th>
                                <th>قیمت واحد</th>
                                <th>قیمت کل</th>
                                <th>بچ</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (items != null && items.Any())
                            {
                                foreach (var item in items)
                                {
                                    <tr data-item-id="@item.PiItemId">
                                        <td>@item.Material?.MaterialName</td>
                                        <td>@item.Quantity.ToString("0.###")</td>
                                        <td>@item.Unit?.UnitName</td>
                                        <td>@item.UnitPrice.ToString("N0")</td>
                                        <td>@item.TotalPrice.ToString("N0")</td>
                                        <td>@(item.Batch?.BatchNumber ?? "-")</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-soft-primary btn-sm edit-item-btn"
                                                        data-item-id="@item.PiItemId" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-danger btn-sm delete-item-btn"
                                                        data-item-id="@item.PiItemId" title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="noItemsRow">
                                    <td colspan="7" class="text-center py-4">
                                        <i class="bx bx-package text-muted fs-1"></i>
                                        <p class="mt-2">هیچ آیتمی برای این فاکتور خرید ثبت نشده است.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مودال افزودن آیتم -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">افزودن آیتم جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <form id="addItemForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PurchaseInvoiceId" value="@Model.PurchaseInvoiceId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ماده اولیه <span class="text-danger">*</span></label>
                                <select name="MaterialId" class="form-select" required>
                                    <option value="">-- انتخاب ماده اولیه --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">واحد اندازه‌گیری <span class="text-danger">*</span></label>
                                <select name="UnitId" class="form-select" required>
                                    <option value="">-- انتخاب واحد --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">مقدار <span class="text-danger">*</span></label>
                                <input type="number" name="Quantity" class="form-control" step="0.001" min="0.001" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">قیمت واحد <span class="text-danger">*</span></label>
                                <input type="number" name="UnitPrice" class="form-control" step="0.01" min="0" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">قیمت کل</label>
                                <input type="number" name="TotalPrice" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">بچ (اختیاری)</label>
                                <select name="BatchId" class="form-select">
                                    <option value="">-- انتخاب بچ --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">توضیحات</label>
                                <textarea name="Notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i> ذخیره
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- مودال ویرایش آیتم -->
<div class="modal fade" id="editItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ویرایش آیتم</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <form id="editItemForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PiItemId" />
                <input type="hidden" name="PurchaseInvoiceId" value="@Model.PurchaseInvoiceId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ماده اولیه <span class="text-danger">*</span></label>
                                <select name="MaterialId" class="form-select" required>
                                    <option value="">-- انتخاب ماده اولیه --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">واحد اندازه‌گیری <span class="text-danger">*</span></label>
                                <select name="UnitId" class="form-select" required>
                                    <option value="">-- انتخاب واحد --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">مقدار <span class="text-danger">*</span></label>
                                <input type="number" name="Quantity" class="form-control" step="0.001" min="0.001" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">قیمت واحد <span class="text-danger">*</span></label>
                                <input type="number" name="UnitPrice" class="form-control" step="0.01" min="0" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">قیمت کل</label>
                                <input type="number" name="TotalPrice" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">بچ (اختیاری)</label>
                                <select name="BatchId" class="form-select">
                                    <option value="">-- انتخاب بچ --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">توضیحات</label>
                                <textarea name="Notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i> ذخیره تغییرات
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let materials = [];
            let units = [];
            let batches = [];

            // Load materials, units, and batches
            Promise.all([
                fetch('@Url.Action("GetMaterials")').then(r => r.json()),
                fetch('@Url.Action("GetUnits")').then(r => r.json()),
                fetch('@Url.Action("GetBatches")').then(r => r.json())
            ]).then(([materialsData, unitsData, batchesData]) => {
                materials = materialsData;
                units = unitsData;
                batches = batchesData;
                populateSelects();
            });

            function populateSelects() {
                const materialSelects = document.querySelectorAll('select[name="MaterialId"]');
                const unitSelects = document.querySelectorAll('select[name="UnitId"]');
                const batchSelects = document.querySelectorAll('select[name="BatchId"]');

                materialSelects.forEach(select => {
                    select.innerHTML = '<option value="">-- انتخاب ماده اولیه --</option>';
                    materials.forEach(material => {
                        select.innerHTML += `<option value="${material.value}">${material.text}</option>`;
                    });
                });

                unitSelects.forEach(select => {
                    select.innerHTML = '<option value="">-- انتخاب واحد --</option>';
                    units.forEach(unit => {
                        select.innerHTML += `<option value="${unit.value}">${unit.text}</option>`;
                    });
                });

                batchSelects.forEach(select => {
                    select.innerHTML = '<option value="">-- انتخاب بچ --</option>';
                    batches.forEach(batch => {
                        select.innerHTML += `<option value="${batch.value}">${batch.text}</option>`;
                    });
                });
            }

            // Calculate total price
            function calculateTotalPrice(form) {
                const quantity = parseFloat(form.querySelector('input[name="Quantity"]').value) || 0;
                const unitPrice = parseFloat(form.querySelector('input[name="UnitPrice"]').value) || 0;
                const totalPrice = quantity * unitPrice;
                form.querySelector('input[name="TotalPrice"]').value = totalPrice.toFixed(2);
            }

            // Calculate invoice totals
            function calculateInvoiceTotals() {
                const subtotal = parseFloat(document.getElementById('Subtotal').value) || 0;
                const taxAmount = parseFloat(document.getElementById('TaxAmount').value) || 0;
                const discountAmount = parseFloat(document.getElementById('DiscountAmount').value) || 0;
                const total = subtotal + taxAmount - discountAmount;
                document.getElementById('TotalAmount').value = total.toFixed(2);
            }

            // Add event listeners for price calculation
            document.querySelectorAll('input[name="Quantity"], input[name="UnitPrice"]').forEach(input => {
                input.addEventListener('input', function() {
                    calculateTotalPrice(this.closest('form'));
                });
            });

            // Add event listeners for invoice total calculation
            document.getElementById('TaxAmount').addEventListener('input', calculateInvoiceTotals);
            document.getElementById('DiscountAmount').addEventListener('input', calculateInvoiceTotals);

            // Add item form submission
            document.getElementById('addItemForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);

                fetch('@Url.Action("AddItem")', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('addItemModal')).hide();
                        showAlert(data.message, 'success');
                        location.reload(); // Reload to show updated items and total
                    } else {
                        showAlert(data.message, 'danger');
                    }
                })
                .catch(error => {
                    showAlert('خطا در ارسال درخواست', 'danger');
                });
            });

            // Edit item
            document.addEventListener('click', function(e) {
                if (e.target.closest('.edit-item-btn')) {
                    const itemId = e.target.closest('.edit-item-btn').getAttribute('data-item-id');

                    fetch(`@Url.Action("GetItem")?id=${itemId}`)
                    .then(response => response.json())
                    .then(data => {
                        const form = document.getElementById('editItemForm');
                        form.querySelector('input[name="PiItemId"]').value = data.piItemId;
                        form.querySelector('select[name="MaterialId"]').value = data.materialId;
                        form.querySelector('select[name="UnitId"]').value = data.unitId;
                        form.querySelector('input[name="Quantity"]').value = data.quantity;
                        form.querySelector('input[name="UnitPrice"]').value = data.unitPrice;
                        form.querySelector('input[name="TotalPrice"]').value = data.totalPrice;
                        form.querySelector('select[name="BatchId"]').value = data.batchId || '';
                        form.querySelector('textarea[name="Notes"]').value = data.notes || '';

                        new bootstrap.Modal(document.getElementById('editItemModal')).show();
                    });
                }
            });

            // Edit item form submission
            document.getElementById('editItemForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);

                fetch('@Url.Action("EditItem")', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('editItemModal')).hide();
                        showAlert(data.message, 'success');
                        location.reload(); // Reload to show updated items and total
                    } else {
                        showAlert(data.message, 'danger');
                    }
                })
                .catch(error => {
                    showAlert('خطا در ارسال درخواست', 'danger');
                });
            });

            // Delete item
            document.addEventListener('click', function(e) {
                if (e.target.closest('.delete-item-btn')) {
                    const itemId = e.target.closest('.delete-item-btn').getAttribute('data-item-id');

                    if (confirm('آیا از حذف این آیتم مطمئن هستید؟')) {
                        const formData = new FormData();
                        formData.append('id', itemId);
                        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                        fetch('@Url.Action("DeleteItem")', {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                showAlert(data.message, 'success');
                                location.reload(); // Reload to show updated items and total
                            } else {
                                showAlert(data.message, 'danger');
                            }
                        })
                        .catch(error => {
                            showAlert('خطا در ارسال درخواست', 'danger');
                        });
                    }
                }
            });

            function showAlert(message, type) {
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
                alertDiv.innerHTML = `
                    <p class="mb-0">${message}</p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.querySelector('.card-body').insertBefore(alertDiv, document.querySelector('.card-body').firstChild);

                setTimeout(() => {
                    alertDiv.remove();
                }, 5000);
            }

            // Auto-close alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}