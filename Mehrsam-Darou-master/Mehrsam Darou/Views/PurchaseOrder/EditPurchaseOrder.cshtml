@model Mehrsam_Darou.Models.PurchaseOrder

@{
    ViewData["Title"] = "ویرایش سفارش خرید";
    var items = ViewBag.PurchaseOrderItems as List<Mehrsam_Darou.Models.PurchaseOrderItem>;
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش سفارش خرید - @Model.PoNumber</h4>
                    <a href="@Url.Action("PurchaseOrderList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditPurchaseOrder" asp-route-id="@Model.PurchaseOrderId" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="PurchaseOrderId" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PoNumber" class="form-label">شماره سفارش خرید <span class="text-danger">*</span></label>
                                <input asp-for="PoNumber" class="form-control" readonly />
                                <span asp-validation-for="PoNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="SupplierId" class="form-label">تامین‌کننده <span class="text-danger">*</span></label>
                                <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                                    <option value="">-- انتخاب تامین‌کننده --</option>
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3" data-field="OrderDate">
                                <label class="form-label">تاریخ سفارش <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       data-persian-date="true"
                                       autocomplete="off"
                                       readonly
                                       placeholder="تاریخ سفارش" />
                                <input type="hidden" asp-for="OrderDate" class="persian-date-hidden" />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3" data-field="ExpectedDeliveryDate">
                                <label class="form-label">تاریخ تحویل مورد انتظار</label>
                                <input type="text"
                                       class="form-control"
                                       data-persian-date="true"
                                       autocomplete="off"
                                       readonly
                                       placeholder="تاریخ تحویل مورد انتظار" />
                                <input type="hidden" asp-for="ExpectedDeliveryDate" class="persian-date-hidden" />
                                <span asp-validation-for="ExpectedDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3" data-field="ActualDeliveryDate">
                                <label class="form-label">تاریخ تحویل واقعی</label>
                                <input type="text"
                                       class="form-control"
                                       data-persian-date="true"
                                       autocomplete="off"
                                       readonly
                                       placeholder="تاریخ تحویل واقعی" />
                                <input type="hidden" asp-for="ActualDeliveryDate" class="persian-date-hidden" />
                                <span asp-validation-for="ActualDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TotalAmount" class="form-label">مبلغ کل</label>
                                <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" readonly />
                                <span asp-validation-for="TotalAmount" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Currency" class="form-label">واحد پول</label>
                                <select asp-for="Currency" class="form-select">
                                    <option value="IRR">ریال (IRR)</option>
                                    <option value="USD">دلار آمریکا (USD)</option>
                                    <option value="EUR">یورو (EUR)</option>
                                </select>
                                <span asp-validation-for="Currency" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="پیش‌نویس">پیش‌نویس</option>
                                    <option value="ارسال شده">ارسال شده</option>
                                    <option value="تایید شده">تایید شده</option>
                                    <option value="دریافت جزئی">دریافت جزئی</option>
                                    <option value="دریافت شده">دریافت شده</option>
                                    <option value="لغو شده">لغو شده</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">یادداشت‌ها</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="یادداشت‌های اضافی در مورد سفارش خرید..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- آیتم‌های سفارش خرید -->
<div class="row mt-4">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0">آیتم‌های سفارش خرید</h5>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addItemModal">
                        <i class="bx bx-plus me-1"></i> افزودن آیتم
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover" id="itemsTable">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>ماده اولیه</th>
                                <th>مقدار</th>
                                <th>واحد</th>
                                <th>قیمت واحد</th>
                                <th>قیمت کل</th>
                                <th>دریافت شده</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (items != null && items.Any())
                            {
                                foreach (var item in items)
                                {
                                    <tr data-item-id="@item.PoItemId">
                                        <td>@item.Material?.MaterialName</td>
                                        <td>@item.Quantity.ToString("0.###")</td>
                                        <td>@item.Unit?.UnitName</td>
                                        <td>@item.UnitPrice.ToString("N0")</td>
                                        <td>@item.TotalPrice.ToString("N0")</td>
                                        <td>@(item.ReceivedQuantity?.ToString("0.###") ?? "0")</td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-soft-primary btn-sm edit-item-btn"
                                                        data-item-id="@item.PoItemId" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-danger btn-sm delete-item-btn"
                                                        data-item-id="@item.PoItemId" title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="noItemsRow">
                                    <td colspan="7" class="text-center py-4">
                                        <i class="bx bx-package text-muted fs-1"></i>
                                        <p class="mt-2">هیچ آیتمی برای این سفارش خرید ثبت نشده است.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مودال افزودن آیتم -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">افزودن آیتم جدید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <form id="addItemForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PurchaseOrderId" value="@Model.PurchaseOrderId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ماده اولیه <span class="text-danger">*</span></label>
                                <select name="MaterialId" class="form-select" required>
                                    <option value="">-- انتخاب ماده اولیه --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">واحد اندازه‌گیری <span class="text-danger">*</span></label>
                                <select name="UnitId" class="form-select" required>
                                    <option value="">-- انتخاب واحد --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">مقدار <span class="text-danger">*</span></label>
                                <input type="number" name="Quantity" class="form-control" step="0.001" min="0.001" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">قیمت واحد <span class="text-danger">*</span></label>
                                <input type="number" name="UnitPrice" class="form-control" step="0.01" min="0" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">قیمت کل</label>
                                <input type="number" name="TotalPrice" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea name="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i> ذخیره
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- مودال ویرایش آیتم -->
<div class="modal fade" id="editItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ویرایش آیتم</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <form id="editItemForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PoItemId" />
                <input type="hidden" name="PurchaseOrderId" value="@Model.PurchaseOrderId" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ماده اولیه <span class="text-danger">*</span></label>
                                <select name="MaterialId" class="form-select" required>
                                    <option value="">-- انتخاب ماده اولیه --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">واحد اندازه‌گیری <span class="text-danger">*</span></label>
                                <select name="UnitId" class="form-select" required>
                                    <option value="">-- انتخاب واحد --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">مقدار <span class="text-danger">*</span></label>
                                <input type="number" name="Quantity" class="form-control" step="0.001" min="0.001" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">قیمت واحد <span class="text-danger">*</span></label>
                                <input type="number" name="UnitPrice" class="form-control" step="0.01" min="0" required />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">قیمت کل</label>
                                <input type="number" name="TotalPrice" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea name="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="bx bx-save me-1"></i> ذخیره تغییرات
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let materials = [];
            let units = [];

            // Load materials and units
            Promise.all([
                fetch('@Url.Action("GetMaterials")').then(r => r.json()),
                fetch('@Url.Action("GetUnits")').then(r => r.json())
            ]).then(([materialsData, unitsData]) => {
                materials = materialsData;
                units = unitsData;
                populateSelects();
            }).catch(error => {
                console.error('Error loading data:', error);
                showAlert('خطا در بارگذاری اطلاعات', 'danger');
            });

            function populateSelects() {
                const materialSelects = document.querySelectorAll('select[name="MaterialId"]');
                const unitSelects = document.querySelectorAll('select[name="UnitId"]');

                materialSelects.forEach(select => {
                    select.innerHTML = '<option value="">-- انتخاب ماده اولیه --</option>';
                    materials.forEach(material => {
                        select.innerHTML += `<option value="${material.value}">${material.text}</option>`;
                    });
                });

                unitSelects.forEach(select => {
                    select.innerHTML = '<option value="">-- انتخاب واحد --</option>';
                    units.forEach(unit => {
                        select.innerHTML += `<option value="${unit.value}">${unit.text}</option>`;
                    });
                });
            }

            // Calculate total price
            function calculateTotalPrice(form) {
                const quantity = parseFloat(form.querySelector('input[name="Quantity"]').value) || 0;
                const unitPrice = parseFloat(form.querySelector('input[name="UnitPrice"]').value) || 0;
                const totalPrice = quantity * unitPrice;
                form.querySelector('input[name="TotalPrice"]').value = totalPrice.toFixed(2);
            }

            // Add event listeners for price calculation
            document.addEventListener('input', function(e) {
                if (e.target.matches('input[name="Quantity"], input[name="UnitPrice"]')) {
                    calculateTotalPrice(e.target.closest('form'));
                }
            });

            // Reset form when modal is hidden
            document.getElementById('addItemModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('addItemForm').reset();
            });

            document.getElementById('editItemModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('editItemForm').reset();
            });

            // Add item form submission
            document.getElementById('addItemForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);

                // Show loading state
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i> در حال ذخیره...';
                submitBtn.disabled = true;

                fetch('@Url.Action("AddItem")', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('addItemModal')).hide();
                        showAlert(data.message, 'success');
                        setTimeout(() => location.reload(), 1000); // Reload to show updated items and total
                    } else {
                        showAlert(data.message, 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showAlert('خطا در ارسال درخواست', 'danger');
                })
                .finally(() => {
                    // Reset button state
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                });
            });

            // Edit item
            document.addEventListener('click', function(e) {
                if (e.target.closest('.edit-item-btn')) {
                    const itemId = e.target.closest('.edit-item-btn').getAttribute('data-item-id');

                    fetch(`@Url.Action("GetItem")?id=${itemId}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return response.json();
                    })
                    .then(data => {
                        const form = document.getElementById('editItemForm');
                        form.querySelector('input[name="PoItemId"]').value = data.poItemId;
                        form.querySelector('select[name="MaterialId"]').value = data.materialId;
                        form.querySelector('select[name="UnitId"]').value = data.unitId;
                        form.querySelector('input[name="Quantity"]').value = data.quantity;
                        form.querySelector('input[name="UnitPrice"]').value = data.unitPrice;
                        form.querySelector('input[name="TotalPrice"]').value = data.totalPrice;
                        form.querySelector('textarea[name="Notes"]').value = data.notes || '';

                        new bootstrap.Modal(document.getElementById('editItemModal')).show();
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showAlert('خطا در بارگذاری اطلاعات آیتم', 'danger');
                    });
                }
            });

            // Edit item form submission
            document.getElementById('editItemForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);

                // Show loading state
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i> در حال ذخیره...';
                submitBtn.disabled = true;

                fetch('@Url.Action("EditItem")', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        bootstrap.Modal.getInstance(document.getElementById('editItemModal')).hide();
                        showAlert(data.message, 'success');
                        setTimeout(() => location.reload(), 1000); // Reload to show updated items and total
                    } else {
                        showAlert(data.message, 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showAlert('خطا در ارسال درخواست', 'danger');
                })
                .finally(() => {
                    // Reset button state
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                });
            });

            // Delete item
            document.addEventListener('click', function(e) {
                if (e.target.closest('.delete-item-btn')) {
                    const itemId = e.target.closest('.delete-item-btn').getAttribute('data-item-id');

                    if (confirm('آیا از حذف این آیتم مطمئن هستید؟')) {
                        const formData = new FormData();
                        formData.append('id', itemId);
                        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                        fetch('@Url.Action("DeleteItem")', {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                showAlert(data.message, 'success');
                                setTimeout(() => location.reload(), 1000); // Reload to show updated items and total
                            } else {
                                showAlert(data.message, 'danger');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showAlert('خطا در ارسال درخواست', 'danger');
                        });
                    }
                }
            });

            function showAlert(message, type) {
                // Remove existing alerts first
                const existingAlerts = document.querySelectorAll('.alert:not([data-temp])');
                existingAlerts.forEach(alert => {
                    if (alert.textContent.includes('با موفقیت انجام شد') || alert.textContent.includes('خطا')) {
                        return; // Keep TempData alerts
                    }
                    alert.remove();
                });

                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
                alertDiv.setAttribute('data-temp', 'true');
                alertDiv.innerHTML = `
                    <p class="mb-0">${message}</p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;

                const cardBody = document.querySelector('.card-body');
                cardBody.insertBefore(alertDiv, cardBody.firstChild);

                // Auto-remove after 5 seconds
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, 5000);
            }

            // Auto-close TempData alerts after 5 seconds
            setTimeout(function () {
                const alerts = document.querySelectorAll('.alert:not([data-temp])');
                alerts.forEach(function (alert) {
                    if (bootstrap.Alert.getOrCreateInstance) {
                        const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                        bsAlert.close();
                    } else {
                        alert.style.display = 'none';
                    }
                });
            }, 5000);
        });
    </script>
}