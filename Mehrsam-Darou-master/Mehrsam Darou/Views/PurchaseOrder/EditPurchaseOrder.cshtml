@model Mehrsam_Darou.Models.PurchaseOrder

@{
    ViewData["Title"] = "ویرایش سفارش خرید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش سفارش خرید</h4>
                    <a href="@Url.Action("PurchaseOrderList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditPurchaseOrder">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="PurchaseOrderId" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="PoNumber" class="form-label">شماره سفارش خرید <span class="text-danger">*</span></label>
                                <input asp-for="PoNumber" class="form-control" readonly />
                                <span asp-validation-for="PoNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="SupplierId" class="form-label">تامین‌کننده <span class="text-danger">*</span></label>
                                <select asp-for="SupplierId" class="form-select">
                                    <option value="">-- انتخاب تامین‌کننده --</option>
                                    @foreach (var supplier in ViewBag.Suppliers as List<Mehrsam_Darou.Models.Supplier>)
                                    {
                                        <option value="@supplier.SupplierId" selected="@(supplier.SupplierId == Model.SupplierId)">@supplier.SupplierName</option>
                                    }
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="OrderDate" class="form-label">تاریخ سفارش <span class="text-danger">*</span></label>
                                <input asp-for="OrderDate" type="date" class="form-control" />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ExpectedDeliveryDate" class="form-label">تاریخ تحویل مورد انتظار</label>
                                <input asp-for="ExpectedDeliveryDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ActualDeliveryDate" class="form-label">تاریخ تحویل واقعی</label>
                                <input asp-for="ActualDeliveryDate" type="date" class="form-control" />
                                <span asp-validation-for="ActualDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TotalAmount" class="form-label">مبلغ کل</label>
                                <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="TotalAmount" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Currency" class="form-label">واحد پول</label>
                                <select asp-for="Currency" class="form-select">
                                    <option value="IRR">ریال (IRR)</option>
                                    <option value="USD">دلار آمریکا (USD)</option>
                                    <option value="EUR">یورو (EUR)</option>
                                </select>
                                <span asp-validation-for="Currency" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="پیش‌نویس">پیش‌نویس</option>
                                    <option value="ارسال شده">ارسال شده</option>
                                    <option value="تایید شده">تایید شده</option>
                                    <option value="دریافت جزئی">دریافت جزئی</option>
                                    <option value="دریافت شده">دریافت شده</option>
                                    <option value="لغو شده">لغو شده</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label">یادداشت‌ها</label>
                                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="یادداشت‌های اضافی در مورد سفارش خرید..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}