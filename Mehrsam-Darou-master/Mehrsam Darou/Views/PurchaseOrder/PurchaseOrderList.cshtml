@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.PurchaseOrder>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست سفارشات خرید";
}

<h2 class="mb-4">لیست سفارشات خرید</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="PurchaseOrderList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddPurchaseOrder")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> سفارش خرید جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>شماره سفارش</th>
                                <th>تامین‌کننده</th>
                                <th>تاریخ سفارش</th>
                                <th>تاریخ تحویل مورد انتظار</th>
                                <th>تاریخ تحویل واقعی</th>
                                <th>مبلغ کل</th>
                                <th>وضعیت</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var purchaseOrder in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:cart-2-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@purchaseOrder.PoNumber</h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (purchaseOrder.Supplier != null)
                                            {
                                                <span class="text-primary fw-medium">@purchaseOrder.Supplier.SupplierName</span>
                                                if (!string.IsNullOrEmpty(purchaseOrder.Supplier.ContactPerson))
                                                {
                                                    <br>

                                                    <small class="text-muted">@purchaseOrder.Supplier.ContactPerson</small>
                                                }
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @{
                                                    var orderDateTime = purchaseOrder.OrderDate.ToDateTime(TimeOnly.MinValue);
                                                }
                                                @pc.GetYear(orderDateTime)/@pc.GetMonth(orderDateTime).ToString("00")/@pc.GetDayOfMonth(orderDateTime).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            @if (purchaseOrder.ExpectedDeliveryDate.HasValue)
                                            {
                                                <small class="text-muted">
                                                    @{
                                                        var expectedDateTime = purchaseOrder.ExpectedDeliveryDate.Value.ToDateTime(TimeOnly.MinValue);
                                                    }
                                                    @pc.GetYear(expectedDateTime)/@pc.GetMonth(expectedDateTime).ToString("00")/@pc.GetDayOfMonth(expectedDateTime).ToString("00")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (purchaseOrder.ActualDeliveryDate.HasValue)
                                            {
                                                <small class="text-success">
                                                    @{
                                                        var actualDateTime = purchaseOrder.ActualDeliveryDate.Value.ToDateTime(TimeOnly.MinValue);
                                                    }
                                                    @pc.GetYear(actualDateTime)/@pc.GetMonth(actualDateTime).ToString("00")/@pc.GetDayOfMonth(actualDateTime).ToString("00")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (purchaseOrder.TotalAmount.HasValue)
                                            {
                                                <span class="text-success fw-medium">
                                                    @purchaseOrder.TotalAmount.Value.ToString("N0")
                                                    @(purchaseOrder.Currency == "IRR" ? "ریال" : purchaseOrder.Currency)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                string badgeClass = purchaseOrder.Status switch
                                                {
                                                    "پیش‌نویس" => "bg-secondary",
                                                    "ارسال شده" => "bg-info",
                                                    "تایید شده" => "bg-primary",
                                                    "دریافت جزئی" => "bg-warning",
                                                    "دریافت شده" => "bg-success",
                                                    "لغو شده" => "bg-danger",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@purchaseOrder.Status</span>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @pc.GetYear(purchaseOrder.CreatedDate)/@pc.GetMonth(purchaseOrder.CreatedDate).ToString("00")/@pc.GetDayOfMonth(purchaseOrder.CreatedDate).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditPurchaseOrder", new { id = purchaseOrder.PurchaseOrderId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showPurchaseOrderDetails('@purchaseOrder.PurchaseOrderId')"
                                                        title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@purchaseOrder.PurchaseOrderId"
                                                        data-bs-name="@purchaseOrder.PoNumber"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <i class="bx bx-cart text-muted fs-1"></i>
                                        <p class="mt-2">هیچ سفارش خریدی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("PurchaseOrderList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("PurchaseOrderList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("PurchaseOrderList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف سفارش خرید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این سفارش خرید مطمئن هستید؟</p>
                <p id="purchaseOrderNumberToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> در صورت وجود فاکتور یا آیتم، امکان حذف وجود ندارد.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="purchaseOrderIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Purchase Order Details Modal -->
<div class="modal fade" id="purchaseOrderDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات سفارش خرید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="purchaseOrderDetailsContent">
                <!-- Purchase order details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var purchaseOrderId = button.getAttribute('data-bs-id');
                var purchaseOrderNumber = button.getAttribute('data-bs-name');

                document.getElementById('purchaseOrderNumberToDelete').textContent = purchaseOrderNumber;
                document.getElementById('purchaseOrderIdToDelete').value = purchaseOrderId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showPurchaseOrderDetails(purchaseOrderId) {
            // This would typically load purchase order details via AJAX
            // For now, just show a placeholder
            var modal = new bootstrap.Modal(document.getElementById('purchaseOrderDetailsModal'));
            document.getElementById('purchaseOrderDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Simulate loading details
            setTimeout(function() {
                document.getElementById('purchaseOrderDetailsContent').innerHTML =
                    '<p>جزئیات کامل سفارش خرید اینجا نمایش داده خواهد شد.</p>' +
                    '<p>شامل آیتم‌ها، فاکتورها و ...</p>';
            }, 1000);
        }
    </script>
}