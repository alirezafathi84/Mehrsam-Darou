@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.QaAudit>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست ممیزی‌های تضمین کیفیت";
}

<h2 class="mb-4">لیست ممیزی‌های تضمین کیفیت</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="QAAuditList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddQAAudit")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> ممیزی جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>کد ممیزی</th>
                                <th>عنوان ممیزی</th>
                                <th>نوع</th>
                                <th>واحد مورد ممیزی</th>
                                <th>ممیز ارشد</th>
                                <th>وضعیت</th>
                                <th>اولویت</th>
                                <th>امتیاز کلی</th>
                                <th>تاریخ شروع</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var audit in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary">@audit.AuditCode</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:clipboard-check-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@audit.AuditTitle</h6>
                                                    @if (!string.IsNullOrEmpty(audit.AuditScope))
                                                    {
                                                        <small class="text-muted">@audit.AuditScope.Substring(0, Math.Min(50, audit.AuditScope.Length))...</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(audit.AuditType))
                                            {
                                                <span class="badge bg-info-subtle text-info">@audit.AuditType</span>
                                            }
                                        </td>
                                        <td>@audit.AuditedDepartment</td>
                                        <td>@audit.LeadAuditor</td>
                                        <td>
                                            @switch (audit.AuditStatus)
                                            {
                                                case "برنامه‌ریزی شده":
                                                    <span class="badge bg-warning">@audit.AuditStatus</span>
                                                    break;
                                                case "در حال اجرا":
                                                    <span class="badge bg-primary">@audit.AuditStatus</span>
                                                    break;
                                                case "تکمیل شده":
                                                    <span class="badge bg-success">@audit.AuditStatus</span>
                                                    break;
                                                case "لغو شده":
                                                    <span class="badge bg-danger">@audit.AuditStatus</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@audit.AuditStatus</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (audit.AuditPriority.HasValue)
                                            {
                                                @switch (audit.AuditPriority.Value)
                                                {
                                                    case 1:
                                                        <span class="badge bg-danger">خیلی بالا</span>
                                                        break;
                                                    case 2:
                                                        <span class="badge bg-warning">بالا</span>
                                                        break;
                                                    case 3:
                                                        <span class="badge bg-primary">متوسط</span>
                                                        break;
                                                    case 4:
                                                        <span class="badge bg-info">پایین</span>
                                                        break;
                                                    case 5:
                                                        <span class="badge bg-success">خیلی پایین</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@audit.AuditPriority</span>
                                                        break;
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(audit.OverallRating))
                                            {
                                                @switch (audit.OverallRating)
                                                {
                                                    case "عالی":
                                                        <span class="badge bg-success">@audit.OverallRating</span>
                                                        break;
                                                    case "خوب":
                                                        <span class="badge bg-info">@audit.OverallRating</span>
                                                        break;
                                                    case "قابل قبول":
                                                        <span class="badge bg-warning">@audit.OverallRating</span>
                                                        break;
                                                    case "نیاز به بهبود":
                                                        <span class="badge bg-danger">@audit.OverallRating</span>
                                                        break;
                                                    case "غیرقابل قبول":
                                                        <span class="badge bg-dark">@audit.OverallRating</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@audit.OverallRating</span>
                                                        break;
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (audit.ActualStartDate.HasValue)
                                            {
                                                <small class="text-muted">
                                                    @pc.GetYear(audit.ActualStartDate.Value.ToDateTime(TimeOnly.MinValue))/@pc.GetMonth(audit.ActualStartDate.Value.ToDateTime(TimeOnly.MinValue)).ToString("00")/@pc.GetDayOfMonth(audit.ActualStartDate.Value.ToDateTime(TimeOnly.MinValue)).ToString("00")
                                                </small>
                                            }
                                            else if (audit.PlannedStartDate.HasValue)
                                            {
                                                <small class="text-warning">
                                                    برنامه‌ریزی: @pc.GetYear(audit.PlannedStartDate.Value.ToDateTime(TimeOnly.MinValue))/@pc.GetMonth(audit.PlannedStartDate.Value.ToDateTime(TimeOnly.MinValue)).ToString("00")/@pc.GetDayOfMonth(audit.PlannedStartDate.Value.ToDateTime(TimeOnly.MinValue)).ToString("00")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @pc.GetYear(audit.CreatedDate)/@pc.GetMonth(audit.CreatedDate).ToString("00")/@pc.GetDayOfMonth(audit.CreatedDate).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditQAAudit", new { id = audit.AuditId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showAuditDetails('@audit.AuditId')"
                                                        title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@audit.AuditId"
                                                        data-bs-name="@audit.AuditTitle"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center py-4">
                                        <i class="bx bx-clipboard text-muted fs-1"></i>
                                        <p class="mt-2">هیچ ممیزی‌ای یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("QAAuditList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("QAAuditList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("QAAuditList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف ممیزی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این ممیزی مطمئن هستید؟</p>
                <p id="auditNameToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل قابل بازگشت نیست.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="auditIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Audit Details Modal -->
<div class="modal fade" id="auditDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات ممیزی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="auditDetailsContent">
                <!-- Audit details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var auditId = button.getAttribute('data-bs-id');
                var auditName = button.getAttribute('data-bs-name');

                document.getElementById('auditNameToDelete').textContent = auditName;
                document.getElementById('auditIdToDelete').value = auditId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showAuditDetails(auditId) {
            var modal = new bootstrap.Modal(document.getElementById('auditDetailsModal'));
            document.getElementById('auditDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Simulate loading details
            setTimeout(function() {
                document.getElementById('auditDetailsContent').innerHTML =
                    '<p>جزئیات کامل ممیزی اینجا نمایش داده خواهد شد.</p>' +
                    '<p>شامل گزارش‌ها، یافته‌ها، اقدامات اصلاحی و ...</p>';
            }, 1000);
        }
    </script>
}