@model Mehrsam_Darou.Models.QaStandard

@{
    ViewData["Title"] = "افزودن استاندارد جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن استاندارد جدید</h4>
                    <a href="@Url.Action("QAStandardList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddQAStandard">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Basic Information -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">اطلاعات پایه</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="StandardCode" class="form-label">کد استاندارد <span class="text-danger">*</span></label>
                                        <input asp-for="StandardCode" class="form-control" />
                                        <span asp-validation-for="StandardCode" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="StandardName" class="form-label">نام استاندارد <span class="text-danger">*</span></label>
                                        <input asp-for="StandardName" class="form-control" />
                                        <span asp-validation-for="StandardName" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="StandardType" class="form-label">نوع استاندارد</label>
                                        <select asp-for="StandardType" class="form-select">
                                            <option value="">-- انتخاب نوع استاندارد --</option>
                                            <option value="استاندارد ملی">استاندارد ملی</option>
                                            <option value="استاندارد بین‌المللی">استاندارد بین‌المللی</option>
                                            <option value="مشخصات">مشخصات</option>
                                            <option value="روش">روش</option>
                                            <option value="راهنما">راهنما</option>
                                            <option value="سایر">سایر</option>
                                        </select>
                                        <span asp-validation-for="StandardType" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="StandardCategory" class="form-label">دسته‌بندی استاندارد</label>
                                        <select asp-for="StandardCategory" class="form-select">
                                            <option value="">-- انتخاب دسته‌بندی --</option>
                                            <option value="سیستم مدیریت کیفیت">سیستم مدیریت کیفیت</option>
                                            <option value="کنترل کیفیت">کنترل کیفیت</option>
                                            <option value="تضمین کیفیت">تضمین کیفیت</option>
                                            <option value="تولید">تولید</option>
                                            <option value="انبارداری">انبارداری</option>
                                            <option value="توزیع">توزیع</option>
                                            <option value="تحقیق و توسعه">تحقیق و توسعه</option>
                                            <option value="ایمنی">ایمنی</option>
                                            <option value="محیط زیست">محیط زیست</option>
                                            <option value="مدیریت ریسک">مدیریت ریسک</option>
                                            <option value="سایر">سایر</option>
                                        </select>
                                        <span asp-validation-for="StandardCategory" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="IssuingOrganization" class="form-label">سازمان صادرکننده</label>
                                        <input asp-for="IssuingOrganization" class="form-control" />
                                        <span asp-validation-for="IssuingOrganization" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="IssuingCountry" class="form-label">کشور صادرکننده</label>
                                        <input asp-for="IssuingCountry" class="form-control" />
                                        <span asp-validation-for="IssuingCountry" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Version" class="form-label">نسخه</label>
                                        <input asp-for="Version" class="form-control" />
                                        <span asp-validation-for="Version" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Status" class="form-label">وضعیت</label>
                                        <select asp-for="Status" class="form-select">
                                            <option value="">-- انتخاب وضعیت --</option>
                                            <option value="پیش‌نویس">پیش‌نویس</option>
                                            <option value="منتشر شده">منتشر شده</option>
                                            <option value="مؤثر" selected>مؤثر</option>
                                            <option value="در حال بازنگری">در حال بازنگری</option>
                                            <option value="منسوخ شده">منسوخ شده</option>
                                        </select>
                                        <span asp-validation-for="Status" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label asp-for="Description" class="form-label">توضیحات</label>
                                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Description" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Compliance Information -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">اطلاعات انطباق</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ComplianceLevel" class="form-label">سطح انطباق</label>
                                        <select asp-for="ComplianceLevel" class="form-select">
                                            <option value="">-- انتخاب سطح انطباق --</option>
                                            <option value="الزامی">الزامی</option>
                                            <option value="توصیه شده">توصیه شده</option>
                                            <option value="اختیاری">اختیاری</option>
                                        </select>
                                        <span asp-validation-for="ComplianceLevel" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="PriorityLevel" class="form-label">سطح اولویت</label>
                                        <select asp-for="PriorityLevel" class="form-select">
                                            <option value="1">خیلی بالا</option>
                                            <option value="2">بالا</option>
                                            <option value="3" selected>متوسط</option>
                                            <option value="4">پایین</option>
                                            <option value="5">خیلی پایین</option>
                                        </select>
                                        <span asp-validation-for="PriorityLevel" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="RiskLevel" class="form-label">سطح ریسک</label>
                                        <select asp-for="RiskLevel" class="form-select">
                                            <option value="">-- انتخاب سطح ریسک --</option>
                                            <option value="بحرانی">بحرانی</option>
                                            <option value="بالا">بالا</option>
                                            <option value="متوسط">متوسط</option>
                                            <option value="پایین">پایین</option>
                                            <option value="ناچیز">ناچیز</option>
                                        </select>
                                        <span asp-validation-for="RiskLevel" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <div class="form-check mt-4">
                                            <input name="IsMandatory" type="checkbox" class="form-check-input" value="true" @(Model.IsMandatory == true ? "checked" : "") />
                                            <input name="IsMandatory" type="hidden" value="false" />
                                            <label class="form-check-label">
                                                الزامی
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dates Information -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">اطلاعات تاریخ</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="PublicationDate" class="form-label">تاریخ انتشار</label>
                                        <input asp-for="PublicationDate" type="date" class="form-control" />
                                        <span asp-validation-for="PublicationDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="EffectiveDate" class="form-label">تاریخ اجرا</label>
                                        <input asp-for="EffectiveDate" type="date" class="form-control" />
                                        <span asp-validation-for="EffectiveDate" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ReviewDate" class="form-label">تاریخ بازنگری</label>
                                        <input asp-for="ReviewDate" type="date" class="form-control" />
                                        <span asp-validation-for="ReviewDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="NextReviewDate" class="form-label">تاریخ بازنگری بعدی</label>
                                        <input asp-for="NextReviewDate" type="date" class="form-control" />
                                        <span asp-validation-for="NextReviewDate" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="AuditFrequencyMonths" class="form-label">فواصل ممیزی (ماه)</label>
                                        <input asp-for="AuditFrequencyMonths" type="number" class="form-control" />
                                        <span asp-validation-for="AuditFrequencyMonths" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Applicability -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">دامنه کاربرد</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label asp-for="Scope" class="form-label">دامنه</label>
                                        <textarea asp-for="Scope" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Scope" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ApplicableProducts" class="form-label">محصولات قابل اجرا</label>
                                        <textarea asp-for="ApplicableProducts" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="ApplicableProducts" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ApplicableProcesses" class="form-label">فرآیندهای قابل اجرا</label>
                                        <textarea asp-for="ApplicableProcesses" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="ApplicableProcesses" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Responsibility Information -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">اطلاعات مسئولیت</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ResponsibleDepartment" class="form-label">واحد مسئول</label>
                                        <input asp-for="ResponsibleDepartment" class="form-control" />
                                        <span asp-validation-for="ResponsibleDepartment" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ResponsiblePerson" class="form-label">شخص مسئول</label>
                                        <input asp-for="ResponsiblePerson" class="form-control" />
                                        <span asp-validation-for="ResponsiblePerson" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ContactEmail" class="form-label">ایمیل تماس</label>
                                        <input asp-for="ContactEmail" type="email" class="form-control" />
                                        <span asp-validation-for="ContactEmail" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ContactPhone" class="form-label">تلفن تماس</label>
                                        <input asp-for="ContactPhone" class="form-control" />
                                        <span asp-validation-for="ContactPhone" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Documentation -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">مستندات</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="DocumentPath" class="form-label">مسیر سند</label>
                                        <input asp-for="DocumentPath" class="form-control" />
                                        <span asp-validation-for="DocumentPath" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ExternalLink" class="form-label">لینک خارجی</label>
                                        <input asp-for="ExternalLink" type="url" class="form-control" />
                                        <span asp-validation-for="ExternalLink" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label asp-for="Tags" class="form-label">برچسب‌ها</label>
                                        <input asp-for="Tags" class="form-control" placeholder="برچسب‌ها را با کاما جدا کنید" />
                                        <span asp-validation-for="Tags" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cost Information -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">اطلاعات هزینه</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="ImplementationCost" class="form-label">هزینه پیاده‌سازی</label>
                                        <input asp-for="ImplementationCost" type="number" step="0.01" class="form-control" />
                                        <span asp-validation-for="ImplementationCost" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="MaintenanceCost" class="form-label">هزینه نگهداری</label>
                                        <input asp-for="MaintenanceCost" type="number" step="0.01" class="form-control" />
                                        <span asp-validation-for="MaintenanceCost" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="Currency" class="form-label">واحد پول</label>
                                        <select asp-for="Currency" class="form-select">
                                            <option value="IRR" selected>ریال</option>
                                            <option value="USD">دلار آمریکا</option>
                                            <option value="EUR">یورو</option>
                                        </select>
                                        <span asp-validation-for="Currency" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Notes -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">یادداشت‌ها</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label asp-for="Notes" class="form-label">یادداشت‌ها</label>
                                        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                                        <span asp-validation-for="Notes" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="IsActive" class="form-label">وضعیت</label>
                                        <select asp-for="IsActive" class="form-select">
                                            <option value="true" selected>فعال</option>
                                            <option value="false">غیرفعال</option>
                                        </select>
                                        <span asp-validation-for="IsActive" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                        <a href="@Url.Action("QAStandardList")" class="btn btn-secondary ms-2">
                            <i class="bx bx-x me-1"></i> انصراف
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}