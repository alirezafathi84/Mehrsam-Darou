@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.QcTest>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست آزمایشات کنترل کیفیت";
}

<h2 class="mb-4">لیست آزمایشات کنترل کیفیت</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="QCTestList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddQCTest")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> آزمایش جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>کد آزمایش</th>
                                <th>نام آزمایش</th>
                                <th>نوع</th>
                                <th>دسته‌بندی</th>
                                <th>روش آزمایش</th>
                                <th>وضعیت اعتبارسنجی</th>
                                <th>اولویت</th>
                                <th>مدت زمان</th>
                                <th>واحد مسئول</th>
                                <th>تاریخ ایجاد</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var test in Model)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary">@test.TestCode</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:test-tube-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@test.TestName</h6>
                                                    @if (!string.IsNullOrEmpty(test.StandardReference))
                                                    {
                                                        <small class="text-muted">مرجع: @test.StandardReference</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(test.TestType))
                                            {
                                                @switch (test.TestType)
                                                {
                                                    case "میکروبیولوژیکی":
                                                        <span class="badge bg-danger-subtle text-danger">@test.TestType</span>
                                                        break;
                                                    case "شیمیایی":
                                                        <span class="badge bg-warning-subtle text-warning">@test.TestType</span>
                                                        break;
                                                    case "فیزیکی":
                                                        <span class="badge bg-info-subtle text-info">@test.TestType</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary-subtle text-secondary">@test.TestType</span>
                                                        break;
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(test.TestCategory))
                                            {
                                                <span class="badge bg-success-subtle text-success">@test.TestCategory</span>
                                            }
                                        </td>
                                        <td>@test.TestMethod</td>
                                        <td>
                                            @switch (test.ValidationStatus)
                                            {
                                                case "معتبر":
                                                    <span class="badge bg-success">@test.ValidationStatus</span>
                                                    break;
                                                case "در حال انجام":
                                                    <span class="badge bg-warning">@test.ValidationStatus</span>
                                                    break;
                                                case "منقضی":
                                                    <span class="badge bg-danger">@test.ValidationStatus</span>
                                                    break;
                                                case "نیاز به اعتبارسنجی":
                                                    <span class="badge bg-info">@test.ValidationStatus</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@test.ValidationStatus</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (test.PriorityLevel.HasValue)
                                            {
                                                @switch (test.PriorityLevel.Value)
                                                {
                                                    case 1:
                                                        <span class="badge bg-danger">خیلی بالا</span>
                                                        break;
                                                    case 2:
                                                        <span class="badge bg-warning">بالا</span>
                                                        break;
                                                    case 3:
                                                        <span class="badge bg-primary">متوسط</span>
                                                        break;
                                                    case 4:
                                                        <span class="badge bg-info">پایین</span>
                                                        break;
                                                    case 5:
                                                        <span class="badge bg-success">خیلی پایین</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@test.PriorityLevel</span>
                                                        break;
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (test.TestDurationMinutes.HasValue)
                                            {
                                                var hours = test.TestDurationMinutes.Value / 60;
                                                var minutes = test.TestDurationMinutes.Value % 60;
                                                if (hours > 0)
                                                {
                                                    <span class="text-primary">@hours س @minutes د</span>
                                                }
                                                else
                                                {
                                                    <span class="text-primary">@minutes دقیقه</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>@test.ResponsibleDepartment</td>
                                        <td>
                                            <small class="text-muted">
                                                @pc.GetYear(test.CreatedDate)/@pc.GetMonth(test.CreatedDate).ToString("00")/@pc.GetDayOfMonth(test.CreatedDate).ToString("00")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditQCTest", new { id = test.TestId })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showTestDetails('@test.TestId')"
                                                        title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-success btn-sm"
                                                        onclick="copyTest('@test.TestId')"
                                                        title="کپی آزمایش">
                                                    <iconify-icon icon="solar:copy-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@test.TestId"
                                                        data-bs-name="@test.TestName"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center py-4">
                                        <i class="bx bx-test-tube text-muted fs-1"></i>
                                        <p class="mt-2">هیچ آزمایشی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("QCTestList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("QCTestList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("QCTestList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف آزمایش</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این آزمایش مطمئن هستید؟</p>
                <p id="testNameToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> در صورت وجود تست‌های بچ مرتبط، امکان حذف وجود ندارد.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="testIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Test Details Modal -->
<div class="modal fade" id="testDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات آزمایش</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="testDetailsContent">
                <!-- Test details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var testId = button.getAttribute('data-bs-id');
                var testName = button.getAttribute('data-bs-name');

                document.getElementById('testNameToDelete').textContent = testName;
                document.getElementById('testIdToDelete').value = testId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showTestDetails(testId) {
            var modal = new bootstrap.Modal(document.getElementById('testDetailsModal'));
            document.getElementById('testDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Simulate loading details
            setTimeout(function() {
                document.getElementById('testDetailsContent').innerHTML =
                    '<p>جزئیات کامل آزمایش اینجا نمایش داده خواهد شد.</p>' +
                    '<p>شامل روش انجام، تجهیزات، معرف‌ها، معیارهای پذیرش و ...</p>';
            }, 1000);
        }

        function copyTest(testId) {
            if (confirm('آیا می‌خواهید این آزمایش را کپی کنید؟')) {
                // Redirect to copy action
                window.location.href = '@Url.Action("CopyQCTest", "QCTest")/' + testId;
            }
        }
    </script>
}