@model Mehrsam_Darou.Models.ResearchProject

@{
    ViewData["Title"] = "افزودن پروژه تحقیقاتی جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن پروژه تحقیقاتی جدید</h4>
                    <a href="@Url.Action("ResearchProjectList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddResearchProject" id="researchProjectForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Hidden fields to avoid validation issues -->
                    <input type="hidden" asp-for="ProjectId" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="IsActive" />

                    <!-- Basic Information -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">اطلاعات پایه</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProjectCode" class="form-label">کد پروژه <span class="text-danger">*</span></label>
                                        <input asp-for="ProjectCode" class="form-control" required />
                                        <span asp-validation-for="ProjectCode" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProjectTitle" class="form-label">عنوان پروژه <span class="text-danger">*</span></label>
                                        <input asp-for="ProjectTitle" class="form-control" required />
                                        <span asp-validation-for="ProjectTitle" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProjectType" class="form-label">نوع پروژه</label>
                                        <select asp-for="ProjectType" class="form-select">
                                            <option value="">-- انتخاب نوع پروژه --</option>
                                            <option value="تحقیق و توسعه">تحقیق و توسعه</option>
                                            <option value="تحقیق کاربردی">تحقیق کاربردی</option>
                                            <option value="تحقیق بنیادی">تحقیق بنیادی</option>
                                            <option value="توسعه فرآیند">توسعه فرآیند</option>
                                            <option value="توسعه محصول">توسعه محصول</option>
                                            <option value="مطالعه امکان‌سنجی">مطالعه امکان‌سنجی</option>
                                            <option value="پایلوت">پایلوت</option>
                                            <option value="سایر">سایر</option>
                                        </select>
                                        <span asp-validation-for="ProjectType" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProjectCategory" class="form-label">دسته‌بندی پروژه</label>
                                        <select asp-for="ProjectCategory" class="form-select">
                                            <option value="">-- انتخاب دسته‌بندی --</option>
                                            <option value="داروسازی">داروسازی</option>
                                            <option value="بیوتکنولوژی">بیوتکنولوژی</option>
                                            <option value="شیمی دارویی">شیمی دارویی</option>
                                            <option value="فرمولاسیون">فرمولاسیون</option>
                                            <option value="تحلیلی">تحلیلی</option>
                                            <option value="کیفیت">کیفیت</option>
                                            <option value="فرآیند">فرآیند</option>
                                            <option value="سایر">سایر</option>
                                        </select>
                                        <span asp-validation-for="ProjectCategory" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProjectStatus" class="form-label">وضعیت پروژه</label>
                                        <select asp-for="ProjectStatus" class="form-select">
                                            <option value="طرح‌ریزی">طرح‌ریزی</option>
                                            <option value="تایید شده">تایید شده</option>
                                            <option value="در حال اجرا">در حال اجرا</option>
                                            <option value="متوقف شده">متوقف شده</option>
                                            <option value="تکمیل شده">تکمیل شده</option>
                                            <option value="لغو شده">لغو شده</option>
                                        </select>
                                        <span asp-validation-for="ProjectStatus" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="PriorityLevel" class="form-label">سطح اولویت</label>
                                        <select asp-for="PriorityLevel" class="form-select">
                                            <option value="1">1 - بسیار بالا</option>
                                            <option value="2">2 - بالا</option>
                                            <option value="3" selected>3 - متوسط</option>
                                            <option value="4">4 - پایین</option>
                                            <option value="5">5 - بسیار پایین</option>
                                        </select>
                                        <span asp-validation-for="PriorityLevel" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Project Details -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">جزئیات پروژه</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-12">
                                    <div class="mb-3">
                                        <label asp-for="ProjectDescription" class="form-label">شرح پروژه</label>
                                        <textarea asp-for="ProjectDescription" class="form-control" rows="4"></textarea>
                                        <span asp-validation-for="ProjectDescription" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Objectives" class="form-label">اهداف پروژه</label>
                                        <textarea asp-for="Objectives" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Objectives" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ExpectedOutcomes" class="form-label">نتایج مورد انتظار</label>
                                        <textarea asp-for="ExpectedOutcomes" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="ExpectedOutcomes" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Methodology" class="form-label">روش‌شناسی</label>
                                        <textarea asp-for="Methodology" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Methodology" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="RiskAssessment" class="form-label">ارزیابی ریسک</label>
                                        <textarea asp-for="RiskAssessment" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="RiskAssessment" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Team and Timeline -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">تیم و زمان‌بندی</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="PrincipalInvestigator" class="form-label">محقق اصلی</label>
                                        <input asp-for="PrincipalInvestigator" class="form-control" />
                                        <span asp-validation-for="PrincipalInvestigator" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProjectManager" class="form-label">مدیر پروژه</label>
                                        <input asp-for="ProjectManager" class="form-control" />
                                        <span asp-validation-for="ProjectManager" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="TeamMembers" class="form-label">اعضای تیم</label>
                                        <textarea asp-for="TeamMembers" class="form-control" rows="3" placeholder="نام اعضای تیم را وارد کنید"></textarea>
                                        <span asp-validation-for="TeamMembers" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Collaborators" class="form-label">همکاران خارجی</label>
                                        <textarea asp-for="Collaborators" class="form-control" rows="3" placeholder="سازمان‌ها یا افراد همکار"></textarea>
                                        <span asp-validation-for="Collaborators" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3" data-field="StartDate">
                                        <label class="form-label">تاریخ شروع</label>
                                        <input type="text"
                                               class="form-control"
                                               data-persian-date="true"
                                               autocomplete="off"
                                               readonly
                                               placeholder="تاریخ شروع"
                                               id="startDate"
                                               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy/MM/dd", new System.Globalization.CultureInfo("fa-IR")) : "")" />
                                        <input type="hidden" asp-for="StartDate" class="persian-date-hidden" />
                                        <span asp-validation-for="StartDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3" data-field="PlannedEndDate">
                                        <label class="form-label">تاریخ برنامه‌ریزی شده پایان</label>
                                        <input type="text"
                                               class="form-control"
                                               data-persian-date="true"
                                               autocomplete="off"
                                               readonly
                                               placeholder="تاریخ برنامه‌ریزی شده پایان"
                                               id="plannedEndDate"
                                               value="@(Model.PlannedEndDate.HasValue ? Model.PlannedEndDate.Value.ToString("yyyy/MM/dd", new System.Globalization.CultureInfo("fa-IR")) : "")" />
                                        <input type="hidden" asp-for="PlannedEndDate" class="persian-date-hidden" />
                                        <span asp-validation-for="PlannedEndDate" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3" data-field="ActualEndDate">
                                        <label class="form-label">تاریخ واقعی پایان</label>
                                        <input type="text"
                                               class="form-control"
                                               data-persian-date="true"
                                               autocomplete="off"
                                               readonly
                                               placeholder="تاریخ واقعی پایان"
                                               id="actualEndDate"
                                               value="@(Model.ActualEndDate.HasValue ? Model.ActualEndDate.Value.ToString("yyyy/MM/dd", new System.Globalization.CultureInfo("fa-IR")) : "")" />
                                        <input type="hidden" asp-for="ActualEndDate" class="persian-date-hidden" />
                                        <span asp-validation-for="ActualEndDate" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Budget and Resources -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h5 class="mb-0">بودجه و منابع</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="TotalBudget" class="form-label">بودجه کل</label>
                                        <input asp-for="TotalBudget" type="number" step="0.01" class="form-control" />
                                        <span asp-validation-for="TotalBudget" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="SpentBudget" class="form-label">بودجه مصرف شده</label>
                                        <input asp-for="SpentBudget" type="number" step="0.01" class="form-control" />
                                        <span asp-validation-for="SpentBudget" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="Currency" class="form-label">واحد پول</label>
                                        <select asp-for="Currency" class="form-select">
                                            <option value="IRR" selected>ریال ایران</option>
                                            <option value="USD">دلار آمریکا</option>
                                            <option value="EUR">یورو</option>
                                        </select>
                                        <span asp-validation-for="Currency" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <div class="mb-3">
                                        <label asp-for="ResourcesRequired" class="form-label">منابع مورد نیاز</label>
                                        <textarea asp-for="ResourcesRequired" class="form-control" rows="3" placeholder="تجهیزات، مواد، امکانات مورد نیاز"></textarea>
                                        <span asp-validation-for="ResourcesRequired" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Settings -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="IsActive" class="form-label">وضعیت</label>
                                <select asp-for="IsActive" class="form-select">
                                    <option value="true" selected>فعال</option>
                                    <option value="false">غیرفعال</option>
                                </select>
                                <span asp-validation-for="IsActive" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Tags" class="form-label">برچسب‌ها</label>
                                <input asp-for="Tags" class="form-control" placeholder="برچسب‌ها را با کاما جدا کنید" />
                                <span asp-validation-for="Tags" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Notes -->
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label">یادداشت‌ها</label>
                                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Date validation
        document.addEventListener('DOMContentLoaded', function() {
            const startDate = document.getElementById('startDate');
            const plannedEndDate = document.getElementById('plannedEndDate');
            const actualEndDate = document.getElementById('actualEndDate');

            function validateDates() {
                const start = new Date(startDate.value);
                const plannedEnd = new Date(plannedEndDate.value);
                const actualEnd = new Date(actualEndDate.value);

                // Validate planned end date
                if (startDate.value && plannedEndDate.value) {
                    if (plannedEnd < start) {
                        alert('تاریخ پایان برنامه‌ریزی شده نمی‌تواند قبل از تاریخ شروع باشد');
                        plannedEndDate.value = '';
                        return false;
                    }
                }

                // Validate actual end date
                if (startDate.value && actualEndDate.value) {
                    if (actualEnd < start) {
                        alert('تاریخ پایان واقعی نمی‌تواند قبل از تاریخ شروع باشد');
                        actualEndDate.value = '';
                        return false;
                    }
                }

                return true;
            }

            startDate.addEventListener('change', validateDates);
            plannedEndDate.addEventListener('change', validateDates);
            actualEndDate.addEventListener('change', validateDates);

            // Form submission validation
            document.getElementById('researchProjectForm').addEventListener('submit', function(e) {
                if (!validateDates()) {
                    e.preventDefault();
                }
            });
        });
    </script>
}