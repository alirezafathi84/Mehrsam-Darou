@model Mehrsam_Darou.Models.SalaryInfo

@{
    ViewData["Title"] = "ویرایش اطلاعات حقوق و دستمزد";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش اطلاعات حقوق و دستمزد</h4>
                    <a href="@Url.Action("SalaryInfoList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditSalaryInfo">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">کارمند <span class="text-danger">*</span></label>
                                <select asp-for="UserId" class="form-select" required>
                                    <option value="">-- انتخاب کارمند --</option>
                                    @foreach (var user in ViewBag.Users)
                                    {
                                        <option value="@user.Id" selected="@(user.Id == Model.UserId ? "selected" : null)">@user.FullName</option>
                                    }
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Currency" class="form-label">واحد پول <span class="text-danger">*</span></label>
                                <select asp-for="Currency" class="form-select" required>
                                    <option value="IRR">ریال (IRR)</option>
                                    <option value="USD">دلار آمریکا (USD)</option>
                                    <option value="EUR">یورو (EUR)</option>
                                </select>
                                <span asp-validation-for="Currency" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="BaseSalary" class="form-label">حقوق پایه <span class="text-danger">*</span></label>
                                <input asp-for="BaseSalary" type="number" step="0.01" min="0" class="form-control" required />
                                <span asp-validation-for="BaseSalary" class="text-danger"></span>
                                <small class="form-text text-muted">حقوق پایه ماهانه</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="HourlyRate" class="form-label">نرخ ساعتی <span class="text-danger">*</span></label>
                                <input asp-for="HourlyRate" type="number" step="0.01" min="0" class="form-control" required />
                                <span asp-validation-for="HourlyRate" class="text-danger"></span>
                                <small class="form-text text-muted">نرخ ساعتی کار</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="OvertimeRate" class="form-label">نرخ اضافه‌کاری <span class="text-danger">*</span></label>
                                <input asp-for="OvertimeRate" type="number" step="0.01" min="0" class="form-control" required />
                                <span asp-validation-for="OvertimeRate" class="text-danger"></span>
                                <small class="form-text text-muted">نرخ ساعتی اضافه‌کاری</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="EffectiveDate" class="form-label">تاریخ شروع <span class="text-danger">*</span></label>
                                <input asp-for="EffectiveDate" type="date" class="form-control" required />
                                <span asp-validation-for="EffectiveDate" class="text-danger"></span>
                                <small class="form-text text-muted">تاریخ شروع اعتبار این نرخ‌ها</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="EndDate" class="form-label">تاریخ پایان</label>
                                <input asp-for="EndDate" type="date" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                                <small class="form-text text-muted">در صورت خالی بودن، به عنوان نرخ فعال در نظر گرفته می‌شود</small>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <h6><i class="bx bx-info-circle me-1"></i> نکات مهم:</h6>
                        <ul class="mb-0">
                            <li>تغییر کارمند ممکن است بر روی محاسبات حقوق تأثیر بگذارد</li>
                            <li>نرخ‌های وارد شده بر اساس واحد پول انتخاب شده محاسبه می‌شود</li>
                            <li>حقوق پایه معمولاً حقوق ماهانه کارمند است</li>
                        </ul>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                        <button type="button" class="btn btn-secondary ms-2" onclick="calculateHourlyRate()">
                            <i class="bx bx-calculator me-1"></i> محاسبه نرخ ساعتی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function calculateHourlyRate() {
            const baseSalary = parseFloat(document.getElementById('BaseSalary').value) || 0;
            if (baseSalary > 0) {
                // Assuming 30 days per month and 8 hours per day
                const hourlyRate = baseSalary / (30 * 8);
                const overtimeRate = hourlyRate * 1.4; // 40% overtime premium

                document.getElementById('HourlyRate').value = Math.round(hourlyRate);
                document.getElementById('OvertimeRate').value = Math.round(overtimeRate);

                // Show notification
                const alert = document.createElement('div');
                alert.className = 'alert alert-success alert-dismissible fade show mt-2';
                alert.innerHTML = `
                    <strong>محاسبه انجام شد!</strong> نرخ ساعتی و اضافه‌کاری بر اساس حقوق پایه محاسبه شد.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.querySelector('.card-body').insertBefore(alert, document.querySelector('form'));

                // Auto remove after 3 seconds
                setTimeout(() => {
                    if (alert.parentNode) {
                        alert.parentNode.removeChild(alert);
                    }
                }, 3000);
            } else {
                alert('لطفاً ابتدا حقوق پایه را وارد کنید.');
                document.getElementById('BaseSalary').focus();
            }
        }

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert:not(.alert-info)');
            alerts.forEach(function (alert) {
                if (alert.classList.contains('alert-success') || alert.classList.contains('alert-danger')) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            });
        }, 5000);
    </script>
}