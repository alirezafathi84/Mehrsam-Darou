@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.SalaryInfo>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست اطلاعات حقوق و دستمزد";
}

<h2 class="mb-4">لیست اطلاعات حقوق و دستمزد</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="SalaryInfoList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو در نام، نام خانوادگی، نام کاربری...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddSalaryInfo")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> اطلاعات حقوق جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>کارمند</th>
                                <th>حقوق پایه</th>
                                <th>نرخ ساعتی</th>
                                <th>نرخ اضافه‌کاری</th>
                                <th>واحد پول</th>
                                <th>تاریخ شروع</th>
                                <th>تاریخ پایان</th>
                                <th>وضعیت</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var salary in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:user-rounded-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@salary.User.FirstName @salary.User.LastName</h6>
                                                    <small class="text-muted">@salary.User.Username</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-success fw-medium">@salary.BaseSalary.ToString("N0") @salary.Currency</span>
                                        </td>
                                        <td>
                                            <span class="text-info fw-medium">@salary.HourlyRate.ToString("N0") @salary.Currency</span>
                                        </td>
                                        <td>
                                            <span class="text-warning fw-medium">@salary.OvertimeRate.ToString("N0") @salary.Currency</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">@salary.Currency</span>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @if (!string.IsNullOrEmpty(salary.PersianEffectiveDate))
                                                {
                                                    @salary.PersianEffectiveDate
                                                }
                                                else
                                                {
                                                    var effectiveDateTime = salary.EffectiveDate.ToDateTime(TimeOnly.MinValue);
                                                    @($"{pc.GetYear(effectiveDateTime)}/{pc.GetMonth(effectiveDateTime):00}/{pc.GetDayOfMonth(effectiveDateTime):00}")
                                                }
                                            </small>
                                        </td>
                                        <td>
                                            @if (salary.EndDate.HasValue)
                                            {
                                                <small class="text-muted">
                                                    @if (!string.IsNullOrEmpty(salary.PersianEndDate))
                                                    {
                                                        @salary.PersianEndDate
                                                    }
                                                    else
                                                    {
                                                        var endDateTime = salary.EndDate.Value.ToDateTime(TimeOnly.MinValue);
                                                        @($"{pc.GetYear(endDateTime)}/{pc.GetMonth(endDateTime):00}/{pc.GetDayOfMonth(endDateTime):00}")
                                                    }
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!salary.EndDate.HasValue)
                                            {
                                                <span class="badge bg-success">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غیرفعال</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("EditSalaryInfo", new { id = salary.Id })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showSalaryDetails('@salary.Id')"
                                                        title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@salary.Id"
                                                        data-bs-name="@salary.User.FirstName @salary.User.LastName"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <i class="bx bx-wallet text-muted fs-1"></i>
                                        <p class="mt-2">هیچ اطلاعات حقوق و دستمزدی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("SalaryInfoList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("SalaryInfoList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("SalaryInfoList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف اطلاعات حقوق و دستمزد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف اطلاعات حقوق و دستمزد این کارمند مطمئن هستید؟</p>
                <p id="employeeNameToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل غیرقابل بازگشت است.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="salaryIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Salary Details Modal -->
<div class="modal fade" id="salaryDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات حقوق و دستمزد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="salaryDetailsContent">
                <!-- Salary details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var salaryId = button.getAttribute('data-bs-id');
                var employeeName = button.getAttribute('data-bs-name');

                document.getElementById('employeeNameToDelete').textContent = employeeName;
                document.getElementById('salaryIdToDelete').value = salaryId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showSalaryDetails(salaryId) {
            // This would typically load salary details via AJAX
            // For now, just show a placeholder
            var modal = new bootstrap.Modal(document.getElementById('salaryDetailsModal'));
            document.getElementById('salaryDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Simulate loading details
            setTimeout(function() {
                document.getElementById('salaryDetailsContent').innerHTML =
                    '<p>جزئیات کامل حقوق و دستمزد کارمند اینجا نمایش داده خواهد شد.</p>' +
                    '<p>شامل تاریخچه تغییرات، محاسبات حقوق و ...</p>';
            }, 1000);
        }
    </script>
}