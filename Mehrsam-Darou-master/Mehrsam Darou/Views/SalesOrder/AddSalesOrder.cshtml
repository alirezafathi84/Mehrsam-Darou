@model Mehrsam_Darou.Models.SalesOrder

@{
    ViewData["Title"] = "افزودن سفارش فروش جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن سفارش فروش جدید</h4>
                    <a href="@Url.Action("SalesOrderList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddSalesOrder">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="SoNumber" class="form-label">شماره سفارش <span class="text-danger">*</span></label>
                                <input asp-for="SoNumber" class="form-control bg-light" readonly />
                                <span asp-validation-for="SoNumber" class="text-danger"></span>
                                <small class="form-text text-muted">شماره سفارش به صورت خودکار تولید می‌شود</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="CustomerId" class="form-label">مشتری <span class="text-danger">*</span></label>
                                <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers" required>
                                    <option value="">-- انتخاب مشتری --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="OrderDate" class="form-label">تاریخ سفارش <span class="text-danger">*</span></label>
                                <input asp-for="OrderDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="RequestedDeliveryDate" class="form-label">تاریخ تحویل درخواستی</label>
                                <input asp-for="RequestedDeliveryDate" type="date" class="form-control" />
                                <span asp-validation-for="RequestedDeliveryDate" class="text-danger"></span>
                                <small class="form-text text-muted">تاریخ مورد نظر مشتری برای تحویل</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت</label>
                                <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusOptions">
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                                <small class="form-text text-muted">وضعیت اولیه: پیش‌نویس</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Priority" class="form-label">اولویت</label>
                                <select asp-for="Priority" class="form-select" asp-items="ViewBag.PriorityOptions">
                                </select>
                                <span asp-validation-for="Priority" class="text-danger"></span>
                                <small class="form-text text-muted">اولویت پردازش سفارش</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="TaxAmount" class="form-label">مبلغ مالیات</label>
                                <div class="input-group">
                                    <input asp-for="TaxAmount" type="number" step="0.01" class="form-control" placeholder="0.00" value="0" />
                                    <span class="input-group-text">ریال</span>
                                </div>
                                <span asp-validation-for="TaxAmount" class="text-danger"></span>
                                <small class="form-text text-muted">مبلغ مالیات اضافه شده به سفارش</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="DiscountAmount" class="form-label">مبلغ تخفیف</label>
                                <div class="input-group">
                                    <input asp-for="DiscountAmount" type="number" step="0.01" class="form-control" placeholder="0.00" value="0" />
                                    <span class="input-group-text">ریال</span>
                                </div>
                                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
                                <small class="form-text text-muted">مبلغ تخفیف کل سفارش</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Currency" class="form-label">واحد پول</label>
                                <select asp-for="Currency" class="form-select">
                                    <option value="IRR" selected>ریال (IRR)</option>
                                    <option value="USD">دلار آمریکا (USD)</option>
                                    <option value="EUR">یورو (EUR)</option>
                                </select>
                                <span asp-validation-for="Currency" class="text-danger"></span>
                                <small class="form-text text-muted">واحد پولی محاسبات</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label">یادداشت</label>
                                <textarea asp-for="Notes" class="form-control" rows="4" placeholder="یادداشت‌های مربوط به سفارش، شرایط خاص، توضیحات اضافی..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                                <small class="form-text text-muted">یادداشت‌ها و توضیحات اضافی مربوط به سفارش</small>
                            </div>
                        </div>
                    </div>

                    <!-- Summary Preview -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title text-primary">
                                        <i class="bx bx-info-circle me-1"></i>
                                        پیش‌نمایش محاسبات
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="text-center">
                                                <small class="text-muted">جمع آیتم‌ها</small>
                                                <div class="h6 mb-0" id="previewSubtotal">0.00 ریال</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-center">
                                                <small class="text-muted">مالیات</small>
                                                <div class="h6 mb-0 text-info" id="previewTax">0.00 ریال</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-center">
                                                <small class="text-muted">تخفیف</small>
                                                <div class="h6 mb-0 text-warning" id="previewDiscount">0.00 ریال</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-center">
                                                <small class="text-muted">مبلغ نهایی</small>
                                                <div class="h5 mb-0 text-success" id="previewTotal">0.00 ریال</div>
                                            </div>
                                        </div>
                                    </div>
                                    <hr class="my-2">
                                    <small class="text-muted">
                                        <i class="bx bx-info-circle me-1"></i>
                                        پس از ذخیره سفارش، می‌توانید آیتم‌های مورد نظر را اضافه کنید.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bx bx-save me-1"></i> ذخیره و ادامه
                        </button>
                        <button type="reset" class="btn btn-outline-secondary btn-lg">
                            <i class="bx bx-reset me-1"></i> پاک کردن فرم
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Help Modal -->
<div class="modal fade" id="helpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">راهنمای ایجاد سفارش فروش</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="accordion" id="helpAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#help1">
                                مراحل ایجاد سفارش
                            </button>
                        </h2>
                        <div id="help1" class="accordion-collapse collapse show" data-bs-parent="#helpAccordion">
                            <div class="accordion-body">
                                <ol>
                                    <li>مشتری مورد نظر را انتخاب کنید</li>
                                    <li>تاریخ سفارش و تحویل را تعیین کنید</li>
                                    <li>در صورت نیاز مالیات و تخفیف را وارد کنید</li>
                                    <li>سفارش را ذخیره کنید</li>
                                    <li>آیتم‌های مورد نظر را اضافه کنید</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#help2">
                                محاسبات مالی
                            </button>
                        </h2>
                        <div id="help2" class="accordion-collapse collapse" data-bs-parent="#helpAccordion">
                            <div class="accordion-body">
                                <p><strong>فرمول محاسبه:</strong></p>
                                <p>مبلغ نهایی = (جمع آیتم‌ها + مالیات) - تخفیف</p>
                                <p><strong>نکته:</strong> مالیات و تخفیف به صورت مبلغ ثابت محاسبه می‌شود.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Initialize form
            updatePreview();

            // Add help button
            $('h4').after(
                '<button type="button" class="btn btn-outline-info btn-sm ms-2" data-bs-toggle="modal" data-bs-target="#helpModal">' +
                '<i class="bx bx-help-circle me-1"></i>راهنما</button>'
            );

            // Update preview when tax or discount changes
            $('#TaxAmount, #DiscountAmount').on('input change', function() {
                updatePreview();
            });

            // Form validation
            $('form').on('submit', function(e) {
                var customerId = $('#CustomerId').val();
                if (!customerId) {
                    e.preventDefault();
                    alert('لطفاً مشتری را انتخاب کنید.');
                    $('#CustomerId').focus();
                    return false;
                }

                // Validate dates
                var orderDate = new Date($('#OrderDate').val());
                var deliveryDate = $('#RequestedDeliveryDate').val();

                if (deliveryDate) {
                    var requestedDate = new Date(deliveryDate);
                    if (requestedDate < orderDate) {
                        e.preventDefault();
                        alert('تاریخ تحویل درخواستی نمی‌تواند قبل از تاریخ سفارش باشد.');
                        $('#RequestedDeliveryDate').focus();
                        return false;
                    }
                }

                // Show loading state
                $(this).find('button[type="submit"]').prop('disabled', true)
                    .html('<i class="bx bx-loader bx-spin me-1"></i> در حال ذخیره...');
            });

            // Reset form
            $('button[type="reset"]').on('click', function() {
                setTimeout(function() {
                    updatePreview();
                }, 100);
            });

            // Customer selection validation
            $('#CustomerId').on('change', function() {
                if ($(this).val()) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                } else {
                    $(this).removeClass('is-valid').addClass('is-invalid');
                }
            });

            // Date validation
            $('#OrderDate').on('change', function() {
                var orderDate = new Date($(this).val());
                var today = new Date();
                today.setHours(0, 0, 0, 0);

                if (orderDate < today) {
                    $(this).addClass('is-invalid');
                    showAlert('warning', 'تاریخ سفارش از امروز کمتر است. آیا مطمئن هستید؟');
                } else {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                }
            });

            function updatePreview() {
                var tax = parseFloat($('#TaxAmount').val()) || 0;
                var discount = parseFloat($('#DiscountAmount').val()) || 0;
                var subtotal = 0; // Will be calculated after adding items
                var total = subtotal + tax - discount;

                // Ensure total is not negative
                total = Math.max(0, total);

                $('#previewSubtotal').text(formatMoney(subtotal));
                $('#previewTax').text(formatMoney(tax));
                $('#previewDiscount').text(formatMoney(discount));
                $('#previewTotal').text(formatMoney(total));
            }

            function formatMoney(amount) {
                return new Intl.NumberFormat('fa-IR', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }).format(amount) + ' ریال';
            }

            function showAlert(type, message) {
                var alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                $('.card-body').first().prepend(alertHtml);

                // Auto dismiss after 5 seconds
                setTimeout(function() {
                    $('.alert').alert('close');
                }, 5000);
            }

            // Auto-dismiss existing alerts
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        });
    </script>
}