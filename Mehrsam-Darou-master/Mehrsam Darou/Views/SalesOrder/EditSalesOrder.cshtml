@model Mehrsam_Darou.Models.SalesOrder

@{
    ViewData["Title"] = "ویرایش سفارش فروش";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش سفارش فروش - @Model.SoNumber</h4>
                    <div>
                        <a href="@Url.Action("Details", new { id = Model.SalesOrderId })" class="btn btn-info me-2">
                            <i class="bx bx-show me-1"></i> مشاهده جزئیات
                        </a>
                        <a href="@Url.Action("SalesOrderList")" class="btn btn-secondary">
                            <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                        </a>
                    </div>
                </div>

                <form asp-action="EditSalesOrder">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="SalesOrderId" />

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="SoNumber" class="form-label">شماره سفارش <span class="text-danger">*</span></label>
                                <input asp-for="SoNumber" class="form-control" readonly />
                                <span asp-validation-for="SoNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="CustomerId" class="form-label">مشتری <span class="text-danger">*</span></label>
                                <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                    <option value="">-- انتخاب مشتری --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="OrderDate" class="form-label">تاریخ سفارش <span class="text-danger">*</span></label>
                                <input asp-for="OrderDate" type="date" class="form-control" value="@Model.OrderDate.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="RequestedDeliveryDate" class="form-label">تاریخ تحویل درخواستی</label>
                                <input asp-for="RequestedDeliveryDate" type="date" class="form-control"
                                       value="@(Model.RequestedDeliveryDate?.ToString("yyyy-MM-dd") ?? "")" />
                                <span asp-validation-for="RequestedDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="PromisedDeliveryDate" class="form-label">تاریخ تحویل متعهد شده</label>
                                <input asp-for="PromisedDeliveryDate" type="date" class="form-control"
                                       value="@(Model.PromisedDeliveryDate?.ToString("yyyy-MM-dd") ?? "")" />
                                <span asp-validation-for="PromisedDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت</label>
                                <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusOptions">
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Priority" class="form-label">اولویت</label>
                                <select asp-for="Priority" class="form-select" asp-items="ViewBag.PriorityOptions">
                                </select>
                                <span asp-validation-for="Priority" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="TaxAmount" class="form-label">مالیات</label>
                                <input asp-for="TaxAmount" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="TaxAmount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="DiscountAmount" class="form-label">تخفیف</label>
                                <input asp-for="DiscountAmount" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="DiscountAmount" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label">یادداشت</label>
                                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="یادداشت‌های مربوط به سفارش..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Order Items Section -->
<div class="row mt-4">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">آیتم‌های سفارش</h5>
            </div>
            <div class="card-body">
                <!-- Add Item Form -->
                <div class="row mb-4 p-3 bg-light rounded">
                    <h6 class="mb-3">افزودن آیتم جدید</h6>
                    <div class="col-md-2">
                        <select id="medicineSelect" class="form-select" asp-items="ViewBag.Medicines">
                            <option value="">-- انتخاب دارو --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" id="quantityInput" class="form-control" placeholder="مقدار" step="0.001" />
                    </div>
                    <div class="col-md-2">
                        <select id="unitSelect" class="form-select" asp-items="ViewBag.Units">
                            <option value="">-- واحد --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" id="unitPriceInput" class="form-control" placeholder="قیمت واحد" step="0.01" />
                    </div>
                    <div class="col-md-2">
                        <input type="number" id="discountInput" class="form-control" placeholder="تخفیف %" step="0.01" value="0" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="addItemBtn" class="btn btn-success">
                            <i class="bx bx-plus"></i> افزودن
                        </button>
                    </div>
                </div>

                <!-- Items Table -->
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>دارو</th>
                                <th>مقدار</th>
                                <th>واحد</th>
                                <th>قیمت واحد</th>
                                <th>تخفیف</th>
                                <th>قیمت کل</th>
                                <th>ارسال شده</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody id="orderItemsTable">
                            @if (Model.SalesOrderItems != null)
                            {
                                foreach (var item in Model.SalesOrderItems)
                                {
                                    <tr data-item-id="@item.SoItemId">
                                        <td>@item.Medicine?.BrandName</td>
                                        <td>@item.Quantity.ToString("N3")</td>
                                        <td>@item.Unit?.UnitName</td>
                                        <td>@item.UnitPrice.ToString("N2")</td>
                                        <td>@((item.DiscountPercent ?? 0).ToString("N2"))%</td>
                                        <td>@item.TotalPrice.ToString("N2")</td>
                                        <td>@((item.ShippedQuantity ?? 0).ToString("N3"))</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-danger remove-item" data-item-id="@item.SoItemId">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Order Summary -->
                <div class="row mt-4">
                    <div class="col-md-6 offset-md-6">
                        <table class="table table-sm">
                            <tr>
                                <td>جمع کل:</td>
                                <td class="text-end">@((Model.TotalAmount ?? 0).ToString("N2")) ریال</td>
                            </tr>
                            <tr>
                                <td>مالیات:</td>
                                <td class="text-end">@((Model.TaxAmount ?? 0).ToString("N2")) ریال</td>
                            </tr>
                            <tr>
                                <td>تخفیف:</td>
                                <td class="text-end">@((Model.DiscountAmount ?? 0).ToString("N2")) ریال</td>
                            </tr>
                            <tr class="fw-bold">
                                <td>مبلغ نهایی:</td>
                                <td class="text-end">@((Model.NetAmount ?? 0).ToString("N2")) ریال</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Add item functionality
            $('#addItemBtn').click(function() {
                var medicineId = $('#medicineSelect').val();
                var quantity = $('#quantityInput').val();
                var unitId = $('#unitSelect').val();
                var unitPrice = $('#unitPriceInput').val();
                var discount = $('#discountInput').val() || 0;

                if (!medicineId || !quantity || !unitId || !unitPrice) {
                    alert('لطفاً همه فیلدهای اجباری را پر کنید');
                    return;
                }

                $.post('@Url.Action("AddOrderItem")', {
                    salesOrderId: '@Model.SalesOrderId',
                    medicineId: medicineId,
                    quantity: quantity,
                    unitId: unitId,
                    unitPrice: unitPrice,
                    discountPercent: discount
                }, function(result) {
                    if (result.success) {
                        location.reload();
                    } else {
                        alert(result.message);
                    }
                });
            });

            // Remove item functionality
            $('.remove-item').click(function() {
                if (confirm('آیا از حذف این آیتم مطمئن هستید؟')) {
                    var itemId = $(this).data('item-id');
                    $.post('@Url.Action("RemoveOrderItem")', {
                        itemId: itemId
                    }, function(result) {
                        if (result.success) {
                            location.reload();
                        } else {
                            alert(result.message);
                        }
                    });
                }
            });
        });
    </script>
}