@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.SalesOrder>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست سفارشات فروش";
}

<h2 class="mb-4">لیست سفارشات فروش</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                    <form method="get" asp-action="SalesOrderList" class="d-flex gap-2">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو...">
                        </div>
                        <select name="status" class="form-select" asp-items="ViewBag.StatusOptions" style="width: 200px;">
                        </select>
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bx bx-filter-alt"></i> فیلتر
                        </button>
                    </form>
                    <div>
                        <a href="@Url.Action("AddSalesOrder")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> سفارش فروش جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>شماره سفارش</th>
                                <th>مشتری</th>
                                <th>تاریخ سفارش</th>
                                <th>تحویل درخواستی</th>
                                <th>مبلغ کل</th>
                                <th>وضعیت</th>
                                <th>اولویت</th>
                                <th>آیتم‌ها</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var order in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:document-text-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@order.SoNumber</h6>
                                                    <small class="text-muted">
                                                        @{
                                                            var createdDateTime = order.CreatedDate;
                                                        }
                                                        @($"{pc.GetYear(createdDateTime)}/{pc.GetMonth(createdDateTime):00}/{pc.GetDayOfMonth(createdDateTime):00}")
                                                    </small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <h6 class="mb-0">@order.Customer?.CustomerName</h6>
                                                <small class="text-muted">@order.Customer?.CustomerCode</small>
                                            </div>
                                        </td>
                                        <td>
                                            <small>
                                                @{
                                                    var orderDateTime = order.OrderDate.ToDateTime(TimeOnly.MinValue);
                                                }
                                                @($"{pc.GetYear(orderDateTime)}/{pc.GetMonth(orderDateTime):00}/{pc.GetDayOfMonth(orderDateTime):00}")
                                            </small>
                                        </td>
                                        <td>
                                            @if (order.RequestedDeliveryDate.HasValue)
                                            {
                                                <small class="text-primary">
                                                    @{
                                                        var requestedDateTime = order.RequestedDeliveryDate.Value.ToDateTime(TimeOnly.MinValue);
                                                    }
                                                    @($"{pc.GetYear(requestedDateTime)}/{pc.GetMonth(requestedDateTime):00}/{pc.GetDayOfMonth(requestedDateTime):00}")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (order.NetAmount.HasValue)
                                            {
                                                <span class="fw-medium text-success">@order.NetAmount.Value.ToString("N0") ریال</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var statusClass = order.Status switch
                                                {
                                                    "پیش‌نویس" => "bg-secondary",
                                                    "تایید شده" => "bg-info",
                                                    "در حال تولید" => "bg-warning",
                                                    "آماده ارسال" => "bg-primary",
                                                    "ارسال شده" => "bg-success",
                                                    "تحویل داده شده" => "bg-success",
                                                    "لغو شده" => "bg-danger",
                                                    _ => "bg-light"
                                                };
                                            }
                                            <span class="badge @statusClass">@order.Status</span>
                                        </td>
                                        <td>
                                            @{
                                                var priorityClass = order.Priority switch
                                                {
                                                    1 => "bg-danger-subtle text-danger",
                                                    2 => "bg-warning-subtle text-warning",
                                                    3 => "bg-info-subtle text-info",
                                                    4 => "bg-light text-muted",
                                                    _ => "bg-light text-muted"
                                                };
                                                var priorityText = order.Priority switch
                                                {
                                                    1 => "بالا",
                                                    2 => "متوسط",
                                                    3 => "عادی",
                                                    4 => "پایین",
                                                    _ => "نامشخص"
                                                };
                                            }
                                            <span class="badge @priorityClass">@priorityText</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark">
                                                @(order.SalesOrderItems?.Count ?? 0) آیتم
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <a href="@Url.Action("Details", new { id = order.SalesOrderId })"
                                                   class="btn btn-soft-info btn-sm" title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <a href="@Url.Action("EditSalesOrder", new { id = order.SalesOrderId })"
                                                   class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                @if (order.Status == "پیش‌نویس")
                                                {
                                                    <button type="button" class="btn btn-soft-danger btn-sm"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteModal"
                                                            data-bs-id="@order.SalesOrderId"
                                                            data-bs-name="@order.SoNumber"
                                                            title="حذف">
                                                        <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-soft-secondary btn-sm" disabled title="سفارش تایید شده قابل حذف نیست">
                                                        <iconify-icon icon="solar:lock-keyhole-minimalistic-broken" class="align-middle fs-18"></iconify-icon>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <i class="bx bx-file text-muted fs-1"></i>
                                        <p class="mt-2">هیچ سفارش فروشی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("SalesOrderList", new {
                                    page = Model.PageIndex - 1,
                                    searchKey = Context.Request.Query["searchKey"],
                                    status = Context.Request.Query["status"]
                                })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("SalesOrderList", new {
                                    page = i,
                                    searchKey = Context.Request.Query["searchKey"],
                                    status = Context.Request.Query["status"]
                                })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("SalesOrderList", new {
                                    page = Model.PageIndex + 1,
                                    searchKey = Context.Request.Query["searchKey"],
                                    status = Context.Request.Query["status"]
                                })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف سفارش فروش</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این سفارش فروش مطمئن هستید؟</p>
                <p id="orderNumberToDelete" class="fw-bold"></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> در صورت وجود فاکتور یا حمل و نقل، امکان حذف وجود ندارد.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="orderIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var orderId = button.getAttribute('data-bs-id');
                var orderNumber = button.getAttribute('data-bs-name');

                document.getElementById('orderNumberToDelete').textContent = orderNumber;
                document.getElementById('orderIdToDelete').value = orderId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}