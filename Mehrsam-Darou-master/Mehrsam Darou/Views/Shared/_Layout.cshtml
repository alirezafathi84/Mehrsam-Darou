    <!-- Attendance Success Modal -->
    <div class="modal fade" id="attendanceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <div class="avatar-lg mx-auto">
                            <div class="avatar-title rounded-circle bg-success text-white">
                                <i class="bx bx-check fs-2"></i>
                            </div>
                        </div>
                    </div>
                    <h5 class="modal-title mb-2" id="attendanceModalTitle">عملیات موفق</h5>
                    <p class="text-muted mb-0" id="attendanceModalMessage">ورود شما با موفقیت ثبت شد</p>
                    <div class="mt-3">
                        <small class="text-muted" id="attendanceModalTime"></small>
                    </div>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">تأیید</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function quickEntryFromHeader() {
            // Get the current user's ID from ViewData
            const userId = '@ViewData["UserId"]';

            if (!userId) {
                showAttendanceModal('خطا', 'شناسه کاربر یافت نشد', 'error');
                return;
            }

            // Show loading state
            const entryBtn = document.querySelector('button[onclick="quickEntryFromHeader()"]');
            const originalText = entryBtn.innerHTML;
            entryBtn.disabled = true;
            entryBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i>در حال ثبت...';

            // Create form data
            const formData = new FormData();
            formData.append('userId', userId);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            // Send AJAX request
            fetch('@Url.Action("QuickEntry", "AttendanceLog")', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    showAttendanceModal('ورود ثبت شد', 'ورود شما با موفقیت ثبت شد', 'success');
                } else {
                    throw new Error('خطا در ثبت ورود');
                }
            })
            .catch(error => {
                showAttendanceModal('خطا', 'خطا در ثبت ورود', 'error');
            })
            .finally(() => {
                // Restore button state
                entryBtn.disabled = false;
                entryBtn.innerHTML = originalText;
            });
        }

        function quickExitFromHeader() {
            // Get the current user's ID from ViewData
            const userId = '@ViewData["UserId"]';

            if (!userId) {
                showAttendanceModal('خطا', 'شناسه کاربر یافت نشد', 'error');
                return;
            }

            // Show loading state
            const exitBtn = document.querySelector('button[onclick="quickExitFromHeader()"]');
            const originalText = exitBtn.innerHTML;
            exitBtn.disabled = true;
            exitBtn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i>در حال ثبت...';

            // Create form data
            const formData = new FormData();
            formData.append('userId', userId);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            // Send AJAX request
            fetch('@Url.Action("QuickExit", "AttendanceLog")', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    showAttendanceModal('خروج ثبت شد', 'خروج شما با موفقیت ثبت شد', 'success');
                } else {
                    throw new Error('خطا در ثبت خروج');
                }
            })
            .catch(error => {
                showAttendanceModal('خطا', 'خطا در ثبت خروج', 'error');
            })
            .finally(() => {
                // Restore button state
                exitBtn.disabled = false;
                exitBtn.innerHTML = originalText;
            });
        }

        function showAttendanceModal(title, message, type) {
            const modal = document.getElementById('attendanceModal');
            const modalTitle = document.getElementById('attendanceModalTitle');
            const modalMessage = document.getElementById('attendanceModalMessage');
            const modalTime = document.getElementById('attendanceModalTime');
            const avatarDiv = modal.querySelector('.avatar-title');
            const icon = modal.querySelector('.avatar-title i');

            // Set content
            modalTitle.textContent = title;
            modalMessage.textContent = message;
            modalTime.textContent = new Date().toLocaleString('fa-IR');

            // Set icon and color based on type
            if (type === 'error') {
                avatarDiv.className = 'avatar-title rounded-circle bg-danger text-white';
                icon.className = 'bx bx-x fs-2';
            } else {
                avatarDiv.className = 'avatar-title rounded-circle bg-success text-white';
                icon.className = 'bx bx-check fs-2';
            }

            // Show modal
            const bootstrapModal = new bootstrap.Modal(modal);
            bootstrapModal.show();

            // Close user dropdown
            const userDropdown = document.getElementById('page-header-user-dropdown');
            if (userDropdown) {
                const dropdown = bootstrap.Dropdown.getInstance(userDropdown);
                if (dropdown) {
                    dropdown.hide();
                }
            }
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
