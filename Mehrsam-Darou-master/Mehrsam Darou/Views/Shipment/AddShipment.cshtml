@model Mehrsam_Darou.Models.Shipment

@{
    ViewData["Title"] = "افزودن حمل و نقل جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن حمل و نقل جدید</h4>
                    <a href="@Url.Action("ShipmentList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddShipment">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ShipmentNumber" class="form-label">شماره حمل و نقل <span class="text-danger">*</span></label>
                                <input asp-for="ShipmentNumber" class="form-control" />
                                <span asp-validation-for="ShipmentNumber" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CustomerId" class="form-label">مشتری <span class="text-danger">*</span></label>
                                <select asp-for="CustomerId" asp-items="@ViewBag.Customers" class="form-select">
                                    <option value="">-- انتخاب مشتری --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="SalesOrderId" class="form-label">سفارش فروش</label>
                                <select asp-for="SalesOrderId" asp-items="@ViewBag.SalesOrders" class="form-select">
                                    <option value="">-- انتخاب سفارش فروش --</option>
                                </select>
                                <span asp-validation-for="SalesOrderId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ShipmentDate" class="form-label">تاریخ ارسال <span class="text-danger">*</span></label>
                                <input asp-for="ShipmentDate" type="date" class="form-control" />
                                <span asp-validation-for="ShipmentDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ExpectedDeliveryDate" class="form-label">تاریخ تحویل مورد انتظار</label>
                                <input asp-for="ExpectedDeliveryDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ActualDeliveryDate" class="form-label">تاریخ تحویل واقعی</label>
                                <input asp-for="ActualDeliveryDate" type="date" class="form-control" />
                                <span asp-validation-for="ActualDeliveryDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Carrier" class="form-label">شرکت حمل‌کننده</label>
                                <select asp-for="Carrier" asp-items="@ViewBag.Carriers" class="form-select">
                                    <option value="">-- انتخاب شرکت حمل‌کننده --</option>
                                </select>
                                <span asp-validation-for="Carrier" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TrackingNumber" class="form-label">شماره پیگیری</label>
                                <input asp-for="TrackingNumber" class="form-control" />
                                <span asp-validation-for="TrackingNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="ShippingAddress" class="form-label">آدرس ارسال</label>
                                <textarea asp-for="ShippingAddress" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="ShippingCost" class="form-label">هزینه حمل و نقل</label>
                                <input asp-for="ShippingCost" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="ShippingCost" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="WeightKg" class="form-label">وزن (کیلوگرم)</label>
                                <input asp-for="WeightKg" type="number" step="0.001" class="form-control" />
                                <span asp-validation-for="WeightKg" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="VolumeM3" class="form-label">حجم (متر مکعب)</label>
                                <input asp-for="VolumeM3" type="number" step="0.000001" class="form-control" />
                                <span asp-validation-for="VolumeM3" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="در حال آماده‌سازی">در حال آماده‌سازی</option>
                                    <option value="آماده">آماده</option>
                                    <option value="ارسال شده">ارسال شده</option>
                                    <option value="در حال حمل">در حال حمل</option>
                                    <option value="تحویل داده شده">تحویل داده شده</option>
                                    <option value="برگشت داده شده">برگشت داده شده</option>
                                    <option value="لغو شده">لغو شده</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label">یادداشت‌ها</label>
                                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);

            // Customer change event to load related sales orders
            const customerSelect = document.querySelector('[name="CustomerId"]');
            const salesOrderSelect = document.querySelector('[name="SalesOrderId"]');

            customerSelect.addEventListener('change', function() {
                const customerId = this.value;
                if (customerId) {
                    // Here you would typically make an AJAX call to load sales orders for the selected customer
                    // For now, we'll just clear the sales order selection
                    salesOrderSelect.value = '';
                }
            });
        });
    </script>
}