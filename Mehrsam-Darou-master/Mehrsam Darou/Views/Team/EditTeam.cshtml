@model Mehrsam_Darou.Models.Team

<h2>ویرایش تیم</h2>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-primary px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <form asp-action="EditTeam" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <!-- Main Fields -->
                        <div class="col-md-12 mb-4">
                            <div class="form-group">
                                <label asp-for="Name">نام تیم</label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="DefaultPageForTeam">صفحه پیش‌فرض تیم</label>
                                <input asp-for="DefaultPageForTeam" class="form-control" />
                                <span asp-validation-for="DefaultPageForTeam" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Module-Level Permissions -->
                        <h5 class="mb-3">دسترسی‌های ماژول</h5>

                        <!-- First Row of Module Checkboxes -->
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="IsActive" name="IsActive" value="true" @((Model.IsActive ?? false) ? "checked" : "") />
                                    <input type="hidden" name="IsActive" value="false" />
                                    <label class="form-check-label" for="IsActive">فعال</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="ManagmentDashboard" name="ManagmentDashboard" value="true" @((Model.ManagmentDashboard ?? false) ? "checked" : "") data-module="ManagmentDashboard" />
                                    <input type="hidden" name="ManagmentDashboard" value="false" />
                                    <label class="form-check-label" for="ManagmentDashboard">داشبورد مدیریت</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="Setting" name="Setting" value="true" @((Model.Setting ?? false) ? "checked" : "") data-module="Setting" />
                                    <input type="hidden" name="Setting" value="false" />
                                    <label class="form-check-label" for="Setting">تنظیمات</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="SystemUsers" name="SystemUsers" value="true" @((Model.SystemUsers ?? false) ? "checked" : "") data-module="SystemUsers" />
                                    <input type="hidden" name="SystemUsers" value="false" />
                                    <label class="form-check-label" for="SystemUsers">کاربران سیستم</label>
                                </div>
                            </div>
                        </div>

                        <!-- Second Row of Module Checkboxes -->
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="Financial" name="Financial" value="true" @((Model.Financial ?? false) ? "checked" : "") data-module="Financial" />
                                    <input type="hidden" name="Financial" value="false" />
                                    <label class="form-check-label" for="Financial">مالی</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="Inventory" name="Inventory" value="true" @((Model.Inventory ?? false) ? "checked" : "") data-module="Inventory" />
                                    <input type="hidden" name="Inventory" value="false" />
                                    <label class="form-check-label" for="Inventory">انبار</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="Product" name="Product" value="true" @((Model.Product ?? false) ? "checked" : "") data-module="Product" />
                                    <input type="hidden" name="Product" value="false" />
                                    <label class="form-check-label" for="Product">محصول</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="SellCommercial" name="SellCommercial" value="true" @((Model.SellCommercial ?? false) ? "checked" : "") data-module="SellCommercial" />
                                    <input type="hidden" name="SellCommercial" value="false" />
                                    <label class="form-check-label" for="SellCommercial">بازرگانی فروش</label>
                                </div>
                            </div>
                        </div>

                        <!-- Third Row of Module Checkboxes -->
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="BuyCommercial" name="BuyCommercial" value="true" @((Model.BuyCommercial ?? false) ? "checked" : "") data-module="BuyCommercial" />
                                    <input type="hidden" name="BuyCommercial" value="false" />
                                    <label class="form-check-label" for="BuyCommercial">بازرگانی خرید</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="RandD" name="RandD" value="true" @((Model.RandD ?? false) ? "checked" : "") data-module="RandD" />
                                    <input type="hidden" name="RandD" value="false" />
                                    <label class="form-check-label" for="RandD">تحقیق و توسعه</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="Qc" name="Qc" value="true" @((Model.Qc ?? false) ? "checked" : "") data-module="Qc" />
                                    <input type="hidden" name="Qc" value="false" />
                                    <label class="form-check-label" for="Qc">کنترل کیفیت</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="Qa" name="Qa" value="true" @((Model.Qa ?? false) ? "checked" : "") data-module="Qa" />
                                    <input type="hidden" name="Qa" value="false" />
                                    <label class="form-check-label" for="Qa">تضمین کیفیت</label>
                                </div>
                            </div>
                        </div>

                        <!-- Fourth Row (with only PMO checkbox) -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input module-checkbox" role="switch" id="Pmo" name="Pmo" value="true" @((Model.Pmo ?? false) ? "checked" : "") data-module="Pmo" />
                                    <input type="hidden" name="Pmo" value="false" />
                                    <label class="form-check-label" for="Pmo">مدیریت پروژه</label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Page-Level Permissions -->
                        <h5 class="mb-3">دسترسی‌های صفحه</h5>

                        <!-- Management Dashboard Pages -->
                        <div class="permission-section" data-module="ManagmentDashboard" style="display: @((Model.ManagmentDashboard ?? false) ? "block" : "none");">
                            <h6 class="text-primary mb-2">صفحات داشبورد مدیریت</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ManagementDashboardDashboard" name="ManagementDashboardDashboard" value="true" @((Model.ManagementDashboardDashboard ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ManagementDashboardDashboard" value="false" />
                                        <label class="form-check-label" for="ManagementDashboardDashboard">داشبورد</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ManagementDashboardNotifications" name="ManagementDashboardNotifications" value="true" @((Model.ManagementDashboardNotifications ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ManagementDashboardNotifications" value="false" />
                                        <label class="form-check-label" for="ManagementDashboardNotifications">مدیریت اعلان‌ها</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ManagementDashboardAllRequests" name="ManagementDashboardAllRequests" value="true" @((Model.ManagementDashboardAllRequests ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ManagementDashboardAllRequests" value="false" />
                                        <label class="form-check-label" for="ManagementDashboardAllRequests">تمام درخواست‌ها</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ManagementDashboardRequestsDashboard" name="ManagementDashboardRequestsDashboard" value="true" @((Model.ManagementDashboardRequestsDashboard ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ManagementDashboardRequestsDashboard" value="false" />
                                        <label class="form-check-label" for="ManagementDashboardRequestsDashboard">داشبورد درخواست‌ها</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- System Users Pages -->
                        <div class="permission-section" data-module="SystemUsers" style="display: @((Model.SystemUsers ?? false) ? "block" : "none");">
                            <h6 class="text-primary mb-2">صفحات مدیریت کاربران</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="SystemUsersUserList" name="SystemUsersUserList" value="true" @((Model.SystemUsersUserList ?? false) ? "checked" : "") />
                                        <input type="hidden" name="SystemUsersUserList" value="false" />
                                        <label class="form-check-label" for="SystemUsersUserList">لیست کاربران</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="SystemUsersTeamManagement" name="SystemUsersTeamManagement" value="true" @((Model.SystemUsersTeamManagement ?? false) ? "checked" : "") />
                                        <input type="hidden" name="SystemUsersTeamManagement" value="false" />
                                        <label class="form-check-label" for="SystemUsersTeamManagement">مدیریت تیم‌ها</label>
                                    </div>
                                </div>
                            </div>

                            <h6 class="text-secondary mb-2">صفحات منابع انسانی</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="HrAttendanceLog" name="HrAttendanceLog" value="true" @((Model.HrAttendanceLog ?? false) ? "checked" : "") />
                                        <input type="hidden" name="HrAttendanceLog" value="false" />
                                        <label class="form-check-label" for="HrAttendanceLog">ثبت ورود و خروج</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="HrDailyAttendance" name="HrDailyAttendance" value="true" @((Model.HrDailyAttendance ?? false) ? "checked" : "") />
                                        <input type="hidden" name="HrDailyAttendance" value="false" />
                                        <label class="form-check-label" for="HrDailyAttendance">گزارش حضور و غیاب</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="HrSalaryManagement" name="HrSalaryManagement" value="true" @((Model.HrSalaryManagement ?? false) ? "checked" : "") />
                                        <input type="hidden" name="HrSalaryManagement" value="false" />
                                        <label class="form-check-label" for="HrSalaryManagement">مدیریت حقوق</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="HrVacations" name="HrVacations" value="true" @((Model.HrVacations ?? false) ? "checked" : "") />
                                        <input type="hidden" name="HrVacations" value="false" />
                                        <label class="form-check-label" for="HrVacations">مرخصی‌ها</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="HrVacationTypes" name="HrVacationTypes" value="true" @((Model.HrVacationTypes ?? false) ? "checked" : "") />
                                        <input type="hidden" name="HrVacationTypes" value="false" />
                                        <label class="form-check-label" for="HrVacationTypes">انواع مرخصی</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="HrSalaryCalculation" name="HrSalaryCalculation" value="true" @((Model.HrSalaryCalculation ?? false) ? "checked" : "") />
                                        <input type="hidden" name="HrSalaryCalculation" value="false" />
                                        <label class="form-check-label" for="HrSalaryCalculation">محاسبه حقوق و دستمزد</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Product Pages -->
                        <div class="permission-section" data-module="Product" style="display: @((Model.Product ?? false) ? "block" : "none");">
                            <h6 class="text-primary mb-2">صفحات محصولات و مواد</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ProductMedicines" name="ProductMedicines" value="true" @((Model.ProductMedicines ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ProductMedicines" value="false" />
                                        <label class="form-check-label" for="ProductMedicines">داروها</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ProductMedicineCategories" name="ProductMedicineCategories" value="true" @((Model.ProductMedicineCategories ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ProductMedicineCategories" value="false" />
                                        <label class="form-check-label" for="ProductMedicineCategories">دسته‌بندی داروها</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ProductRawMaterials" name="ProductRawMaterials" value="true" @((Model.ProductRawMaterials ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ProductRawMaterials" value="false" />
                                        <label class="form-check-label" for="ProductRawMaterials">کالا و مواد اولیه</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ProductMaterialCategories" name="ProductMaterialCategories" value="true" @((Model.ProductMaterialCategories ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ProductMaterialCategories" value="false" />
                                        <label class="form-check-label" for="ProductMaterialCategories">دسته‌بندی کالا و مواد اولیه</label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="ProductBom" name="ProductBom" value="true" @((Model.ProductBom ?? false) ? "checked" : "") />
                                        <input type="hidden" name="ProductBom" value="false" />
                                        <label class="form-check-label" for="ProductBom">فرمول‌های تولید (BOM)</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Buy Commercial Pages -->
                        <div class="permission-section" data-module="BuyCommercial" style="display: @((Model.BuyCommercial ?? false) ? "block" : "none");">
                            <h6 class="text-primary mb-2">صفحات خرید و تأمین</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="BuyCommercialSuppliers" name="BuyCommercialSuppliers" value="true" @((Model.BuyCommercialSuppliers ?? false) ? "checked" : "") />
                                        <input type="hidden" name="BuyCommercialSuppliers" value="false" />
                                        <label class="form-check-label" for="BuyCommercialSuppliers">تأمین‌کنندگان</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="BuyCommercialPurchaseOrders" name="BuyCommercialPurchaseOrders" value="true" @((Model.BuyCommercialPurchaseOrders ?? false) ? "checked" : "") />
                                        <input type="hidden" name="BuyCommercialPurchaseOrders" value="false" />
                                        <label class="form-check-label" for="BuyCommercialPurchaseOrders">سفارشات خرید</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="BuyCommercialPurchaseInvoices" name="BuyCommercialPurchaseInvoices" value="true" @((Model.BuyCommercialPurchaseInvoices ?? false) ? "checked" : "") />
                                        <input type="hidden" name="BuyCommercialPurchaseInvoices" value="false" />
                                        <label class="form-check-label" for="BuyCommercialPurchaseInvoices">فاکتورهای خرید</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Inventory Pages -->
                        <div class="permission-section" data-module="Inventory" style="display: @((Model.Inventory ?? false) ? "block" : "none");">
                            <h6 class="text-primary mb-2">صفحات انبارداری</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="InventoryStorageLocations" name="InventoryStorageLocations" value="true" @((Model.InventoryStorageLocations ?? false) ? "checked" : "") />
                                        <input type="hidden" name="InventoryStorageLocations" value="false" />
                                        <label class="form-check-label" for="InventoryStorageLocations">مکان‌های انبار</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="InventoryMaterialBatches" name="InventoryMaterialBatches" value="true" @((Model.InventoryMaterialBatches ?? false) ? "checked" : "") />
                                        <input type="hidden" name="InventoryMaterialBatches" value="false" />
                                        <label class="form-check-label" for="InventoryMaterialBatches">بچ‌های مواد اولیه</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="InventoryFinishedGoodsBatches" name="InventoryFinishedGoodsBatches" value="true" @((Model.InventoryFinishedGoodsBatches ?? false) ? "checked" : "") />
                                        <input type="hidden" name="InventoryFinishedGoodsBatches" value="false" />
                                        <label class="form-check-label" for="InventoryFinishedGoodsBatches">بچ‌های محصول نهایی</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PMO Pages -->
                        <div class="permission-section" data-module="Pmo" style="display: @((Model.Pmo ?? false) ? "block" : "none");">
                            <h6 class="text-primary mb-2">صفحات تولید</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="PmoProductionOrders" name="PmoProductionOrders" value="true" @((Model.PmoProductionOrders ?? false) ? "checked" : "") />
                                        <input type="hidden" name="PmoProductionOrders" value="false" />
                                        <label class="form-check-label" for="PmoProductionOrders">سفارشات تولید</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="PmoProductionSteps" name="PmoProductionSteps" value="true" @((Model.PmoProductionSteps ?? false) ? "checked" : "") />
                                        <input type="hidden" name="PmoProductionSteps" value="false" />
                                        <label class="form-check-label" for="PmoProductionSteps">مراحل تولید</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- R&D Pages -->
                        <div class="permission-section" data-module="RandD" style="display: @((Model.RandD ?? false) ? "block" : "none");">
                            <h6 class="text-primary mb-2">صفحات تحقیق و توسعه</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="RandDResearchProjects" name="RandDResearchProjects" value="true" @((Model.RandDResearchProjects ?? false) ? "checked" : "") />
                                        <input type="hidden" name="RandDResearchProjects" value="false" />
                                        <label class="form-check-label" for="RandDResearchProjects">پروژه‌های تحقیق</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="RandDDevelopment" name="RandDDevelopment" value="true" @((Model.RandDDevelopment ?? false) ? "checked" : "") />
                                        <input type="hidden" name="RandDDevelopment" value="false" />
                                        <label class="form-check-label" for="RandDDevelopment">فرایند توسعه</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="RandDFormulas" name="RandDFormulas" value="true" @((Model.RandDFormulas ?? false) ? "checked" : "") />
                                        <input type="hidden" name="RandDFormulas" value="false" />
                                        <label class="form-check-label" for="RandDFormulas">فرمول‌های جدید</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- QC Pages -->
                        <div class="permission-section" data-module="Qc" style="display: @((Model.Qc ?? false) ? "block" : "none");">
                            <h6 class="text-primary mb-2">صفحات کنترل کیفیت</h6>
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="QcQctests" name="QcQctests" value="true" @((Model.QcQctests ?? false) ? "checked" : "") />
