<script>
    document.addEventListener('DOMContentLoaded', function() {
        const moduleCheckboxes = document.querySelectorAll('.module-checkbox[data-module]');

        moduleCheckboxes.forEach(function(checkbox) {
            checkbox.addEventListener('change', function() {
                const module = this.getAttribute('data-module');
                const permissionSections = document.querySelectorAll('.permission-section[data-module="' + module + '"]');

                permissionSections.forEach(function(section) {
                    if (checkbox.checked) {
                        section.style.display = 'block';
                    } else {
                        section.style.display = 'none';
                        // Uncheck all page permissions when module is disabled
                        const pageCheckboxes = section.querySelectorAll('input[type="checkbox"]');
                        pageCheckboxes.forEach(function(pageCheckbox) {
                            pageCheckbox.checked = false;
                        });
                    }
                });
            });
        });
    });
</script>