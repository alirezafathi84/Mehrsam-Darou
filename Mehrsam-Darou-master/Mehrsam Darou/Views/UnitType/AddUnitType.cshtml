@model Mehrsam_Darou.Models.UnitType

@{
    ViewData["Title"] = "افزودن نوع واحد جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن نوع واحد جدید</h4>
                    <a href="@Url.Action("UnitTypeList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddUnitType">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TypeName" class="form-label">نام نوع واحد <span class="text-danger">*</span></label>
                                <input asp-for="TypeName" class="form-control" placeholder="مثال: وزن، حجم، طول" />
                                <span asp-validation-for="TypeName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="IsSystem" class="form-label">نوع واحد</label>
                                <select asp-for="IsSystem" class="form-select">
                                    <option value="false">کاربری</option>
                                    <option value="true">سیستمی</option>
                                </select>
                                <small class="form-text text-muted">واحدهای سیستمی قابل حذف نیستند</small>
                                <span asp-validation-for="IsSystem" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">توضیحات</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="توضیحات مربوط به نوع واحد..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}