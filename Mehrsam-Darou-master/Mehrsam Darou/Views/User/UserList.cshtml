@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.User>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
}

<h2>لیست کاربران سیستم</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">

            <div class="card-body">

                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="UserList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="SearchKey" value="@Context.Request.Query["SearchKey"]" class="form-control" placeholder="جستجو ..">
                        </div>
                    </form>
                    <div class="d-flex gap-2">
                        <a href="@Url.Action("UserReport", "User")" class="btn btn-success" target="_blank">
                            <i class="bx bx-file-blank me-1"></i>گزارش HTML
                        </a>

                        <a href="@Url.Action("AddNewUser", "User")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i>جدید
                        </a>
                    </div>
                </div>

            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>نام</th>
                                <th>نام خانوادگی</th>
                                <th>نام کاربری</th>
                                <th>تاریخ ایجاد</th>
                                <th>تاریخ ویرایش</th>
                                <th>نسخه</th>
                                <th>تیم</th>
                                <th>عکس</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var user in Model)
                                {
                                    <tr>
                                        <td>@user.FirstName</td>
                                        <td>@user.LastName</td>
                                        <td>@user.Username</td>
                                        <td dir="ltr" align="right">
                                            @{
                                                if (user.DateCreated.HasValue)
                                                {
                                                    var date = user.DateCreated.Value;
                                                    var persianDate = $"{pc.GetYear(date)}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00} {date:HH:mm}";
                                                    @persianDate
                                                }
                                            }
                                        </td>
                                        <td dir="ltr" align="right">
                                            @{
                                                if (user.DateModified.HasValue)
                                                {
                                                    var date = user.DateModified.Value;
                                                    var persianDate = $"{pc.GetYear(date)}/{pc.GetMonth(date):00}/{pc.GetDayOfMonth(date):00} {date:HH:mm}";
                                                    @persianDate
                                                }
                                            }
                                        </td>
                                        <td>@user.Version</td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success py-1 px-2">@(user.Team?.Name ?? "نا مشخص")</span>
                                        </td>

                                        <td dir="ltr" align="right">
                                            @{
                                                if (user.AvatarImg != null && user.AvatarImg.Length > 0)
                                                {
                                                    <img class="rounded-circle" width="32" height="32" src="@user.AvatarImg" alt="User Avatar">
                                                }
                                                else
                                                {
                                                    <img class="rounded-circle" width="32" height="32" src="~/images/users/dummy-avatar.jpg" alt="Default Avatar">
                                                }
                                            }
                                        </td>

                                        <td>
                                            <div class="d-flex gap-2">
                                                @*         <a href="@Url.Action("UserDetails", "User", new { id = user.Id })" class="btn btn-light btn-sm">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-18"></iconify-icon>
                                                </a> *@
                                                <a href="@Url.Action("EditUser", "User", new { id = user.Id })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-user-id="@user.Id"
                                                        data-user-name="@user.Username"
                                                        title="حذف معمولی">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                                <button type="button" class="btn btn-soft-warning btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#cascadeDeleteModal"
                                                        data-user-id="@user.Id"
                                                        data-user-name="@user.Username"
                                                        title="حذف همراه با تمام اطلاعات مرتبط"
                                                        onclick="loadUserRelatedRecords('@user.Id')">
                                                    <iconify-icon icon="solar:trash-bin-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center">هیچ کاربری یافت نشد.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- end table-responsive -->
            </div>
            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("UserList", new { page = Model.PageIndex - 1, SearchKey = Context.Request.Query["SearchKey"] })">قبلی</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">قبلی</a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("UserList", new { page = i, SearchKey = Context.Request.Query["SearchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("UserList", new { page = Model.PageIndex + 1, SearchKey = Context.Request.Query["SearchKey"] })">بعدی</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Regular Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">حذف کاربر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این کاربر مطمئن هستید؟</p>
                <p><strong>نام کاربری: </strong><span id="userNameToDelete"></span></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> در صورت وجود رکوردهای مرتبط، امکان حذف وجود ندارد.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="DeleteUser">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="userIdToDelete" name="id" />
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Cascade Delete Confirmation Modal -->
<div class="modal fade" id="cascadeDeleteModal" tabindex="-1" aria-labelledby="cascadeDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="cascadeDeleteModalLabel">
                    <i class="bx bx-error-circle me-2"></i>حذف کاربر همراه با تمام اطلاعات مرتبط
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger">
                    <h6><i class="bx bx-error-circle me-1"></i> هشدار مهم!</h6>
                    <p class="mb-0">این عملیات غیرقابل برگشت است و تمامی اطلاعات زیر حذف خواهد شد:</p>
                </div>

                <p><strong>کاربر: </strong><span id="cascadeUserNameToDelete"></span></p>

                <div id="relatedRecordsLoading" class="text-center my-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <span class="ms-2">در حال بررسی اطلاعات مرتبط...</span>
                </div>

                <div id="relatedRecordsList" class="d-none">
                    <h6>اطلاعات مرتبط که حذف خواهد شد:</h6>
                    <div class="row g-2" id="recordCounts">
                        <!-- Dynamic content will be loaded here -->
                    </div>
                    <div class="mt-3">
                        <strong>مجموع رکوردها: <span id="totalRecords" class="text-danger">0</span></strong>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="confirmCascadeDelete" required>
                        <label class="form-check-label text-danger" for="confirmCascadeDelete">
                            <strong>من از حذف کامل این کاربر و تمامی اطلاعات مرتبط اطمینان دارم</strong>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <form id="cascadeDeleteForm" method="post" asp-action="DeleteUserCascade">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="cascadeUserIdToDelete" name="id" />
                    <button type="submit" class="btn btn-danger" id="cascadeDeleteBtn" disabled>
                        <i class="bx bx-trash me-1"></i>حذف کامل
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            var cascadeDeleteModal = document.getElementById('cascadeDeleteModal');
            var confirmCheckbox = document.getElementById('confirmCascadeDelete');
            var cascadeDeleteBtn = document.getElementById('cascadeDeleteBtn');

            // Regular delete modal
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var userId = button.getAttribute('data-user-id');
                var userName = button.getAttribute('data-user-name');

                document.getElementById('userNameToDelete').textContent = userName;
                document.getElementById('userIdToDelete').value = userId;
            });

            // Cascade delete modal
            cascadeDeleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var userId = button.getAttribute('data-user-id');
                var userName = button.getAttribute('data-user-name');

                document.getElementById('cascadeUserNameToDelete').textContent = userName;
                document.getElementById('cascadeUserIdToDelete').value = userId;

                // Reset checkbox and button state
                confirmCheckbox.checked = false;
                cascadeDeleteBtn.disabled = true;
            });

            // Enable/disable delete button based on checkbox
            confirmCheckbox.addEventListener('change', function () {
                cascadeDeleteBtn.disabled = !this.checked;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bootstrapAlert = bootstrap.Alert.getOrCreateInstance(alert);
                    if (bootstrapAlert) {
                        bootstrapAlert.close();
                    }
                });
            }, 5000);
        });

        // Load related records count
        function loadUserRelatedRecords(userId) {
            const loadingDiv = document.getElementById('relatedRecordsLoading');
            const recordsList = document.getElementById('relatedRecordsList');

            loadingDiv.classList.remove('d-none');
            recordsList.classList.add('d-none');

            fetch(`/User/GetUserRelatedRecordsCount?id=${userId}`)
                .then(response => response.json())
                .then(data => {
                    loadingDiv.classList.add('d-none');

                    if (data.success) {
                        displayRelatedRecords(data.counts, data.totalRecords);
                        recordsList.classList.remove('d-none');
                    } else {
                        alert('خطا در بارگذاری اطلاعات: ' + data.error);
                    }
                })
                .catch(error => {
                    loadingDiv.classList.add('d-none');
                    console.error('Error:', error);
                    alert('خطا در بارگذاری اطلاعات');
                });
        }

        function displayRelatedRecords(counts, totalRecords) {
            const recordCountsDiv = document.getElementById('recordCounts');
            const totalRecordsSpan = document.getElementById('totalRecords');

            recordCountsDiv.innerHTML = '';

            const recordTypes = {
                'AttendanceLogs': 'سوابق حضور و غیاب',
                'Notifications': 'اعلانات',
                'ChatMessagesSent': 'پیام‌های ارسالی',
                'ChatMessagesReceived': 'پیام‌های دریافتی',
                'DailyAttendance': 'حضور روزانه',
                'UserEnterLogs': 'سوابق ورود',
                'SalaryInfos': 'اطلاعات حقوق',
                'VacationsRequested': 'درخواست‌های مرخصی',
                'VacationsApproved': 'تایید مرخصی‌ها'
            };

            Object.keys(counts).forEach(key => {
                if (counts[key] > 0) {
                    const col = document.createElement('div');
                    col.className = 'col-md-6';
                    col.innerHTML = `
                        <div class="border rounded p-2">
                            <small class="text-muted">${recordTypes[key] || key}:</small>
                            <strong class="text-danger d-block">${counts[key]} رکورد</strong>
                        </div>
                    `;
                    recordCountsDiv.appendChild(col);
                }
            });

            if (totalRecords === 0) {
                recordCountsDiv.innerHTML = '<div class="col-12"><p class="text-muted text-center">هیچ رکورد مرتبطی یافت نشد</p></div>';
            }

            totalRecordsSpan.textContent = totalRecords;
        }
    </script>
}

<style>
    .alert {
        margin-bottom: 1rem;
    }

    .modal-footer form {
        display: inline-flex;
        gap: 0.5rem;
    }

    .btn-soft-warning {
        background-color: #fff3cd;
        border-color: #ffeaa7;
        color: #856404;
    }

        .btn-soft-warning:hover {
            background-color: #ffecb5;
            border-color: #ffd93d;
            color: #533f01;
        }

    #relatedRecordsList .border {
        background-color: #f8f9fa;
    }

    .modal-header.bg-danger {
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }
</style>