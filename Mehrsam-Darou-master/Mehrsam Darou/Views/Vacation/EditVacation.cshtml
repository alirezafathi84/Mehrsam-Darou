@model Mehrsam_Darou.Models.Vacation

@{
    ViewData["Title"] = "ویرایش درخواست مرخصی";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش درخواست مرخصی</h4>
                    <a href="@Url.Action("VacationList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="EditVacation">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <!-- Current Status Info -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="alert alert-light border">
                                <div class="row">
                                    <div class="col-md-3">
                                        <strong>وضعیت فعلی:</strong>
                                        @if (Model.Status == "Pending")
                                        {
                                            <span class="badge bg-warning ms-1">در انتظار</span>
                                        }
                                        else if (Model.Status == "Approved")
                                        {
                                            <span class="badge bg-success ms-1">تایید شده</span>
                                        }
                                        else if (Model.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger ms-1">رد شده</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (Model.ApprovedByNavigation != null)
                                        {
                                            <strong>تایید کننده:</strong>
                                            <span>@Model.ApprovedByNavigation.FirstName @Model.ApprovedByNavigation.LastName</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (Model.ApprovalDate.HasValue)
                                        {
                                            <strong>تاریخ تایید:</strong>
                                            <span>@Model.ApprovalDate.Value.ToString("yyyy/MM/dd")</span>
                                        }
                                    </div>
                                    <div class="col-md-3">
                                        @if (Model.DateCreated.HasValue)
                                        {
                                            <strong>تاریخ درخواست:</strong>
                                            <span>@Model.DateCreated.Value.ToString("yyyy/MM/dd")</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="UserId" class="form-label">کارمند <span class="text-danger">*</span></label>
                                <select asp-for="UserId" class="form-select" required>
                                    <option value="">-- انتخاب کارمند --</option>
                                    @foreach (var user in ViewBag.Users)
                                    {
                                        <option value="@user.Id" selected="@(user.Id == Model.UserId ? "selected" : null)">@user.FullName</option>
                                    }
                                </select>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TypeId" class="form-label">نوع مرخصی <span class="text-danger">*</span></label>
                                <select asp-for="TypeId" class="form-select" required id="vacationTypeSelect">
                                    <option value="">-- انتخاب نوع مرخصی --</option>
                                    @foreach (var type in ViewBag.VacationTypes)
                                    {
                                        <option value="@type.Id"
                                                selected="@(type.Id == Model.TypeId ? "selected" : null)"
                                                data-description="@type.Description"
                                                data-ispaid="@type.IsPaid"
                                                data-maxdays="@type.MaxDaysPerYear">
                                            @type.Name @(type.IsPaid ? "(با حقوق)" : "(بدون حقوق)")
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="TypeId" class="text-danger"></span>
                                <small id="vacationTypeInfo" class="form-text text-muted"></small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3" data-field="StartDate">
                                <label asp-for="StartDate" class="form-label">تاریخ شروع <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       data-persian-date="true"
                                       autocomplete="off"
                                       readonly
                                       placeholder="تاریخ شروع"
                                       id="startDate" />
                                <input type="hidden" asp-for="StartDate" class="persian-date-hidden" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3" data-field="EndDate">
                                <label asp-for="EndDate" class="form-label">تاریخ پایان <span class="text-danger">*</span></label>
                                <input type="text"
                                       class="form-control"
                                       data-persian-date="true"
                                       autocomplete="off"
                                       readonly
                                       placeholder="تاریخ پایان"
                                       id="endDate" />
                                <input type="hidden" asp-for="EndDate" class="persian-date-hidden" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                                <small id="durationInfo" class="form-text text-muted"></small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Status" class="form-label">وضعیت</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Pending" selected="@(Model.Status == "Pending" ? "selected" : null)">در انتظار</option>
                                    <option value="Approved" selected="@(Model.Status == "Approved" ? "selected" : null)">تایید شده</option>
                                    <option value="Rejected" selected="@(Model.Status == "Rejected" ? "selected" : null)">رد شده</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="ApprovedBy" class="form-label">تایید کننده</label>
                                <select asp-for="ApprovedBy" class="form-select">
                                    <option value="">-- انتخاب تایید کننده --</option>
                                    @foreach (var approver in ViewBag.Approvers)
                                    {
                                        <option value="@approver.Id" selected="@(approver.Id == Model.ApprovedBy ? "selected" : null)">@approver.FullName</option>
                                    }
                                </select>
                                <span asp-validation-for="ApprovedBy" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Notes" class="form-label">توضیحات</label>
                                <textarea asp-for="Notes" class="form-control" rows="4" placeholder="توضیحات اضافی در مورد درخواست مرخصی..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <h6><i class="bx bx-info-circle me-1"></i> نکات مهم:</h6>
                        <ul class="mb-0">
                            <li>تغییر وضعیت به "تایید شده" تاریخ تایید را به‌روزرسانی می‌کند</li>
                            <li>مرخصی‌های تایید شده و شروع شده قابل حذف نیستند</li>
                            <li>تغییر تاریخ‌ها ممکن است با سایر مرخصی‌ها تداخل داشته باشد</li>
                            <li>تغییرات مهم باید با کارمند هماهنگ شود</li>
                        </ul>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                        <button type="button" class="btn btn-info ms-2" onclick="calculateWorkingDays()">
                            <i class="bx bx-calculator me-1"></i> محاسبه روزهای کاری
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const vacationTypeSelect = document.getElementById('vacationTypeSelect');
            const vacationTypeInfo = document.getElementById('vacationTypeInfo');
            const durationInfo = document.getElementById('durationInfo');

            // Get the hidden inputs for Persian dates
            const startDateHidden = document.querySelector('[name="StartDate"]');
            const endDateHidden = document.querySelector('[name="EndDate"]');

            // Initialize vacation type info
            updateVacationTypeInfo();

            // Update vacation type info when selection changes
            vacationTypeSelect.addEventListener('change', updateVacationTypeInfo);

            function updateVacationTypeInfo() {
                const selectedOption = vacationTypeSelect.options[vacationTypeSelect.selectedIndex];
                if (selectedOption.value) {
                    const description = selectedOption.dataset.description;
                    const isPaid = selectedOption.dataset.ispaid === 'True';
                    const maxDays = selectedOption.dataset.maxdays;

                    let info = description ? description + ' - ' : '';
                    info += isPaid ? 'با حقوق' : 'بدون حقوق';
                    if (maxDays && maxDays !== '0') {
                        info += ` - حداکثر ${maxDays} روز در سال`;
                    }

                    vacationTypeInfo.textContent = info;
                } else {
                    vacationTypeInfo.textContent = '';
                }
            }

            // Calculate duration when dates change
            function updateDuration() {
                if (startDateHidden.value && endDateHidden.value) {
                    const startDate = new Date(startDateHidden.value);
                    const endDate = new Date(endDateHidden.value);

                    if (endDate < startDate) {
                        durationInfo.textContent = 'تاریخ پایان باید بعد از تاریخ شروع باشد';
                        durationInfo.className = 'form-text text-danger';
                    } else {
                        // Reset time to midnight for accurate day calculation
                        startDate.setHours(0, 0, 0, 0);
                        endDate.setHours(0, 0, 0, 0);

                        const timeDiff = endDate.getTime() - startDate.getTime();
                        const dayDiff = Math.floor(timeDiff / (1000 * 3600 * 24)) + 1;
                        durationInfo.textContent = `مدت: ${dayDiff} روز`;
                        durationInfo.className = 'form-text text-success';
                    }
                } else {
                    durationInfo.textContent = '';
                }
            }

            // Listen to changes on hidden inputs (these will be updated by Persian date picker)
            if (startDateHidden) {
                const observer = new MutationObserver(updateDuration);
                observer.observe(startDateHidden, { attributes: true, attributeFilter: ['value'] });

                // Also listen for input events
                startDateHidden.addEventListener('change', updateDuration);
                startDateHidden.addEventListener('input', updateDuration);
            }
            if (endDateHidden) {
                const observer = new MutationObserver(updateDuration);
                observer.observe(endDateHidden, { attributes: true, attributeFilter: ['value'] });

                // Also listen for input events
                endDateHidden.addEventListener('change', updateDuration);
                endDateHidden.addEventListener('input', updateDuration);
            }

            // Initialize duration display
            updateDuration();
        });

        function calculateWorkingDays() {
            const startDateValue = document.querySelector('[name="StartDate"]').value;
            const endDateValue = document.querySelector('[name="EndDate"]').value;

            if (!startDateValue || !endDateValue) {
                alert('لطفاً ابتدا تاریخ شروع و پایان را انتخاب کنید.');
                return;
            }

            const start = new Date(startDateValue);
            const end = new Date(endDateValue);

            if (end < start) {
                alert('تاریخ پایان باید بعد از تاریخ شروع باشد.');
                return;
            }

            // Reset time to midnight for accurate day calculation
            start.setHours(0, 0, 0, 0);
            end.setHours(0, 0, 0, 0);

            let workingDays = 0;
            let totalDays = 0;
            const currentDate = new Date(start);

            while (currentDate <= end) {
                totalDays++;
                // Skip Fridays (5) in Iran (Friday is weekend)
                if (currentDate.getDay() !== 5) {
                    workingDays++;
                }
                currentDate.setDate(currentDate.getDate() + 1);
            }

            // Show result
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-info alert-dismissible fade show mt-2';
            alertDiv.innerHTML = `
                <strong>محاسبه انجام شد!</strong>
                کل روزها: ${totalDays} روز - روزهای کاری: ${workingDays} روز
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.querySelector('.card-body').insertBefore(alertDiv, document.querySelector('form'));

            // Auto remove after 5 seconds
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.parentNode.removeChild(alertDiv);
                }
            }, 5000);
        }

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert:not(.alert-info):not(.alert-warning):not(.alert-light)');
            alerts.forEach(function (alert) {
                if (alert.classList.contains('alert-success') || alert.classList.contains('alert-danger')) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            });
        }, 5000);
    </script>
}
