@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.Vacation>
@using System.Globalization

@{
    PersianCalendar pc = new PersianCalendar();
    ViewData["Title"] = "لیست درخواست‌های مرخصی";
}

<h2 class="mb-4">لیست درخواست‌های مرخصی</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }
                <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
                    <div class="d-flex gap-2">
                        <form method="get" asp-action="VacationList" class="d-flex gap-2 align-items-center">
                            <div class="search-bar">
                                <span><i class="bx bx-search-alt"></i></span>
                                <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو در نام کارمند، نوع مرخصی...">
                            </div>
                            <select name="status" class="form-control" style="min-width: 150px;">
                                <option value="">همه وضعیت‌ها</option>
                                <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending" ? "selected" : null)">در انتظار</option>
                                <option value="Approved" selected="@(ViewBag.StatusFilter == "Approved" ? "selected" : null)">تایید شده</option>
                                <option value="Rejected" selected="@(ViewBag.StatusFilter == "Rejected" ? "selected" : null)">رد شده</option>
                            </select>
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="bx bx-filter-alt me-1"></i> فیلتر
                            </button>
                        </form>
                    </div>
                    <div>
                        <a href="@Url.Action("AddVacation")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> درخواست مرخصی جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th class="text-center" style="width: 12%;">کارمند</th>
                                <th class="text-center" style="width: 10%;">نوع مرخصی</th>
                                <th class="text-center" style="width: 9%;">تاریخ شروع</th>
                                <th class="text-center" style="width: 9%;">تاریخ پایان</th>
                                <th class="text-center" style="width: 8%;">مدت (روز)</th>
                                <th class="text-center" style="width: 8%;">وضعیت</th>
                                <th class="text-center" style="width: 10%;">تاریخ درخواست</th>
                                <th class="text-center" style="width: 12%;">تایید کننده</th>
                                <th class="text-center" style="width: 12%;">اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var vacation in Model)
                                {
                                    // Calculate duration properly
                                    int duration = 1;
                                    try
                                    {
                                        var startDateTime = vacation.StartDate.ToDateTime(TimeOnly.MinValue);
                                        var endDateTime = vacation.EndDate.ToDateTime(TimeOnly.MinValue);

                                        // Reset time to midnight for accurate calculation
                                        startDateTime = startDateTime.Date;
                                        endDateTime = endDateTime.Date;

                                        duration = (int)Math.Floor((endDateTime - startDateTime).TotalDays) + 1;
                                    }
                                    catch
                                    {
                                        // Fallback calculation
                                        duration = vacation.EndDate.DayNumber - vacation.StartDate.DayNumber + 1;
                                    }

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        <iconify-icon icon="solar:user-rounded-bold-duotone" class="fs-18"></iconify-icon>
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@vacation.User.FirstName @vacation.User.LastName</h6>
                                                    <small class="text-muted">@vacation.User.Username</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                <span class="badge bg-info-subtle text-info">@vacation.Type.Name</span>
                                                @if (vacation.Type.IsPaid)
                                                {
                                                    <small class="d-block text-success">با حقوق</small>
                                                }
                                                else
                                                {
                                                    <small class="d-block text-muted">بدون حقوق</small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @if (!string.IsNullOrEmpty(vacation.PersianStartDate))
                                                {
                                                    @vacation.PersianStartDate
                                                }
                                                else
                                                {
                                                    var startDateTime = vacation.StartDate.ToDateTime(TimeOnly.MinValue);
                                                    @($"{pc.GetYear(startDateTime)}/{pc.GetMonth(startDateTime):00}/{pc.GetDayOfMonth(startDateTime):00}")
                                                }
                                            </small>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @if (!string.IsNullOrEmpty(vacation.PersianEndDate))
                                                {
                                                    @vacation.PersianEndDate
                                                }
                                                else
                                                {
                                                    var endDateTime = vacation.EndDate.ToDateTime(TimeOnly.MinValue);
                                                    @($"{pc.GetYear(endDateTime)}/{pc.GetMonth(endDateTime):00}/{pc.GetDayOfMonth(endDateTime):00}")
                                                }
                                            </small>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@duration روز</span>
                                        </td>
                                        <td>
                                            @if (vacation.Status == "Pending")
                                            {
                                                <span class="badge bg-warning">در انتظار</span>
                                            }
                                            else if (vacation.Status == "Approved")
                                            {
                                                <span class="badge bg-success">تایید شده</span>
                                            }
                                            else if (vacation.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">رد شده</span>
                                            }
                                        </td>
                                        <td>
                                            @if (vacation.DateCreated.HasValue)
                                            {
                                                <small class="text-muted">
                                                    @($"{pc.GetYear(vacation.DateCreated.Value)}/{pc.GetMonth(vacation.DateCreated.Value):00}/{pc.GetDayOfMonth(vacation.DateCreated.Value):00}")
                                                </small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">-</small>
                                            }
                                        </td>
                                        <td>
                                            @if (vacation.ApprovedByNavigation != null)
                                            {
                                                <small class="text-muted">@vacation.ApprovedByNavigation.FirstName @vacation.ApprovedByNavigation.LastName</small>
                                                @if (vacation.ApprovalDate.HasValue)
                                                {
                                                    <br>
                                                    <small class="text-muted">@($"{pc.GetYear(vacation.ApprovalDate.Value)}/{pc.GetMonth(vacation.ApprovalDate.Value):00}/{pc.GetDayOfMonth(vacation.ApprovalDate.Value):00}")</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1 justify-content-center">
                                                <a href="@Url.Action("EditVacation", new { id = vacation.Id })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-16"></iconify-icon>
                                                </a>

                                                @if (vacation.Status == "Pending")
                                                {
                                                    <form method="post" asp-action="Approve" class="d-inline">
                                                        <input type="hidden" name="id" value="@vacation.Id" />
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-soft-success btn-sm" title="تایید" onclick="return confirm('آیا این درخواست مرخصی را تایید می‌کنید؟')">
                                                            <iconify-icon icon="solar:check-circle-broken" class="align-middle fs-16"></iconify-icon>
                                                        </button>
                                                    </form>
                                                    <form method="post" asp-action="Reject" class="d-inline">
                                                        <input type="hidden" name="id" value="@vacation.Id" />
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-soft-warning btn-sm" title="رد" onclick="return confirm('آیا این درخواست مرخصی را رد می‌کنید؟')">
                                                            <iconify-icon icon="solar:close-circle-broken" class="align-middle fs-16"></iconify-icon>
                                                        </button>
                                                    </form>
                                                }

                                                <button type="button" class="btn btn-soft-info btn-sm"
                                                        onclick="showVacationDetails('@vacation.Id')"
                                                        title="مشاهده جزئیات">
                                                    <iconify-icon icon="solar:eye-broken" class="align-middle fs-16"></iconify-icon>
                                                </button>

                                                @{
                                                    var currentDate = DateOnly.FromDateTime(DateTime.Now);
                                                    var canDelete = vacation.Status != "Approved" || vacation.StartDate > currentDate;
                                                }

                                                @if (canDelete)
                                                {
                                                    <button type="button" class="btn btn-soft-danger btn-sm"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteModal"
                                                            data-bs-id="@vacation.Id"
                                                            data-bs-name="@vacation.User.FirstName @vacation.User.LastName"
                                                            data-bs-type="@vacation.Type.Name"
                                                            title="حذف">
                                                        <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-16"></iconify-icon>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <i class="bx bx-calendar-x text-muted fs-1"></i>
                                        <p class="mt-2">هیچ درخواست مرخصی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("VacationList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"], status = Context.Request.Query["status"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("VacationList", new { page = i, searchKey = Context.Request.Query["searchKey"], status = Context.Request.Query["status"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("VacationList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"], status = Context.Request.Query["status"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف درخواست مرخصی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این درخواست مرخصی مطمئن هستید؟</p>
                <p><strong>کارمند:</strong> <span id="employeeNameToDelete"></span></p>
                <p><strong>نوع مرخصی:</strong> <span id="vacationTypeToDelete"></span></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> این عمل غیرقابل بازگشت است.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="vacationIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Vacation Details Modal -->
<div class="modal fade" id="vacationDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات درخواست مرخصی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body" id="vacationDetailsContent">
                <!-- Vacation details will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .table thead th {
            white-space: nowrap;
            vertical-align: middle;
            font-weight: 600;
            padding: 12px 8px;
        }

        .table tbody td {
            vertical-align: middle;
            padding: 12px 8px;
        }

        .table-responsive {
            overflow-x: auto;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var vacationId = button.getAttribute('data-bs-id');
                var employeeName = button.getAttribute('data-bs-name');
                var vacationType = button.getAttribute('data-bs-type');

                document.getElementById('employeeNameToDelete').textContent = employeeName;
                document.getElementById('vacationTypeToDelete').textContent = vacationType;
                document.getElementById('vacationIdToDelete').value = vacationId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert-success, .alert-danger');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        function showVacationDetails(vacationId) {
            // This would typically load vacation details via AJAX
            var modal = new bootstrap.Modal(document.getElementById('vacationDetailsModal'));
            document.getElementById('vacationDetailsContent').innerHTML =
                '<div class="text-center"><div class="spinner-border" role="status"></div><p class="mt-2">در حال بارگذاری...</p></div>';
            modal.show();

            // Simulate loading details - Replace with actual AJAX call
            setTimeout(function() {
                document.getElementById('vacationDetailsContent').innerHTML =
                    '<p>جزئیات کامل درخواست مرخصی اینجا نمایش داده خواهد شد.</p>' +
                    '<p>شامل توضیحات، تاریخچه تغییرات، مستندات و ...</p>';
            }, 1000);
        }
    </script>
}
