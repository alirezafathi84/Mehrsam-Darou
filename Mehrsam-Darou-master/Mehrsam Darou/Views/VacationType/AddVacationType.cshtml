@model Mehrsam_Darou.Models.VacationType

@{
    ViewData["Title"] = "افزودن نوع مرخصی جدید";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>افزودن نوع مرخصی جدید</h4>
                    <a href="@Url.Action("VacationTypeList")" class="btn btn-secondary">
                        <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                    </a>
                </div>

                <form asp-action="AddVacationType">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">نام نوع مرخصی <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="مثال: مرخصی استعلاجی، مرخصی ساعتی" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <small class="form-text text-muted">نام باید منحصر به فرد باشد</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="IsPaid" class="form-label">نوع پرداخت <span class="text-danger">*</span></label>
                                <select asp-for="IsPaid" class="form-select" required>
                                    <option value="true">با حقوق</option>
                                    <option value="false">بدون حقوق</option>
                                </select>
                                <span asp-validation-for="IsPaid" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MaxDaysPerYear" class="form-label">حداکثر روز در سال</label>
                                <input asp-for="MaxDaysPerYear" type="number" min="0" max="365" class="form-control" placeholder="مثال: 30" />
                                <span asp-validation-for="MaxDaysPerYear" class="text-danger"></span>
                                <small class="form-text text-muted">برای نامحدود، خالی بگذارید یا 0 وارد کنید</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3 d-flex align-items-end">
                                <div class="flex-grow-1">
                                    <label class="form-label">پیش‌نمایش</label>
                                    <div class="p-2 border rounded bg-light">
                                        <span id="previewBadge" class="badge bg-primary">پیش‌نمایش نوع مرخصی</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">توضیحات</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="توضیحات کامل در مورد این نوع مرخصی، شرایط و محدودیت‌ها..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Common Vacation Types Suggestions -->
                    <div class="alert alert-info">
                        <h6><i class="bx bx-lightbulb me-1"></i> پیشنهادات رایج:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="mb-0">
                                    <li><strong>مرخصی استحقاقی:</strong> با حقوق، 30 روز در سال</li>
                                    <li><strong>مرخصی استعلاجی:</strong> با حقوق، 10 روز در سال</li>
                                    <li><strong>مرخصی ساعتی:</strong> با حقوق، محدود</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <ul class="mb-0">
                                    <li><strong>مرخصی بدون حقوق:</strong> بدون حقوق، نامحدود</li>
                                    <li><strong>مرخصی زایمان:</strong> با حقوق، 90 روز</li>
                                    <li><strong>مرخصی تشویقی:</strong> با حقوق، محدود</li>
                                </ul>
                            </div>
                        </div>
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-info btn-sm me-1" onclick="applyTemplate('استحقاقی', 'مرخصی سالانه کارمندان', true, 30)">
                                <i class="bx bx-copy me-1"></i>استحقاقی
                            </button>
                            <button type="button" class="btn btn-outline-info btn-sm me-1" onclick="applyTemplate('استعلاجی', 'مرخصی برای درمان و بهبودی', true, 10)">
                                <i class="bx bx-copy me-1"></i>استعلاجی
                            </button>
                            <button type="button" class="btn btn-outline-info btn-sm me-1" onclick="applyTemplate('بدون حقوق', 'مرخصی بدون دریافت حقوق', false, 0)">
                                <i class="bx bx-copy me-1"></i>بدون حقوق
                            </button>
                            <button type="button" class="btn btn-outline-info btn-sm" onclick="applyTemplate('زایمان', 'مرخصی زایمان و نگهداری از نوزاد', true, 90)">
                                <i class="bx bx-copy me-1"></i>زایمان
                            </button>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره
                        </button>
                        <button type="button" class="btn btn-secondary ms-2" onclick="resetForm()">
                            <i class="bx bx-reset me-1"></i> پاک کردن
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const nameInput = document.getElementById('Name');
            const isPaidSelect = document.getElementById('IsPaid');
            const maxDaysInput = document.getElementById('MaxDaysPerYear');
            const previewBadge = document.getElementById('previewBadge');

            function updatePreview() {
                const name = nameInput.value || 'نام نوع مرخصی';
                const isPaid = isPaidSelect.value === 'true';
                const maxDays = maxDaysInput.value;

                let badgeClass = isPaid ? 'bg-success' : 'bg-secondary';
                let paymentText = isPaid ? '(با حقوق)' : '(بدون حقوق)';
                let limitText = maxDays && maxDays > 0 ? ` - حداکثر ${maxDays} روز` : '';

                previewBadge.className = `badge ${badgeClass}`;
                previewBadge.textContent = `${name} ${paymentText}${limitText}`;
            }

            nameInput.addEventListener('input', updatePreview);
            isPaidSelect.addEventListener('change', updatePreview);
            maxDaysInput.addEventListener('input', updatePreview);

            // Initialize preview
            updatePreview();
        });

        function applyTemplate(name, description, isPaid, maxDays) {
            document.getElementById('Name').value = name;
            document.getElementById('Description').value = description;
            document.getElementById('IsPaid').value = isPaid.toString();
            document.getElementById('MaxDaysPerYear').value = maxDays > 0 ? maxDays : '';

            // Update preview
            const event = new Event('input', { bubbles: true });
            document.getElementById('Name').dispatchEvent(event);

            // Show notification
            const alert = document.createElement('div');
            alert.className = 'alert alert-success alert-dismissible fade show mt-2';
            alert.innerHTML = `
                <strong>قالب اعمال شد!</strong> اطلاعات ${name} بارگذاری شد.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.querySelector('.card-body').insertBefore(alert, document.querySelector('form'));

            // Auto remove after 3 seconds
            setTimeout(() => {
                if (alert.parentNode) {
                    alert.parentNode.removeChild(alert);
                }
            }, 3000);
        }

        function resetForm() {
            if (confirm('آیا از پاک کردن تمام اطلاعات مطمئن هستید؟')) {
                document.querySelector('form').reset();
                // Reset to default values
                document.getElementById('IsPaid').value = 'true';
                document.getElementById('MaxDaysPerYear').value = '30';

                // Update preview
                const event = new Event('input', { bubbles: true });
                document.getElementById('Name').dispatchEvent(event);
            }
        }

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert:not(.alert-info)');
            alerts.forEach(function (alert) {
                if (alert.classList.contains('alert-success') || alert.classList.contains('alert-danger')) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            });
        }, 5000);
    </script>
}