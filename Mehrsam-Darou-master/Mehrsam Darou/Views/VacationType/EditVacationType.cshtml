@model Mehrsam_Darou.Models.VacationType

@{
    ViewData["Title"] = "ویرایش نوع مرخصی";
}

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4>ویرایش نوع مرخصی</h4>
                    <div>
                        <a href="@Url.Action("VacationTypeDetails", new { id = Model.Id })" class="btn btn-info me-2">
                            <i class="bx bx-chart-square me-1"></i> جزئیات و آمار
                        </a>
                        <a href="@Url.Action("VacationTypeList")" class="btn btn-secondary">
                            <i class="bx bx-arrow-back me-1"></i> بازگشت به لیست
                        </a>
                    </div>
                </div>

                <form asp-action="EditVacationType">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">نام نوع مرخصی <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="مثال: مرخصی استعلاجی، مرخصی ساعتی" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                                <small class="form-text text-muted">نام باید منحصر به فرد باشد</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="IsPaid" class="form-label">نوع پرداخت <span class="text-danger">*</span></label>
                                <select asp-for="IsPaid" class="form-select" required>
                                    <option value="true">با حقوق</option>
                                    <option value="false">بدون حقوق</option>
                                </select>
                                <span asp-validation-for="IsPaid" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="MaxDaysPerYear" class="form-label">حداکثر روز در سال</label>
                                <input asp-for="MaxDaysPerYear" type="number" min="0" max="365" class="form-control" placeholder="مثال: 30" />
                                <span asp-validation-for="MaxDaysPerYear" class="text-danger"></span>
                                <small class="form-text text-muted">برای نامحدود، خالی بگذارید یا 0 وارد کنید</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3 d-flex align-items-end">
                                <div class="flex-grow-1">
                                    <label class="form-label">پیش‌نمایش</label>
                                    <div class="p-2 border rounded bg-light">
                                        <span id="previewBadge" class="badge bg-primary">پیش‌نمایش نوع مرخصی</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">توضیحات</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="توضیحات کامل در مورد این نوع مرخصی، شرایط و محدودیت‌ها..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <h6><i class="bx bx-info-circle me-1"></i> نکات مهم:</h6>
                        <ul class="mb-0">
                            <li>تغییر نوع پرداخت بر روی درخواست‌های موجود تأثیر می‌گذارد</li>
                            <li>کاهش حداکثر روز مجاز ممکن است با درخواست‌های تایید شده تداخل داشته باشد</li>
                            <li>تغییر نام نوع مرخصی در گزارش‌ها منعکس خواهد شد</li>
                            <li>در صورت استفاده در درخواست‌ها، حذف این نوع مرخصی امکان‌پذیر نیست</li>
                        </ul>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bx bx-save me-1"></i> ذخیره تغییرات
                        </button>
                        <button type="button" class="btn btn-warning ms-2" onclick="resetToOriginal()">
                            <i class="bx bx-reset me-1"></i> بازگشت به حالت اصلی
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Store original values for reset functionality
        const originalValues = {
            name: '@Html.Raw(Model.Name ?? "")',
            description: '@Html.Raw(Model.Description ?? "")',
            isPaid: @Model.IsPaid.ToString().ToLower(),
            maxDays: @(Model.MaxDaysPerYear ?? 0)
        };

        document.addEventListener('DOMContentLoaded', function () {
            const nameInput = document.getElementById('Name');
            const isPaidSelect = document.getElementById('IsPaid');
            const maxDaysInput = document.getElementById('MaxDaysPerYear');
            const previewBadge = document.getElementById('previewBadge');

            function updatePreview() {
                const name = nameInput.value || 'نام نوع مرخصی';
                const isPaid = isPaidSelect.value === 'true';
                const maxDays = maxDaysInput.value;

                let badgeClass = isPaid ? 'bg-success' : 'bg-secondary';
                let paymentText = isPaid ? '(با حقوق)' : '(بدون حقوق)';
                let limitText = maxDays && maxDays > 0 ? ` - حداکثر ${maxDays} روز` : '';

                previewBadge.className = `badge ${badgeClass}`;
                previewBadge.textContent = `${name} ${paymentText}${limitText}`;
            }

            nameInput.addEventListener('input', updatePreview);
            isPaidSelect.addEventListener('change', updatePreview);
            maxDaysInput.addEventListener('input', updatePreview);

            // Initialize preview
            updatePreview();
        });

        function resetToOriginal() {
            if (confirm('آیا از بازگشت به حالت اصلی مطمئن هستید؟ تمام تغییرات از بین خواهد رفت.')) {
                document.getElementById('Name').value = originalValues.name;
                document.getElementById('Description').value = originalValues.description;
                document.getElementById('IsPaid').value = originalValues.isPaid.toString();
                document.getElementById('MaxDaysPerYear').value = originalValues.maxDays > 0 ? originalValues.maxDays : '';

                // Update preview
                const event = new Event('input', { bubbles: true });
                document.getElementById('Name').dispatchEvent(event);

                // Show notification
                const alert = document.createElement('div');
                alert.className = 'alert alert-info alert-dismissible fade show mt-2';
                alert.innerHTML = `
                    <strong>بازگشت به حالت اصلی!</strong> تمام تغییرات لغو شد.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.querySelector('.card-body').insertBefore(alert, document.querySelector('form'));

                // Auto remove after 3 seconds
                setTimeout(() => {
                    if (alert.parentNode) {
                        alert.parentNode.removeChild(alert);
                    }
                }, 3000);
            }
        }

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert:not(.alert-info):not(.alert-warning)');
            alerts.forEach(function (alert) {
                if (alert.classList.contains('alert-success') || alert.classList.contains('alert-danger')) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            });
        }, 5000);
    </script>
}