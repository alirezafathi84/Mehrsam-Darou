@using static Mehrsam_Darou.Helper.Helper
@model PaginatedList<Mehrsam_Darou.Models.VacationType>

@{
    ViewData["Title"] = "لیست انواع مرخصی";
}

<h2 class="mb-4">لیست انواع مرخصی</h2>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <!-- Success and Error Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success px-2" role="alert">
                        <p class="mb-0">با موفقیت انجام شد</p>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger px-2" role="alert">
                        <p class="mb-0">خطا</p>
                        <p class="mb-0">@TempData["ErrorMessage"]</p>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <form method="get" asp-action="VacationTypeList">
                        <div class="search-bar">
                            <span><i class="bx bx-search-alt"></i></span>
                            <input type="search" name="searchKey" value="@Context.Request.Query["searchKey"]" class="form-control" placeholder="جستجو در نام، توضیحات...">
                        </div>
                    </form>
                    <div>
                        <a href="@Url.Action("AddVacationType")" class="btn btn-primary">
                            <i class="bx bx-plus me-1"></i> نوع مرخصی جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover table-centered">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th>نام نوع مرخصی</th>
                                <th>توضیحات</th>
                                <th>نوع پرداخت</th>
                                <th>حداکثر روز در سال</th>
                                <th>تعداد استفاده</th>
                                <th>اقدامات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var vacationType in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-light-subtle rounded me-2">
                                                    <span class="avatar-title">
                                                        @if (vacationType.IsPaid)
                                                        {
                                                            <iconify-icon icon="solar:calendar-mark-bold-duotone" class="fs-18 text-success"></iconify-icon>
                                                        }
                                                        else
                                                        {
                                                            <iconify-icon icon="solar:calendar-bold-duotone" class="fs-18 text-muted"></iconify-icon>
                                                        }
                                                    </span>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-medium">@vacationType.Name</h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div>
                                                @if (!string.IsNullOrEmpty(vacationType.Description))
                                                {
                                                    if (vacationType.Description.Length > 50)
                                                    {
                                                        <span title="@vacationType.Description">@vacationType.Description.Substring(0, 50)...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>@vacationType.Description</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            @if (vacationType.IsPaid)
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    <i class="bx bx-money me-1"></i>با حقوق
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">
                                                    <i class="bx bx-money-withdraw me-1"></i>بدون حقوق
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (vacationType.MaxDaysPerYear.HasValue && vacationType.MaxDaysPerYear > 0)
                                            {
                                                <span class="badge bg-info-subtle text-info">
                                                    @vacationType.MaxDaysPerYear روز
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted">نامحدود</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                // This would normally come from a join or separate query
                                                // For now, showing placeholder
                                                var usageCount = 0; // vacationType.Vacations?.Count ?? 0;
                                            }
                                            @if (usageCount > 0)
                                            {
                                                <span class="badge bg-primary">@usageCount بار</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">استفاده نشده</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 justify-content-center">
                                                <a href="@Url.Action("VacationTypeDetails", new { id = vacationType.Id })" class="btn btn-soft-info btn-sm" title="جزئیات و آمار">
                                                    <iconify-icon icon="solar:chart-square-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <a href="@Url.Action("EditVacationType", new { id = vacationType.Id })" class="btn btn-soft-primary btn-sm" title="ویرایش">
                                                    <iconify-icon icon="solar:pen-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </a>
                                                <button type="button" class="btn btn-soft-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-bs-id="@vacationType.Id"
                                                        data-bs-name="@vacationType.Name"
                                                        title="حذف">
                                                    <iconify-icon icon="solar:trash-bin-minimalistic-2-broken" class="align-middle fs-18"></iconify-icon>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        <i class="bx bx-calendar-x text-muted fs-1"></i>
                                        <p class="mt-2">هیچ نوع مرخصی یافت نشد.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer border-top">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-end mb-0">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("VacationTypeList", new { page = Model.PageIndex - 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-right"></i>
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="@Url.Action("VacationTypeList", new { page = i, searchKey = Context.Request.Query["searchKey"] })">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("VacationTypeList", new { page = Model.PageIndex + 1, searchKey = Context.Request.Query["searchKey"] })">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">
                                    <i class="bx bx-chevron-left"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">حذف نوع مرخصی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <p>آیا از حذف این نوع مرخصی مطمئن هستید؟</p>
                <p><strong>نام:</strong> <span id="vacationTypeNameToDelete"></span></p>
                <div class="alert alert-warning">
                    <small><i class="bx bx-info-circle me-1"></i> در صورت استفاده در درخواست‌های مرخصی، امکان حذف وجود ندارد.</small>
                </div>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" id="vacationTypeIdToDelete" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">حذف</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var vacationTypeId = button.getAttribute('data-bs-id');
                var vacationTypeName = button.getAttribute('data-bs-name');

                document.getElementById('vacationTypeNameToDelete').textContent = vacationTypeName;
                document.getElementById('vacationTypeIdToDelete').value = vacationTypeId;
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                var alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}